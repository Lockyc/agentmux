# agentmux agent configuration
# Copy this file to ~/.agentmux/agents.toml and edit to suit.
# Agents are launched in the order defined. amux with no argument defaults to the first agent.
# flag:  optional single-letter shorthand for amux -<flag>
# label: optional short display name for tmux tabs (defaults to name if omitted)

[llm]
# OpenAI-compatible endpoint used for AI session summaries (summarise.sh).
# Works with LM Studio, Ollama, llama.cpp, etc. — any /v1/chat/completions server.
# AGENTMUX_LLM_URL / AGENTMUX_LLM_MODEL / AGENTMUX_LLM_TIMEOUT env vars override these.
url     = "http://localhost:1234/v1/chat/completions"
model   = "qwen2.5-14b-instruct"
timeout = 20

[[agents]]
name = "work"
flag = "w"
cmd = "CLAUDE_CONFIG_DIR=~/.claude-work claude"
colour_inactive = "fg=black,bg=colour30"
colour_active = "fg=black,bg=colour37,bold"

[[agents]]
name = "personal"
label = "pers"
flag = "p"
cmd = "CLAUDE_CONFIG_DIR=~/.claude-personal claude"
colour_inactive = "fg=black,bg=colour82"
colour_active = "fg=black,bg=colour154,bold"

[[agents]]
name = "ollama"
cmd = "ollama launch claude --model kimi-k2.6:cloud"
colour_inactive = "fg=black,bg=colour208"
colour_active = "fg=black,bg=colour214,bold"
keep_alive = true
reattach = true

[[agents]]
name = "opencode"
flag = "o"
cmd = "opencode"
colour_inactive = "fg=black,bg=colour54"
colour_active = "fg=black,bg=colour99,bold"
