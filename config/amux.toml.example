# agentmux agent configuration
# Copy this file to ~/.agentmux/amux.toml and edit to suit.
#
# Agents are launched in the order defined. A bare `amux` (no flag, no agent
# name) picks the agent whose `dirs` matches the current directory; if none
# match, it falls back to the first agent in the list.
#
# Optional per-agent fields:
#   flag:       single-letter shorthand for `amux -<flag>`
#   label:      short display name for tmux tabs (defaults to name)
#   dirs:       directories that auto-select this agent for a bare `amux` run
#               inside one (or any subdirectory). `~` expands to $HOME; when
#               several agents match, the longest (most specific) path wins.
#   colour:     tab colour — a curated name or 256 code (see the agents below)
#   keep_alive: keep the pane open after the agent exits (re-exec's your shell)
#   reattach:   wrap in reattach-to-user-namespace (macOS clipboard inside tmux);
#               requires keep_alive = true, else it's ignored with a warning
#   resume:     resume program for this agent's windows. The session log records a
#               default resume command per window (e.g. `claude --resume <id>`); set
#               `resume` to override just the executable, so this agent's windows use
#               `<resume> --resume <id>`. Useful when an agent runs a wrapper —
#               e.g. resume = "claude-work" → `claude-work --resume <id>`.
#               Two things consume it: the restore picker (`amux --restore`, and the
#               offer a bare `amux` makes after a crash), and `prefix f` (fork this
#               tab's session into a new tab) — so an agent launched via a wrapper
#               needs this set, or its forks start with the bare program.

[log]
# Durable session log: record each agent window amux opens so you can recover
# the roster after a tmux server is killed or the machine reboots
# (`amux --restore`, or the offer a bare `amux` makes in that directory).
# It also carries the session id `prefix f` forks from.
sessions = true

[update]
# Opt-in: once-daily check for a newer agentmux on GitHub. Notify-only — when a
# newer version exists, amux prints a one-line notice; run `amux --update` to apply.
# Off by default. AGENTMUX_VERSION_CHECK=1/0 overrides this.
check = false

[notes]
# Optional FOURTH status row: an always-visible note line for the current tab,
# independent of the AI summaries. Off by default.
#
# With `row = true` an agentmux session shows five status lines (tmux's maximum)
# instead of four: the window list, the three AI-summary rows, and this note row.
# Click it to write a note; click it again to edit. `prefix N` still swaps rows
# 1-3 between the AI summaries and notes 1-3 — this row is unaffected by that
# toggle and shows the same note in both modes.
#
# Two ways to apply a change to this field. `amux --reload` pushes it to every
# live agent session at once, in both directions, without detaching. Or run
# `amux` in the project again — a re-attach is enough, the session need not be
# killed. Under `--frame` the launch-path publish rides the frame's build, so a
# relaunch that reuses a healthy frame keeps the previous setting until the frame
# is rebuilt; `--reload` reaches that session regardless.
#
# Per-directory overrides work exactly like [frame]'s — a
# [notes.dirs."<path>"] block wins for that directory and its subtree:
#
# [notes.dirs."~/Developer/github.com/lockyc/agentmux"]
# row = false
row = false

[llm]
# OpenAI-compatible endpoint used for AI session summaries (summarise.sh).
# Works with LM Studio, Ollama, llama.cpp, etc. — any /v1/chat/completions server.
# AGENTMUX_LLM_URL / AGENTMUX_LLM_MODEL / AGENTMUX_LLM_TIMEOUT env vars override these.
#
# YOUR SERVER MUST GIVE EACH REQUEST >= 4096 TOKENS OF CONTEXT. The done/now/next
# line sends a ~3600-token prompt (a 10000-char digest plus the system prompt);
# below that it fails and — because the summary path degrades silently on purpose
# — you get a permanently BLANK line with no error. The tab label still works (it
# sends far less), so "label fine, stand line always empty" is the signature of a
# too-small window, not a bad model.
#   Careful: the per-request window is not always the number your UI shows.
#   llama.cpp (GGUF) DIVIDES its context across parallel slots — 8192 at
#   parallel 4 gives each request only 2048, which is NOT enough — while MLX
#   hands over the whole window. Don't derive it; measure it, by sending
#   progressively bigger prompts and reading usage.prompt_tokens on the largest
#   that succeeds.
#
# Any small instruct model works; pick for latency, since this runs on every
# agent event. Reference points measured on an M3 Max via the replay eval in
# docs/ai-summary.md (5 real transcripts, all produced usable output — model
# choice here is a latency/memory decision, not a quality one):
#   qwen/qwen3.5-9b (MLX)  6.0 GB   stand  7-22s   <- best balance
#   qwen/qwen3.5-4b (MLX)  3.1 GB   stand 12-20s   <- lightest
#   qwen2.5-14b-instruct   9.0 GB   stand 33-43s   <- the conservative default
# The default below is the safe one, not the best: it is a plain GGUF that any
# LM Studio install can JIT-load. If you have the Qwen3.5 MLX builds, prefer
# qwen/qwen3.5-9b — smaller and 2-3x faster than the default.
url     = "http://localhost:1234/v1/chat/completions"
model   = "qwen2.5-14b-instruct"
# 20 was too low even for the default above (its stand calls run 33-43s and were
# cut off every refresh). A 4B/9B needs far less; 45 is a safe ceiling either way
# (it is a cap, not a wait — a fast model returns immediately).
timeout = 45

[amux]
# The amux (agent) session runs on your default tmux socket and reads your own
# ~/.tmux.conf, so its prefix is normally whatever you set there (usually C-b).
# Set `prefix` here to override it per amux session only (a session option — it
# never touches your other tmux sessions). Must differ from the [frame] prefix
# below: --frame intercepts the frame prefix before the inner amux sees it, so a
# colliding value is ignored (with a warning) rather than silently shadowed. e.g.:
#
# prefix = "C-a"

# Per-directory overrides work exactly like [frame]'s (see below):
#
# [amux.dirs."~/Developer/github.com/lockyc/agentmux"]
# prefix = "C-Space"

# Pin a project's status-bar colour by name so it never changes and is removed
# from the auto-assign pool — no other project gets it, even when this one is
# closed. Without a pin, a session's bar colour is a stable hash of its name, but
# two projects can collide and swap colours depending on launch order; a pin makes
# it deterministic. This is the SESSION bar colour, distinct from an agent's tab
# `colour` above. Run `amux --colours` for the bar colour names. e.g.:
#
# [amux.dirs."~/Developer/github.com/you/myproject"]
# session_colour = "blue"

[frame]
# `amux --frame` layout: a bare scratch terminal in the left pane beside amux in
# the right pane (its own nested tmux). `left` is the left-pane width, percent.
left = 30

# Secondary prefix for the frame's own controls (focus/resize/quit). Defaults to
# C-f ('f' for frame). Override here with anything but the [amux] prefix (the
# frame would otherwise shadow it inside --frame), e.g.:
#
# prefix = "C-Space"

# Optionally split the left column top/bottom: percent height of the TOP region
# (10..90). Unset = single left pane (default). The top region is plain shells
# stacked inside the scratch terminal's own tmux, above the scratch pane (its tab
# bar stays at the bottom) — so `amux --term` shows the same column. Reach the top
# shells with the mouse, C-f j/k in a frame, or the terminal's own C-b pane keys. e.g.:
#
# left_vertical_split = 70

# Number of plain shells stacked in the top region (1..6, default 1, equal-height,
# full width). Needs left_vertical_split (no top region without it). e.g. three
# small shells stacked above a larger scratch terminal:
#
# left_vertical_split = 30
# left_top_panes = 3

# Which pane is focused when the frame starts: "agent" (right, the default) or
# "terminal" (the left scratch column). e.g.:
#
# focus = "terminal"

# Where the frame's [amux frame] status bar sits: "bottom" (default) or "top". e.g.:
#
# status_position = "top"

# Make a bare `amux` (no --frame) open a frame by default. Off by default; a
# bare `amux` then behaves like `amux --frame`. Use `amux --no-frame` for a
# one-off plain launch. Ignored when amux is run inside an existing tmux (unless
# allow_nested below is set). e.g.:
#
# default = true

# Allow --frame to run inside an existing tmux. Off by default — the frame is its
# own tmux server, so nesting it stacks prefixes; --frame refuses it. Advanced
# users already living in tmux can opt in (also lifts the `default` skip above):
#
# allow_nested = true

# Per-directory overrides: any field above can be overridden for a directory
# (and its subdirectories) with a [frame.dirs."<path>"] block. Same matching as
# an agent's `dirs` — `~` expands to $HOME, trailing slash ignored, the longest
# matching path wins — and resolution is per-field: a block only overrides the
# fields it names; everything else falls back to a shallower block, then to the
# base [frame] values above. e.g. a taller split + terminal focus in one tree:
#
# [frame.dirs."~/Developer/github.com/lockyc/agentmux"]
# left_vertical_split = 30
# focus = "terminal"

# ---------------------------------------------------------------------------
# [[hosts]] — remote machines you can launch into with `amux @<name>`.
#
# Everything runs on the REMOTE: tmux servers, agents, the session log, the AI
# summaries. Your local machine is transport only, so closing the laptop costs
# you a re-attach, never work.
#
#   amux @buildbox              pick a project on buildbox
#   amux @buildbox warden       launch/attach warden on buildbox
#   amux @buildbox:~/tmp/scrap  an explicit remote path (skips `roots`)
#   amux @buildbox warden --kill    any other flag is forwarded to remote amux
#
# There is deliberately NO user/port/key/password field. `ssh` names an ssh
# target or a ~/.ssh/config Host alias and ssh owns reaching it — if
# `ssh buildbox` works, `amux @buildbox` works, and no credential lives here.
#
# [[hosts]]
# name  = "buildbox"                        # what you type after @
# ssh   = "root@buildbox"                   # ssh target or ~/.ssh/config alias
# roots = ["~/Developer/work", "~/src"]     # searched for <project>; ~ is
#                                            # expanded on the REMOTE, not here
# transport = "ssh"      # ssh (default) | et | mosh
#                        #   ssh  — stock, multiplexed (ControlMaster), full
#                        #          escape transparency. The right default.
#                        #   et   — Eternal Terminal: transparent byte stream
#                        #          plus automatic reconnect/roaming. Needs
#                        #          `et` locally and `etserver` remotely.
#                        #   mosh — WARNS on use: mosh re-emulates the terminal
#                        #          and drops escapes agentmux depends on, so
#                        #          desktop notifications (OSC 777), OSC 52
#                        #          clipboard and passthrough stop working.
#                        #          Supported for bad links; not recommended.
# agent = "work"         # optional: agent to pass to the remote amux
# amux  = '"$HOME"/.agentmux/bin/amux'   # optional: remote amux program.
#                        # Inserted UNQUOTED into a remote `sh -c`, so it may
#                        # carry env or a wrapper; the default is the standalone
#                        # script, which needs no remote shell integration.

[[agents]]
name = "personal"
label = "pers"
flag = "p"
cmd = "CLAUDE_CONFIG_DIR=~/.claude-personal claude"
dirs = ["~/personal"]
# Friendly colour: a curated name (run `amux --colours` to preview them) or a
# 256 code like "colour82"/"82". The active/inactive shades are auto-derived.
colour = "green"

[[agents]]
name = "work"
flag = "w"
cmd = "CLAUDE_CONFIG_DIR=~/.claude-work claude"
dirs = ["~/work", "~/clients"]
colour = "teal"
# Restoring (`amux --restore`) and forking (`prefix f`) this agent's windows use
# `claude-work --resume <id>` instead of the default `claude --resume <id>` (e.g. a
# wrapper that pins the work config dir). Omit to use the program the adapter recorded.
resume = "claude-work"

[[agents]]
name = "ollama"
cmd = "ollama launch claude --model kimi-k2.6:cloud"
colour = "orange"

[[agents]]
name = "opencode"
flag = "o"
cmd = "opencode"
# Escape hatch: full raw tmux styles override `colour` for total control.
# Set them as a pair — `colour` is only auto-derived when BOTH are absent.
colour_inactive = "fg=black,bg=colour54"
colour_active = "fg=black,bg=colour99,bold"
