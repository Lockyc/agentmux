#!/usr/bin/env expect
# main.exp — preflight + tests 1-7, driven through a real pty attached DIRECTLY
# to the agent server. Invoked by run.sh:
#   expect main.exp <root> <sockA> <sockB> <work> <out> <pane>
#
# TARGET PANE. Every test here runs on the pane of window 1, never %0. That is
# load-bearing: %1 is exactly the pane that breaks under a `command-prompt
# -t '%1'` template, where tmux substitutes the typed response for the `%1`
# placeholder. Passing here IS the verification of notes.sh's
# `#{window_id}.#{pane_index}` target. run.sh aborts if the pane resolves to %0.

source [file join [file dirname [info script]] lib.tcl]
set mtpane [lindex $argv 5]

spawn -noecho tmux -L $mtsockA attach -t test
set tty $spawn_out(slave,name)
# Load-bearing: the pty must be given a real size. script(1) cannot do this,
# which is why a pure-shell harness is not an option.
stty rows 30 cols 120 < $tty

# Poll for the client to actually exist rather than sleeping at it...
set H 0; set N 0
for {set i 0} {$i < 150} {incr i} {
    set g [tmA display-message -c $tty -p {#{client_height}:#{window_height}}]
    if {[regexp {^(\d+):(\d+)$} $g -> h w] && $h > 0 && $w > 0} { break }
    after 100
}
# ...and only THEN measure, once the attach has finished landing. Attaching
# fires `client-attached` -> run-shell update_colors.sh ASYNCHRONOUSLY, and that
# child is what decides between `status 4` and `status on`. Measuring the moment
# a client exists reads the PRE-hook value: caught in a negative test, where a
# deliberately broken world reported four status lines and then failed every
# click, because by click time the hook had landed and there was one.
settle 2
set g [tmA display-message -c $tty -p {#{client_height}:#{window_height}}]
if {[regexp {^(\d+):(\d+)$} $g -> h w]} { set H $h; set N [expr {$h - $w}] }

set L0 [wlline $H $N]
set L1 [rowline 1 $H $N]
set L2 [rowline 2 $H $N]
set L3 [rowline 3 $H $N]
set L4 [rowline 4 $H $N]

# ---------------------------------------------------------------------------
# Preflight — TRAP GUARD 2, render-time half + the geometry verification.
#
# GUARD: `set -g status 5` is silently reverted to `status on` by the
# client-attached hook -> scripts/update_colors.sh for any session NOT carrying
# `@autoagent 1`, and to `status 4` without `@amux_note_row 1`. run.sh asserts
# the session OPTION says 5; this asserts five status lines actually RENDER on a
# genuinely attached client. Without it the note rows do not exist, every click
# lands on the window list, and the whole suite passes nothing while looking busy.
# ---------------------------------------------------------------------------
chk 0 "preflight: status lines, geometry derivation, geometry VERIFIED by click"
eq "status lines rendered (client_height - window_height)" $N 5
eq "session option \`status\`" [tmA show-options -t test status] "status 5"
eq "status-position (the arithmetic assumes bottom)" [tmA show-options -g status-position] "status-position bottom"
eq "client height" $H 30
note "derived: status-format\[0\]=line $L0  row1=$L1  row2=$L2  row3=$L3  row4=$L4"
ok "no `needs tmux 3.6+` message so far" [expr {![string match "*needs tmux 3.6*" [logtext]]}]

# Verify the arithmetic instead of trusting it: click each derived line and type
# text that is distinct per row. If the mapping were off by one, the text would
# land in the wrong option (or nowhere) and this fails loudly. Rows 1-3 are
# click-inert in summary mode, so they are probed in NOTES mode; row 4 is probed
# in summary mode, which is where it is the live target.
reset_to_summary
notes_mode
foreach {k line want} [list 1 $L1 geo-row-one 2 $L2 geo-row-two 3 $L3 geo-row-three] {
    click 5 $line
    ok "click line $line opened \`note $k>\`" [expr {[wp "note $k>"] eq "MATCH"}]
    typed $want
    enter
    set p [waitopt "@amux_note_raw$k" $want]
    eq "typed text landed in @amux_note_raw$k" [opt "@amux_note_raw$k"] $want
    ok "  (settled after $p polls)" 1
}
tmA set-option -up -t $mtpane @amux_notes
render
click 5 $L4
ok "click line $L4 opened \`note 4>\` in SUMMARY mode" [expr {[wp "note 4>"] eq "MATCH"}]
typed "geo-row-four"
enter
waitopt @amux_note_raw4 "geo-row-four"
eq "typed text landed in @amux_note_raw4" [opt @amux_note_raw4] "geo-row-four"
eq "row 1 got ONLY its own text" [opt @amux_note_raw1] "geo-row-one"
eq "row 2 got ONLY its own text" [opt @amux_note_raw2] "geo-row-two"
eq "row 3 got ONLY its own text" [opt @amux_note_raw3] "geo-row-three"
set pre_ok [chkend]

if {!$pre_ok} {
    puts stderr "\n  preflight failed — the remaining tests would be meaningless"
    exit 2
}

# ---------------------------------------------------------------------------
# 1 — THE RETIREMENT. A click on a summary row must be inert: no prompt, no
# mode flip, no note. "No option changed" alone cannot tell "correctly
# ignored" from "the click never arrived at all" — pane_echo below only proves
# no command-prompt is open, which is equally true either way. The real
# distinguisher is check 3 below: it clicks this SAME range ($L1) with notes
# mode on and gets a prompt, proving the click plumbing (routing, pane/range
# resolution) works and it is only the summary-mode guard making this one
# inert.
# ---------------------------------------------------------------------------
chk 1 "summary-row clicks are inert (the retirement)"
reset_to_summary
eq "@amux_notes before (summary mode)" [opt @amux_notes] ""
eq "row 1 is showing the SUMMARY, not a note" [opt @amux_row1] $SUMMARY(1)
click 5 $L1
ok "NO note prompt opened" [noprompt 3]
eq "@amux_notes did NOT flip on" [opt @amux_notes] ""
eq "no note was written" [opt @amux_note_raw1] ""
eq "@amux_row1 untouched" [opt @amux_row1] $SUMMARY(1)
ok "typed text reached the pane's shell, not a prompt" [pane_echo "MT-INERT-TOKEN"]
chkend

# ---------------------------------------------------------------------------
# 2 — the silent-failure gate, on the row that is live in summary mode.
# Does #{mouse_status_range}/#{pane_id} survive into the run-shell inside the
# `if -F` branch? If it does not, the click does nothing at all — no error, no
# fallthrough. Row 4 is where that is now observable without a mode change.
# ---------------------------------------------------------------------------
chk 2 "row 4 — the always-on note line, clickable in summary mode"
reset_to_summary
eq "row 4 shows its own empty-state hint" [opt @amux_note4] \
   "#\[fg=colour240\]✎ click to add a note"
click 5 $L4
ok "a \`note 4>\` prompt opened" [expr {[wp "note 4>"] eq "MATCH"}]
typed "ship it"
enter
waitopt @amux_note_raw4 "ship it"
waitopt @amux_note4 "✎ ship it"
eq "@amux_note_raw4" [opt @amux_note_raw4] "ship it"
eq "row 4's display value carries the mark" [opt @amux_note4] "✎ ship it"
eq "the mode flag was NOT touched" [opt @amux_notes] ""
eq "@amux_row1 untouched — the summaries stayed put" [opt @amux_row1] $SUMMARY(1)
eq "row 1 gained no note" [opt @amux_note_raw1] ""
ok "no `needs tmux 3.6+` message" [expr {![string match "*needs tmux 3.6*" [logtext]]}]
chkend

# ---------------------------------------------------------------------------
# 3 — rows 1-3 are live again once notes mode is on: the retirement removed the
# mode-ENTERING side effect, not the editing. Also covers the rows-1-3
# empty-state hint, which is independent of slot 4's.
# ---------------------------------------------------------------------------
chk 3 "notes-mode clicks on rows 1-3 still work"
reset_to_summary
tmA set-option -p -t $mtpane @amux_note_raw4 "row four note"
notes_mode
eq "rows 1-3 show their own empty-state hint" [opt @amux_note1] \
   "#\[fg=colour240\]✎ click a row to write a note"
eq "row 4 is unaffected by the mode" [opt @amux_note4] "✎ row four note"
click 5 $L1
ok "a \`note 1>\` prompt opened" [expr {[wp "note 1>"] eq "MATCH"}]
eq "@amux_notes still on" [opt @amux_notes] "1"
eq "@amux_row1 untouched by notes.sh" [opt @amux_row1] $SUMMARY(1)
esc
settle 1
eq "escape left the note unwritten" [opt @amux_note_raw1] ""
chkend

# ---------------------------------------------------------------------------
# 4 — row mapping. Distinct text, read back from the option: this is the
# positional proof, and it is stronger than reading the rendered line.
# ---------------------------------------------------------------------------
chk 4 "row mapping (click row 2 specifically)"
notes_mode
click 5 $L2
ok "a \`note 2>\` prompt opened (not 1 or 3)" [expr {[wp "note 2>"] eq "MATCH"}]
typed "hello-row-two"
enter
waitopt @amux_note_raw2 "hello-row-two"
# The commit template is `set-option … ; run-shell "… notes.sh render …"`, so the
# RAW option lands FIRST and the DISPLAY options are recomputed by a forked
# child a moment later. Polling only the raw and then reading a display value
# reads the PREVIOUS render (measured: it produced two false failures).
waitopt @amux_note2 "hello-row-two"
waitopt @amux_note1 "✎ "
eq "@amux_note_raw2" [opt @amux_note_raw2] "hello-row-two"
eq "@amux_note_raw1 untouched" [opt @amux_note_raw1] ""
eq "@amux_note_raw3 untouched" [opt @amux_note_raw3] ""
eq "row 1 shows the bare mode mark" [opt @amux_note1] "✎ "
eq "row 2's display value" [opt @amux_note2] "hello-row-two"
chkend

# ---------------------------------------------------------------------------
# 5 — '#' round-trip. Stored raw, doubled for display, and the PREFILL is the
# raw (a prefill of the escaped value would grow a '#' on every edit).
# ---------------------------------------------------------------------------
chk 5 "'#' escaping round-trip + prefill"
click 5 $L1
ok "prompt opened for row 1" [expr {[wp "note 1>"] eq "MATCH"}]
typed "fix #42"
enter
waitopt @amux_note_raw1 "fix #42"
waitopt @amux_note1 "✎ fix ##42"
eq "@amux_note_raw1 (what the user typed)" [opt @amux_note_raw1] "fix #42"
eq "@amux_note1 (display, '#' doubled)" [opt @amux_note1] "✎ fix ##42"

click 5 $L1
# The exact byte match IS the assertion: `note 1>fix #42`, not `note 1>fix ##42`.
ok "reopened prompt prefills the RAW text, not the escaped one" \
   [expr {[wp "note 1>fix #42"] eq "MATCH"}]
enter
settle 1
waitopt @amux_note1 "✎ fix ##42"
eq "bare-Enter re-commit left raw unchanged" [opt @amux_note_raw1] "fix #42"
eq "bare-Enter re-commit did not double-escape" [opt @amux_note1] "✎ fix ##42"
chkend

# ---------------------------------------------------------------------------
# 6 — comma survives. Without `-l`, -I's prefill is a COMMA-SPLIT list, so the
# prefill would truncate at the comma and a bare Enter would silently commit
# the truncation.
# ---------------------------------------------------------------------------
chk 6 "comma survives the prefill round-trip (-l)"
click 5 $L3
ok "prompt opened for row 3" [expr {[wp "note 3>"] eq "MATCH"}]
typed "ask sam, then deploy"
enter
waitopt @amux_note_raw3 "ask sam, then deploy"
eq "@amux_note_raw3" [opt @amux_note_raw3] "ask sam, then deploy"

click 5 $L3
ok "reopened prompt prefilled the WHOLE note, comma intact" \
   [expr {[wp "note 3>ask sam, then deploy"] eq "MATCH"}]
enter
settle 1
eq "bare-Enter re-commit did not truncate at the comma" \
   [opt @amux_note_raw3] "ask sam, then deploy"
chkend

# ---------------------------------------------------------------------------
# 7 — #{p400:...} must make an EMPTY row clickable across the full width. A
# range covers only rendered characters, so without the pad a blank row has no
# click target anywhere.
# ---------------------------------------------------------------------------
chk 7 "padding gives a full-width click target"
tmA set-option -up -t $mtpane @amux_note_raw2
render
eq "row 2 is genuinely empty (rows 1/3 filled, so the hint does not fire)" [opt @amux_note2] ""
eq "row 1 still holds its note" [opt @amux_note_raw1] "fix #42"

click 110 $L2
ok "col 110 on the EMPTY row 2 opened \`note 2>\`" [expr {[wp "note 2>"] eq "MATCH"}]
# Row-distinct text: proves the far-right click hit row 2, not a neighbour.
typed "wide-click-row-two"
enter
waitopt @amux_note_raw2 "wide-click-row-two"
eq "far-right click wrote to row 2's option" [opt @amux_note_raw2] "wide-click-row-two"
eq "row 1 untouched by the far-right click" [opt @amux_note_raw1] "fix #42"
eq "row 3 untouched by the far-right click" [opt @amux_note_raw3] "ask sam, then deploy"

tmA set-option -up -t $mtpane @amux_note_raw2
render
click 120 $L2
ok "col 120 (last column) on the empty row opened \`note 2>\`" [expr {[wp "note 2>"] eq "MATCH"}]
esc
settle 1

# Past the end of a SHORT note: same pad, different row.
click 110 $L3
ok "col 110 past the short note on row 3 opened \`note 3>\` with its prefill" \
   [expr {[wp "note 3>ask sam, then deploy"] eq "MATCH"}]
esc
settle 1
eq "no stray write to row 2" [opt @amux_note_raw2] ""
eq "no stray write to row 3" [opt @amux_note_raw3] "ask sam, then deploy"
chkend

# ---------------------------------------------------------------------------
# 8 — the `if -F` ELSE branch: a window-list click must still switch windows.
# The click column is DERIVED from the expanded status-left + window entry
# widths, never hardcoded.
# ---------------------------------------------------------------------------
chk 8 "window-list clicks still work"
tmA select-window -t test:1
settle 1
set sl   [string length [tmA display-message -p -t test:1 {#{E:status-left}}]]
set e0   [string length [tmA display-message -p -t test:0 {#{E:window-status-format}}]]
set sep  [string length [tmA show-options -gv window-status-separator]]
set col0 [expr {$sl + 2}]
note "derived: status-left=$sl cols, entry0=$e0 cols, sep=$sep -> click col $col0 on line $L0"
eq "current window before" [tmA display-message -p -t test {#{window_index}:#{window_name}}] "1:second"

set raw1_before [opt @amux_note_raw1]
click $col0 $L0
for {set i 0} {$i < 80} {incr i} {
    set w [tmA display-message -p -t test {#{window_index}:#{window_name}}]
    if {$w eq "0:bash"} break
    after 100
}
eq "clicking \`0:bash\` switched window" $w "0:bash"
eq "active pane followed" [tmA display-message -p -t test {#{pane_id}}] "%0"
ok "NO note prompt opened" [noprompt 3]
eq "clicked window's pane gained no @amux_notes" [opt @amux_notes %0] ""
eq "clicked window's pane gained no note" [opt @amux_note_raw1 %0] ""
# Positive proof that no prompt is open: the keystrokes reach the PANE.
ok "typed text reached the pane's shell, not a prompt" [pane_echo "MT-WINLIST-TOKEN" %0]
eq "row 1's note on the original pane is untouched" [opt @amux_note_raw1] $raw1_before

set e0b  [string length [tmA display-message -p -t test:0 {#{E:window-status-current-format}}]]
set col1 [expr {$sl + $e0b + $sep + 2}]
click $col1 $L0
for {set i 0} {$i < 80} {incr i} {
    set w2 [tmA display-message -p -t test {#{window_index}:#{window_name}}]
    if {$w2 eq "1:second"} break
    after 100
}
eq "clicking \`1:second\` switched back (col $col1)" $w2 "1:second"
chkend

# ---------------------------------------------------------------------------
# 9 — Escape must discard, leave the note intact, and not fire the 3.6 fallback.
# ---------------------------------------------------------------------------
chk 9 "escape cancels cleanly"
settle 1
set raw_before  [opt @amux_note_raw1]
set disp_before [opt @amux_note1]
set mode_before [opt @amux_notes]
eq "precondition: row 1 holds a note" $raw_before "fix #42"
click 5 $L1
ok "prompt opened with the prefill" [expr {[wp "note 1>fix #42"] eq "MATCH"}]
typed "DISCARD-ME"
settle 1
esc
settle 1
ok "prompt is gone (typed text now reaches the pane)" [pane_echo "MT-ESCAPE-TOKEN"]
eq "@amux_note_raw1 unchanged" [opt @amux_note_raw1] $raw_before
eq "@amux_note1 unchanged" [opt @amux_note1] $disp_before
eq "@amux_notes unchanged" [opt @amux_notes] $mode_before
ok "no `needs tmux 3.6+` message anywhere in the transcript" \
   [expr {![string match "*needs tmux 3.6*" [logtext]]}]
chkend

# ---------------------------------------------------------------------------
tmA detach-client -t $tty
settle 1
catch {close}
catch {wait}
exit [expr {$mtfail ? 1 : 0}]
