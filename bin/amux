#!/usr/bin/env bash
# amux — agentmux session launcher (standalone executable).
# The single source of truth for amux logic; shell integration files
# (shell/agentmux.sh, shell/agentmux.fish) are thin wrappers around this.
#
# Required env: AGENTMUX_CONFIG  (default: ~/.agentmux/amux.toml)
#               AGENTMUX_SCRIPTS (default: <dir of this script>/../scripts)

AGENTMUX_CONFIG="${AGENTMUX_CONFIG:-$HOME/.agentmux/amux.toml}"
AGENTMUX_SCRIPTS="${AGENTMUX_SCRIPTS:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../scripts" 2>/dev/null && pwd)}"

# BASH_SOURCE is not symlink-resolved: the default above assumes bin/ and
# scripts/ are siblings (the install + dev layout). Fail fast with a readable
# message rather than a confusing "source: No such file" if it can't be found.
if [ ! -d "$AGENTMUX_SCRIPTS" ]; then
  echo "amux: cannot locate scripts dir (set AGENTMUX_SCRIPTS)" >&2
  exit 1
fi

source "$AGENTMUX_SCRIPTS/agentmux-config.sh"
source "$AGENTMUX_SCRIPTS/agent_window_style.sh"

# tmux config dir (sibling of scripts/) and the dedicated sockets for --frame.
# AGENTMUX_TERM_SOCKET is exported so the frame server inherits it: frame.conf's
# C-f Q binding reads it back (via the shell, `${AGENTMUX_TERM_SOCKET:-…}`) to kill
# the paired terminal on the right socket even when it's been overridden here.
AGENTMUX_TMUX="${AGENTMUX_TMUX:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../tmux" 2>/dev/null && pwd)}"
# Frame/term sockets are UNSET by default in production, so the resolvers below shard
# them per project (cksum of $PWD) — each project gets its own single-threaded tmux
# server, draining in parallel instead of serializing every project's output (and the
# foreground pane's keystrokes) onto one core. An explicitly-set value (selftest
# isolation) is honoured VERBATIM with no suffix, exactly like AGENTMUX_AGENT_SOCKET.
# AGENTMUX_TERM_SOCKET keeps its export attribute so frame.conf's C-f Q and
# frame_reattach.sh — which read it back INSIDE the frame server — see the derived
# value that _amux_frame exports at launch. AGENTMUX_FRAME_SOCKET needs no export
# (read only in-process, via the resolvers).
export AGENTMUX_TERM_SOCKET
# Agent sessions live on the per-project shard `agentmux-agent-<cksum $PWD>` (see
# _amux_agent_sock), like the frame/term sockets above. This override exists only so
# selftests can isolate the session-management commands onto a throwaway socket instead
# of that derived shard; empty = the derived per-project shard, as in production.
AGENTMUX_AGENT_SOCKET="${AGENTMUX_AGENT_SOCKET:-}"
# Dir holding the optional per-role user overlays (user.{agent,frame,term}.tmux.conf).
# The agent/frame/term tmux confs `source-file -q $AGENTMUX_USER_DIR/user.<role>.tmux.conf`
# LAST, so tmux expands this from the environment it captured at server start — hence the
# EXPORT (a plain var wouldn't reach the tmux process). Defaults to ~/.agentmux, the user
# install root (where amux.toml lives too); an explicit value redirects the whole set, so
# selftests read throwaway overlays instead of the user's real ~/.agentmux/user.*.tmux.conf
# — exactly the AGENTMUX_*_SOCKET isolation idiom. tmux reads source-file vars from the
# server's frozen environment, so `amux --reload` re-reads the SAME dir the server was born
# with regardless of the reloading client's env.
export AGENTMUX_USER_DIR="${AGENTMUX_USER_DIR:-$HOME/.agentmux}"
# Absolute path to this launcher (for --frame's right-pane re-invocation), resolved
# once here from the same BASH_SOURCE the dirs above use.
AGENTMUX_BIN="${AGENTMUX_BIN:-$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/$(basename "${BASH_SOURCE[0]}")}"

# Single-quote a string for safe interpolation into an `sh -c` command line.
_amux_shquote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Sanitise a tmux session name to a safe-character whitelist. Two reasons,
# both load-bearing:
#  1. tmux uses . and : as target separators (session.win.pane, session:win),
#     so those break `tmux has-session -t` and friends.
#  2. SECURITY: the name is later re-expanded as #{session_name} inside
#     `run-shell` hook bodies (tmux/agentmux.conf, tmux/frame.conf), which tmux
#     passes to `sh -c`. A name containing $(...) / backticks / ; etc. would
#     then execute — and the default name is basename "$PWD", so a hostile
#     directory name would be RCE on `amux`. Whitelisting to [A-Za-z0-9_-]
#     closes both sinks; session names are cosmetic so nothing is lost.
# Dash is last in the set so tr reads it as a literal, not a range endpoint.
_amux_sanitize_session() { printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9_-' '_'; }

# --- Per-project socket resolution -------------------------------------------------
# See the AGENTMUX_TERM_SOCKET comment above for the override-vs-shard rule.
#
# The socket resolvers below are called MANY times per launch (every _amux_atmux /
# frame / term / agent call resolves its socket), and each resolution used to re-fork
# `printf | cksum | cut`. On macOS a fork+exec is ~10ms idle and 50-250ms under load,
# so dozens of these dominate a cold-start. Memoize the hash, keyed on $PWD so a
# subshell that `cd`s to another project (the restore path) still recomputes correctly.
# The cache only persists across the many `sock=$(_amux_*_sock)` COMMAND-SUBSTITUTION
# subshells if it was populated in the PARENT shell first — those subshells fork from
# the parent and inherit its vars, but their own writes die with them. So a real launch
# warms it once in parent context (see _amux_warm_launch_caches); a cold call (unwarmed
# key, or a different $PWD) falls back to the fork. Same technique warms _amux_json.
_amux_pwd_hash() {
  if [ "${_amux_pwd_hash_key-}" = "$PWD" ] && [ -n "${_amux_pwd_hash_val-}" ]; then
    printf '%s\n' "$_amux_pwd_hash_val"; return
  fi
  _amux_pwd_hash_key="$PWD"
  _amux_pwd_hash_val=$(printf '%s' "$PWD" | cksum | cut -d' ' -f1)
  printf '%s\n' "$_amux_pwd_hash_val"
}
# Populate the per-process caches ONCE, in the parent shell, so the launch's many
# `$(...)` subshells inherit them instead of re-forking cksum/stat/cat/toml2json per
# call. Must be called as a direct (non-substituted) statement so the globals it sets
# land in the caller's shell, not a throwaway subshell. Idempotent and cheap to repeat.
_amux_warm_launch_caches() {
  _amux_pwd_hash >/dev/null 2>&1 || true   # → _amux_pwd_hash_key/_val for $PWD
  _amux_json      >/dev/null 2>&1 || true   # → _amux_json_cache (config JSON)
}
_amux_tmux_sockdir() { printf '%s/tmux-%s\n' "${TMUX_TMPDIR:-/tmp}" "$(id -u)"; }

# The socket for THIS project ($PWD). Override wins verbatim; else shard by hash.
_amux_frame_sock() {
  if [ -n "${AGENTMUX_FRAME_SOCKET:-}" ]; then printf '%s\n' "$AGENTMUX_FRAME_SOCKET"
  else printf 'agentmux-frame-%s\n' "$(_amux_pwd_hash)"; fi
}
_amux_term_sock() {
  if [ -n "${AGENTMUX_TERM_SOCKET:-}" ]; then printf '%s\n' "$AGENTMUX_TERM_SOCKET"
  else printf 'agentmux-term-%s\n' "$(_amux_pwd_hash)"; fi
}

# ALL agentmux socket FILES, for name-targeted commands with no $PWD to derive from.
# Override wins (single socket); else glob the tmux socket dir. The glob matches the
# legacy bare 'agentmux-frame'/'agentmux-term' AND sharded '<name>-<hash>', so frames
# already running from before the upgrade stay enumerated and killable. [ -S ] drops
# the literal pattern when the dir has no matches (nullglob-safe, no arrays) — but it
# tests "is a socket", NOT "is a LIVE server": macOS leaves a stale socket file behind
# after `tmux kill-server`, so this can return dead sockets. Callers needing liveness
# must filter via list-sessions/has-session (as _amux_frames, the *_kill_all liveness
# loops, and _amux_sock_hosting do) — never act on a returned socket blind.
_amux_frame_socks() {
  if [ -n "${AGENTMUX_FRAME_SOCKET:-}" ]; then printf '%s\n' "$AGENTMUX_FRAME_SOCKET"; return; fi
  local d f; d=$(_amux_tmux_sockdir)
  for f in "$d"/agentmux-frame*; do [ -S "$f" ] && printf '%s\n' "${f##*/}"; done
}
_amux_term_socks() {
  if [ -n "${AGENTMUX_TERM_SOCKET:-}" ]; then printf '%s\n' "$AGENTMUX_TERM_SOCKET"; return; fi
  local d f; d=$(_amux_tmux_sockdir)
  for f in "$d"/agentmux-term*; do [ -S "$f" ] && printf '%s\n' "${f##*/}"; done
}

# The agent socket for THIS project ($PWD). Override wins verbatim; else shard by hash.
# Agents are co-keyed with the frame/term (same $PWD hash → agentmux-{frame,term,agent}-<h>).
_amux_agent_sock() {
  if [ -n "${AGENTMUX_AGENT_SOCKET:-}" ]; then printf '%s\n' "$AGENTMUX_AGENT_SOCKET"
  else printf 'agentmux-agent-%s\n' "$(_amux_pwd_hash)"; fi
}

# ALL agent socket FILES, for name-targeted commands with no $PWD to derive from.
# Override wins (single socket); else glob the tmux socket dir. [ -S ] tests "is a
# socket", NOT "is a LIVE server" (macOS leaves a stale file after kill-server) — callers
# needing liveness filter via list-sessions/has-session (as --sessions and named --kill do).
_amux_agent_socks() {
  if [ -n "${AGENTMUX_AGENT_SOCKET:-}" ]; then printf '%s\n' "$AGENTMUX_AGENT_SOCKET"; return; fi
  local d f; d=$(_amux_tmux_sockdir)
  for f in "$d"/agentmux-agent*; do [ -S "$f" ] && printf '%s\n' "${f##*/}"; done
}

# Read a newline socket list on stdin; echo the first socket hosting session <sess>.
# Socket names never contain spaces/globs, so the plain read loop is safe.
_amux_sock_hosting() {
  local sess="$1" s found=""
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    if tmux -L "$s" has-session -t "=$sess" 2>/dev/null; then found="$s"; break; fi
  done
  [ -n "$found" ] && printf '%s\n' "$found"
}

# tmux on THIS project's agent socket. AGENTMUX_AGENT_SOCKET set → that socket verbatim
# (test isolation); empty → the per-project shard `agentmux-agent-<cksum $PWD>`. `env -u
# TMUX` is kept belt-and-suspenders: `-L` already overrides an inherited $TMUX, but clearing
# it means a stray bare `tmux` in a subprocess can't mis-target the frame server either.
# This is the CWD-context helper — name-targeted commands scan `_amux_agent_socks` instead.
#
# `-f agent.conf` is passed on EVERY call, but tmux reads it ONLY when a call starts the
# server (the first new-session on a cold per-project shard) — it's ignored for commands
# against an already-running server. That's the whole fix for the sharding startup regression:
# without it a cold agent server fell through to ~/.tmux.conf and ran TPM's synchronous
# `run` line (seconds per project). agent.conf is the AGENT peer of -f frame.conf/-f term.conf;
# routing it through this one chokepoint (not each new-session site) means no future
# server-creating path can silently forget it. Guarded on the file existing so a stale
# pre-update install (tmux/ without agent.conf yet) still launches — just without the speedup.
_amux_atmux() {
  local sock; sock=$(_amux_agent_sock)
  local conf="$AGENTMUX_TMUX/agent.conf"
  if [ -f "$conf" ]; then
    env -u TMUX tmux -L "$sock" -f "$conf" "$@"
  else
    env -u TMUX tmux -L "$sock" "$@"
  fi
}

# tmux resolves a `-t` session target by exact → prefix → fnmatch, so a bare
# `has-session -t reductable` is TRUE when only `reductable-www` exists and the
# subsequent attach joins the WRONG session (and the create-vs-attach decision is
# wrong both ways). Prefixing the target with `=` forces EXACT matching. It is
# honoured by has-session/attach-session/switch-client/kill-session and window
# targets (`=sess:0`), but NOT by set-option (target left bare there — tmux still
# tries exact-match first, and those calls only run once the exact session is
# known to exist) nor by split-window/list-panes. Don't drop the `=`.
_amux_session_exists() { _amux_atmux has-session -t "=$1" 2>/dev/null; }

# Newline-separated names of agentmux-managed sessions (@autoagent=1) across ALL
# agent socket shards; empty if none. Backs --sessions, --kill-all, and
# --complete-sessions.
_amux_agent_session_names() {
  local s
  for s in $(_amux_agent_socks); do
    tmux -L "$s" list-sessions -F '#{?@autoagent,#{session_name},}' 2>/dev/null
  done | grep .
}

# --- Directory-guarded session ownership -------------------------------------
# amux names a session after the current dir's basename, so two projects that
# share a basename (~/work/api and ~/personal/api) resolve to the SAME session
# name. warden drives --probe/--kill by CWD (no explicit name, cwd = the tab's
# dir), so without a guard its cyan dot could light from — and its kill could
# tear down — the OTHER project's session. Each agent and frame session records
# its launch dir in the @amux_dir session option (set on every (re)launch); the
# CWD-derived probe/kill treat a session whose @amux_dir is a DIFFERENT path as
# "not ours". A session with no @amux_dir — created before this feature and not
# yet relaunched — counts as ours, so nothing regresses for already-running
# sessions. An explicit `amux --probe/--kill <name>` targets by name and skips
# the guard entirely (unchanged behaviour). @amux_dir is only ever an opaque
# option value compared as a string — never re-expanded as a target — so the
# session-name whitelist (_amux_sanitize_session) is unaffected.
# show-options targets the bare name: callers only reach here after an exact
# has-session check, and tmux matches exact before prefix (see _amux_session_exists).
_amux_agent_session_is_mine() {
  _amux_session_exists "$1" || return 1
  local sdir; sdir=$(_amux_atmux show-options -qv -t "$1" @amux_dir 2>/dev/null)
  [ -z "$sdir" ] || [ "$sdir" = "$PWD" ]
}
_amux_frame_session_is_mine() {
  # CWD-context guard: the frame for THIS dir lives on the $PWD-derived socket, so the
  # socket itself already isolates same-basename projects; the @amux_dir check stays as
  # belt-and-suspenders (and covers the override/selftest single-socket case).
  local sock; sock=$(_amux_frame_sock)
  tmux -L "$sock" has-session -t "=$1" 2>/dev/null || return 1
  local sdir; sdir=$(tmux -L "$sock" show-options -qv -t "$1" @amux_dir 2>/dev/null)
  [ -z "$sdir" ] || [ "$sdir" = "$PWD" ]
}

# Clamp a percent to 10..90. Non-numeric/empty falls back to $2 (the default),
# which may itself be empty — in which case the result is empty (no output).
_amux_clamp_pct() {
  local v="$1"
  case "$v" in ''|*[!0-9]*) v="$2" ;; esac
  [ -z "$v" ] && return 0
  [ "$v" -lt 10 ] && v=10
  [ "$v" -gt 90 ] && v=90
  printf '%s' "$v"
}

# _amux_parse_selection <count> <input> — echo the chosen 1-based indices (space
# separated, input order, deduped, each in [1,count]). a/all → all; ''/n/none/q → none.
_amux_parse_selection() {
  local count="$1" input="$2" norm tok seen=" "
  norm=$(printf '%s' "$input" | tr 'A-Z' 'a-z' | tr -d '[:space:]')
  case "$norm" in
    a|all)            local i; for ((i=1;i<=count;i++)); do printf '%s ' "$i"; done; return 0 ;;
    ''|n|none|q|quit) return 0 ;;
  esac
  for tok in $(printf '%s' "$input" | tr ',' ' '); do
    case "$tok" in ''|*[!0-9]*) continue ;; esac
    tok=$((10#$tok))   # normalize to decimal so a zero-padded token isn't read as octal
    { [ "$tok" -ge 1 ] && [ "$tok" -le "$count" ]; } || continue
    case "$seen" in *" $tok "*) continue ;; esac
    seen="$seen$tok "
    printf '%s ' "$tok"
  done
}

# _amux_ago <epoch> — compact relative age for the picker.
_amux_ago() {
  local now delta; now=$(date +%s); delta=$(( now - ${1:-0} ))
  if   [ "$delta" -lt 60 ];    then printf 'just now'
  elif [ "$delta" -lt 3600 ];  then printf '%dm ago' "$(( delta / 60 ))"
  elif [ "$delta" -lt 86400 ]; then printf '%dh ago' "$(( delta / 3600 ))"
  else printf '%dd ago' "$(( delta / 86400 ))"; fi
}

# Resolve the left-pane width for --frame: [frame] left (percent), default 30,
# clamped to 10..90. Non-numeric or absent → default.
_amux_frame_width() { _amux_clamp_pct "$(agentmux_frame_field left "$PWD")" 30; }

# Resolve the OPTIONAL left-column vertical split for --frame: [frame]
# left_vertical_split (percent height of the TOP sub-pane), clamped to 10..90.
# Opt-in: unset or non-numeric → empty output (the left column stays one pane).
_amux_frame_top_height() { _amux_clamp_pct "$(agentmux_frame_field left_vertical_split "$PWD")" ""; }

# Resolve how many stacked (top/bottom) plain-shell panes fill the top sub-region for
# --frame: [frame] left_top_panes, clamped to 1..6, default 1 (absent/non-numeric).
# Only meaningful when left_vertical_split is set (no top region otherwise).
_amux_frame_top_panes() {
  local v; v=$(agentmux_frame_field left_top_panes "$PWD")
  case "$v" in ''|*[!0-9]*) v=1 ;; esac
  [ "$v" -lt 1 ] && v=1
  [ "$v" -gt 6 ] && v=6
  printf '%s' "$v"
}

# Resolve which pane the frame focuses on start: [frame] focus. "terminal" focuses
# the left scratch column; anything else (incl. unset) focuses the agent (right).
_amux_frame_focus() {
  case "$(agentmux_frame_field focus "$PWD")" in terminal) echo terminal ;; *) echo agent ;; esac
}

# Resolve the frame status bar position: [frame] status_position. "top" puts the
# [amux frame] bar at the top; anything else (incl. unset) keeps it at the bottom.
_amux_frame_status_position() {
  case "$(agentmux_frame_field status_position "$PWD")" in top) echo top ;; *) echo bottom ;; esac
}

# Whether a bare `amux` (no --frame/--no-frame) should open a frame: [frame]
# default = true. Echoes "1" when on, "" otherwise.
_amux_frame_default() {
  [ "$(agentmux_frame_field default "$PWD")" = "true" ] && echo 1 || echo ""
}

# [notes] row: 1 when this project's fourth status row (the always-on note line)
# is enabled, else empty. Published to tmux as @amux_note_row on every launch;
# update_colors.sh reads THAT to choose `status 5` over `status 4`.
# Config-read, so it rides the launch-time memo like every other field helper
# here — do not call it per-window.
# Takes the directory to resolve against so `--reload` can answer for a session
# other than the one the CLI is standing in ([notes.dirs."<path>"] makes the
# answer per-project); defaults to $PWD for the launch path.
_amux_note_row() {
  [ "$(agentmux_notes_field row "${1:-$PWD}")" = "true" ] && echo 1 || echo ""
}

# Row 4's empty-state hint, asked of notes.sh (its NT_HINT4) so the literal lives
# in exactly one place. Published as the SESSION-level @amux_note4 alongside
# @amux_note_row, and that publish is what puts the hint on screen at launch:
# status-format[4] substitutes @amux_note4, and the only thing that ever WRITES
# that option — notes.sh's _nt_render — is reachable solely from a click or
# `prefix N`, neither of which is on the launch path. Without the default, a
# freshly launched tab draws row 4 as blank padding and the affordance that is
# the whole point of the row never appears.
#
# A session-scope DEFAULT, not a per-window render, on purpose: tmux resolves
# pane->window->session->global, so one write covers every window and pane of the
# session — including ones amux never creates itself (restored/forked tabs, which
# carry an explicit pane_start_command and are deliberately skipped by
# launch_agent.sh, plus split panes) — and a real note, always written
# pane-level, shadows it. One fork per launch, only when the row is enabled;
# never one per window.
#
# Empty output here (missing/unreadable notes.sh, a mis-resolved AGENTMUX_SCRIPTS)
# must NOT become an explicit @amux_note4 "" — that republishes, with no trace of
# why, the exact blank-row bug this default exists to fix. So this returns
# non-zero on empty and warns to stderr, same convention as the [amux] prefix
# collision guard and the unknown-bar-colour guard above: degraded state is
# surfaced, never swallowed. The caller (below) checks the exit status and skips
# the publish on failure, leaving @amux_note4 unset rather than clobbered.
_amux_note_hint4() {
  local h
  h=$(sh "$AGENTMUX_SCRIPTS/notes.sh" hint 4 2>/dev/null)
  if [ -z "$h" ]; then
    echo "amux: could not read row 4's hint from notes.sh ($AGENTMUX_SCRIPTS/notes.sh missing or unreadable?) — row 4 will show blank until a note is written" >&2
    return 1
  fi
  printf '%s' "$h"
}

# The [notes] row session options for <session>, resolved against <dir>, left in
# the _AMUX_NOTE_OPTS array as tmux arguments ready to splice into a ';'-chained
# batch. An array rather than a string because the hint carries spaces and `#[…]`
# style directives that word-splitting would destroy, and a global because bash
# 3.2 has no namerefs.
#
# ONE implementation, two callers: the launch path (_amux_ensure_agent_session)
# and `--reload`. They must agree exactly — a reload that published a different
# shape than a launch would make the row's state depend on which command you last
# ran, which is precisely the confusion this feature already cost once.
#
# SYMMETRIC: the else branch UNSETS both options, so turning `row = false` back
# off takes effect. See _amux_ensure_agent_session's call site for why an add-only
# emit was wrong, and _amux_note_hint4 for why an empty hint skips its set.
_amux_note_opts() {
  local _nos=$1 _nod=$2 _norow _nohint
  _norow=$(_amux_note_row "$_nod")
  if [ -n "$_norow" ]; then
    _AMUX_NOTE_OPTS=(set-option -t "$_nos" @amux_note_row 1)
    if _nohint=$(_amux_note_hint4); then
      _AMUX_NOTE_OPTS+=(';' set-option -t "$_nos" @amux_note4 "$_nohint")
    fi
  else
    _AMUX_NOTE_OPTS=(set-option -u -t "$_nos" @amux_note_row
                     ';' set-option -u -t "$_nos" @amux_note4)
  fi
}

# The effective frame prefix for $PWD: [frame] prefix, or frame.conf's built-in
# default when unset. Kept in sync with `set -g prefix` in tmux/frame.conf.
_AMUX_FRAME_PREFIX_DEFAULT="C-f"
_amux_frame_prefix() {
  local p; p=$(agentmux_frame_field prefix "$PWD")
  printf '%s' "${p:-$_AMUX_FRAME_PREFIX_DEFAULT}"
}

# Resolve the per-session prefix for the amux (agent) session: [amux] prefix,
# dir-scoped. Empty output = leave the user's own ~/.tmux.conf prefix untouched.
#
# Collision guard: the --frame wrapper runs amux in its right pane and intercepts
# its OWN prefix before the inner amux ever sees it, so an [amux] prefix equal to
# the (effective) [frame] prefix would be unreachable inside a frame. On collision
# we warn and emit nothing — falling back to the user's default prefix (which the
# frame passes straight through) beats setting a key the frame would shadow.
_amux_prefix() {
  local p f
  p=$(agentmux_amux_field prefix "$PWD")
  [ -z "$p" ] && return 0
  f=$(_amux_frame_prefix)
  if [ "$p" = "$f" ]; then
    echo "amux: [amux] prefix '$p' collides with the [frame] prefix; ignoring (the frame would shadow it inside --frame)" >&2
    return 0
  fi
  printf '%s' "$p"
}

# Pinned bar-colour slot for a directory, via [amux.dirs."<dir>"].session_colour.
# Empty when unpinned or the name is unknown. update_colors.sh is sourced in a
# subshell so its palette/count globals don't leak into amux's namespace and its
# dispatch guard (basename check) stays a no-op.
_amux_bar_pin_slot() {
  local nm; nm=$(agentmux_amux_field session_colour "$1")
  [ -z "$nm" ] && return 0
  # shellcheck source=/dev/null
  ( . "$AGENTMUX_SCRIPTS/update_colors.sh"; _bar_name_to_slot "$nm" )
}

# Space-separated unique reserved slots for every pinned
# [amux.dirs.*].session_colour (insertion order; the reconcile is order-agnostic).
# Warns (stderr) on an unknown colour name or two dirs pinning the same slot.
# Published as the global @l1reserved so update_colors.sh excludes these slots
# from the newcomer pool even when the pinned project is not running.
_amux_bar_reserved() {
  local names; names=$(_amux_json | jq -r '(.amux.dirs // {}) | to_entries[] | .value.session_colour // empty')
  [ -z "$names" ] && return 0
  # shellcheck source=/dev/null
  (
    . "$AGENTMUX_SCRIPTS/update_colors.sh"
    seen=' '
    # Iterate line-wise via a here-string: a session_colour value with a glob
    # char (* ? [) or whitespace would otherwise word-split / glob against CWD
    # and silently lose the slot reservation it is meant to publish. The
    # here-string (not a pipe) keeps the loop in this shell so $seen survives
    # for the `set -- $seen` below.
    while IFS= read -r nm; do
      [ -n "$nm" ] || continue
      s=$(_bar_name_to_slot "$nm")
      if [ -z "$s" ]; then
        echo "amux: unknown bar colour '$nm' in [amux.dirs] — run 'amux --colours' for names" >&2
        continue
      fi
      case "$seen" in
        *" $s "*) echo "amux: bar colour '$nm' (slot $s) is pinned by more than one dir — last wins" >&2 ;;
        *) seen="$seen$s " ;;
      esac
    done <<< "$names"
    set -- $seen
    echo "$*"
  )
}

# Whether --frame may run inside an existing tmux: [frame] allow_nested = true.
# Off by default — the frame is itself a tmux server, so nesting it inside your
# tmux stacks prefixes and is normally refused. Advanced users already living in
# tmux can opt in. Echoes "1" when on, "" otherwise.
_amux_frame_allow_nested() {
  [ "$(agentmux_frame_field allow_nested "$PWD")" = "true" ] && echo 1 || echo ""
}

# Resolve (agent, session) from amux positional args: [(-flag | name)] [session].
# Echoes agent on line 1, session on line 2 (neither can contain a newline:
# agent names are TOML keys, sessions are sanitised). Mirrors amux()'s own
# precedence: flag → name → dir-routing → first agent; session defaults to $PWD.
_amux_resolve_target() {
  local agent_name=""
  if [ $# -gt 0 ]; then
    case "$1" in
      -*)
        local flag="${1#-}" fidx
        fidx=$(agentmux_find_by_flag "$flag")
        if [ "$fidx" = "-1" ]; then
          echo "amux: unknown flag -$flag" >&2; return 1
        fi
        agent_name=$(agentmux_agent_field "$fidx" name); shift ;;
    esac
  fi
  if [ $# -gt 0 ] && [ -z "$agent_name" ]; then
    local nidx; nidx=$(agentmux_find_by_name "$1")
    if [ "$nidx" != "-1" ]; then agent_name="$1"; shift; fi
  fi
  local session_arg; session_arg=$(_amux_sanitize_session "${1:-$(_amux_default_session_name)}")
  [ -z "$agent_name" ] && agent_name=$(agentmux_agent_for_dir "$PWD")
  [ -z "$agent_name" ] && agent_name=$(agentmux_first_agent)
  printf '%s\n%s\n' "$agent_name" "$session_arg"
}

_amux_default_session_name() {
  _amux_sanitize_session "$(basename "$PWD")"
}

# Attach the current project's agent session (on its $PWD shard). switch-client is
# gone with the shared default socket — it can't cross sockets, and the direct-tmux
# in-place switch it served is a workflow we no longer support (each project is its
# own server; you attach, you don't switch within one).
_amux_attach() {
  _amux_atmux attach-session -t "=$1"
}

# Update an installed clone in place. Dev/symlink installs are not clones and
# are updated via the source checkout instead.
_amux_update() {
  local dir="$1"
  if [ -d "$dir/.git" ]; then
    if ! git -C "$dir" pull --ff-only; then
      echo "amux: update failed — resolve manually in $dir (run: git -C $dir status)" >&2
      return 1
    fi
    local v; v=$(tr -d '[:space:]' < "$dir/VERSION" 2>/dev/null)
    echo "agentmux updated to ${v:-unknown}"
  else
    echo "amux: $dir is not a git clone (dev/symlink install) — 'git pull' your source checkout instead" >&2
    return 1
  fi
}

_amux_launch_window0() {
  local session="$1" agent="$2"
  local idx cmd

  idx=$(agentmux_find_by_name "$agent")
  [ "$idx" = "-1" ] && return 1

  cmd=$(agentmux_build_cmd "$idx")

  _amux_atmux rename-window -t "=$session:0" "$agent"
  # Explicit socket: this CLI process has no ambient $TMUX pointing at the
  # (possibly sharded) agent socket, so a bare tmux would style the default
  # socket instead — same reasoning as the session_log.sh open below.
  agentmux_set_window_style "$agent" "$session:0" "$(_amux_agent_sock)"
  _amux_atmux send-keys -t "=$session:0" "$cmd" Enter
  # Explicit socket: this CLI process hasn't attached to the (possibly sharded)
  # agent session yet, so it has no ambient $TMUX pointing at it — see _sl_ctx.
  "$AGENTMUX_SCRIPTS/session_log.sh" open "$agent" "=$session:0" "$(_amux_agent_sock)" 2>/dev/null || true
}

# Print a paste-ready `colour =` field for an agent (testable; no I/O loop).
_amux_colour_line() { # <agent> <name-or-code>
  printf 'Add this under the [[agents]] block for "%s" in %s:\n\n    colour = "%s"\n' \
    "$1" "$AGENTMUX_CONFIG" "$2"
}

# Interactive picker: choose an agent (arg or prompt) and a colour, print the line.
_amux_colour_pick() {
  local agent="$1"
  if [ -z "$agent" ]; then
    local -a anames=(); local a i=1
    while IFS= read -r a; do anames+=("$a"); done < <(agentmux_list_agent_completions | grep -v '^-')
    echo "Pick an agent:" >&2
    for a in "${anames[@]}"; do echo "  $i) $a" >&2; i=$((i + 1)); done
    printf 'agent #> ' >&2; local choice; read -r choice
    case "$choice" in ''|*[!0-9]*) choice=0 ;; esac
    [ "$choice" -ge 1 ] && agent="${anames[$((choice - 1))]:-}"
  fi
  [ -z "$agent" ] && { echo "amux: no agent selected" >&2; return 1; }

  "$AGENTMUX_SCRIPTS/colours.sh" render >&2
  local -a cnames=(); local cn
  while IFS= read -r cn; do cnames+=("$cn"); done < <("$AGENTMUX_SCRIPTS/colours.sh" names)
  printf 'colour #> ' >&2; local cc; read -r cc
  case "$cc" in ''|*[!0-9]*) cc=0 ;; esac
  local picked=""
  [ "$cc" -ge 1 ] && picked="${cnames[$((cc - 1))]:-}"
  [ -z "$picked" ] && { echo "amux: no colour selected" >&2; return 1; }
  _amux_colour_line "$agent" "$picked"
}

# Dispatch `amux --colours [grid|names|pick [agent]]` (default: render preview).
_amux_colours() {
  case "${1:-}" in
    grid)  "$AGENTMUX_SCRIPTS/colours.sh" grid ;;
    names) "$AGENTMUX_SCRIPTS/colours.sh" names ;;
    pick)  shift; _amux_colour_pick "$@" ;;
    ''|render)
      printf '  Agent window-tab colours (per agent via [[agents]].colour):\n'
      "$AGENTMUX_SCRIPTS/colours.sh" render
      printf '\n  Session bar colours (per dir via [amux.dirs."<dir>"].session_colour):\n'
      # shellcheck source=/dev/null
      ( . "$AGENTMUX_SCRIPTS/update_colors.sh"; colour_bar_render )
      ;;
    *) echo "usage: amux --colours [grid|names|pick [agent]]" >&2; return 1 ;;
  esac
}

# amux --frame [(-<flag> | <agent>)] [session]
# Build the right-pane command: a bare tmux attach on THIS project's agent socket.
# The parent (_amux_frame) already created + fully configured the agent session
# before splitting this pane, so the pane needs no second amux launch — it just
# attaches. TMUX is cleared so it attach-sessions on the agent socket rather than
# switch-client'ing the frame socket. No `-f agent.conf`: the agent server is
# already running (the parent's new-session started it with agent.conf), and -f is
# read only at server start. Deliberately NOT a re-exec loop: the pane runs with
# remain-on-exit (set below), and the frame's pane-died hook (frame_reattach.sh)
# re-attaches it ONLY while the agent session is still alive — an accidental
# prefix-d detach heals in place, a real kill leaves the pane dead so the next
# launch's live-pane staleness check rebuilds the frame (no auto-resurrection).
# This is the same command frame_reattach.sh itself runs, so initial-attach and
# reattach are identical.
_amux_frame_right_cmd() { # <agent-socket> <session>
  printf 'env -u TMUX tmux -L %s attach-session -t %s' \
    "$(_amux_shquote "$1")" "$(_amux_shquote "=$2")"
}

# Build the left-pane command: a dedicated, persistent scratch-terminal tmux on
# its own socket (TMUX cleared so it doesn't nest into the frame socket). Plain
# invocation — no shell loop — so any login shell incl. fish can run it;
# persistence is handled inside term.conf (respawn hook), not here.
_amux_frame_left_cmd() { # <term-socket> <term-conf> <term-session>
  printf 'env -u TMUX tmux -L %s -f %s new-session -A -s %s -c %s' \
    "$(_amux_shquote "$1")" "$(_amux_shquote "$2")" "$(_amux_shquote "$3")" "$(_amux_shquote "$PWD")"
}

# Outer "frame": a bare $SHELL in the left pane, amux in the right pane, as a
# nested tmux on a dedicated socket. Must be run from a plain terminal.
_amux_frame() {
  # Warm the per-process caches in THIS (parent) shell before the many $()-subshell
  # socket/config lookups below inherit them — the frame path resolves the frame,
  # term, and agent sockets and reads a dozen [frame]/[amux] fields.
  _amux_warm_launch_caches
  if [ -n "${TMUX:-}" ] && [ -z "$(_amux_frame_allow_nested)" ]; then
    echo "amux: --frame must be run from a plain terminal, not inside tmux (set [frame] allow_nested = true to override)" >&2
    return 1
  fi
  local frame_conf="$AGENTMUX_TMUX/frame.conf" term_conf="$AGENTMUX_TMUX/term.conf"
  if [ ! -f "$frame_conf" ]; then
    echo "amux: frame config not found at $frame_conf" >&2; return 1
  fi
  if [ ! -f "$term_conf" ]; then
    echo "amux: term config not found at $term_conf" >&2; return 1
  fi

  local target agent session
  target=$(_amux_resolve_target "$@") || return 1
  agent=$(printf '%s' "$target" | sed -n 1p)
  session=$(printf '%s' "$target" | sed -n 2p)

  # The frame session lives on its own socket and is named distinctly from the
  # amux session it wraps (which runs on the project's own agent socket): a same-named
  # frame blurs the two, and a stale frame is harder to tell apart from the real one.
  local sock; sock=$(_amux_frame_sock)
  local fsess="${session}-frame"
  # Export the $PWD-derived term socket so the frame server (and its C-f Q binding /
  # frame_reattach hook, which read $AGENTMUX_TERM_SOCKET back) pair to THIS project's
  # term server. In the override/selftest case _amux_term_sock returns it verbatim.
  export AGENTMUX_TERM_SOCKET; AGENTMUX_TERM_SOCKET=$(_amux_term_sock)

  # Optional left-column vertical split (empty = off) and its top-region pane count.
  # Resolved up front so the staleness check below knows the expected pane count.
  local top top_panes; top=$(_amux_frame_top_height); top_panes=$(_amux_frame_top_panes)

  # A frame that has lost its right (agent) pane is useless — reattaching it just
  # shows a full-width terminal. The agent pane runs with remain-on-exit, so a
  # detached/killed agent leaves a DEAD pane rather than vanishing; count only
  # LIVE panes (#{pane_dead}=0) so such a frame still reads as stale and gets
  # rebuilt. Expected: 2 live panes (agent + bottom scratch), plus $top_panes more
  # when the left split is on (so a single top pane still wants 3).
  if tmux -L "$sock" has-session -t "=$fsess" 2>/dev/null; then
    local npanes want; want=2; [ -n "$top" ] && want=$((2 + top_panes))
    npanes=$(tmux -L "$sock" list-panes -t "$fsess" -F '#{pane_dead}' 2>/dev/null | grep -c '^0$')
    [ "${npanes:-0}" -lt "$want" ] && tmux -L "$sock" kill-session -t "=$fsess" 2>/dev/null
  fi

  if ! tmux -L "$sock" has-session -t "=$fsess" 2>/dev/null; then
    local left right right_cmd left_cmd fprefix cols lines _sz focus status_pos
    # Create + fully configure this project's agent session in the PARENT, so the
    # right pane is a bare attach rather than a second amux cold-start. Runs only
    # here (inside the rebuild branch), so a healthy idempotent re-launch — frame up,
    # agent pane live — never re-prompts. version_check + legacy_notice both self-gate
    # (daily timestamp / persistent marker), so calling them here is safe even when
    # the frame-default path already called _amux_legacy_notice once.
    _amux_legacy_notice
    [ -x "$AGENTMUX_SCRIPTS/version_check.sh" ] && "$AGENTMUX_SCRIPTS/version_check.sh" || true
    _amux_ensure_agent_session "$agent" "$session"
    # Start focus (agent|terminal) and status bar position (bottom|top), [frame] config.
    focus=$(_amux_frame_focus)
    status_pos=$(_amux_frame_status_position)
    left=$(_amux_frame_width)
    right=$((100 - left))
    left_cmd=$(_amux_frame_left_cmd "$AGENTMUX_TERM_SOCKET" "$term_conf" "${session}-term")
    # Right pane = a bare attach to the agent session the parent created below,
    # on this project's agent shard (cache-warmed).
    right_cmd=$(_amux_frame_right_cmd "$(_amux_agent_sock)" "$session")
    # Create the frame at the real terminal size (--frame runs in a plain
    # terminal). tmux distributes a *resize* equally across panes, so a frame born
    # at tmux's detached 80-col default would skew the ratio when it later attaches
    # to a wider terminal; sizing it correctly up front keeps the left at $left%.
    # Read the size from the controlling terminal (`stty size` → "rows cols");
    # `tput cols` reports the terminfo default under command substitution.
    _sz=$(stty size </dev/tty 2>/dev/null); lines=${_sz%% *}; cols=${_sz##* }
    case "$cols" in ''|*[!0-9]*) cols=0 ;; esac
    case "$lines" in ''|*[!0-9]*) lines=0 ;; esac
    # Left pane = persistent scratch terminal (own socket); right pane = amux.
    # Pass -x/-y only when the real size was readable; otherwise let tmux default.
    local nsargs=(new-session -d -s "$fsess" -c "$PWD")
    [ "$cols" -gt 0 ] && [ "$lines" -gt 0 ] && nsargs+=(-x "$cols" -y "$lines")
    tmux -L "$sock" -f "$frame_conf" "${nsargs[@]}" "$left_cmd"
    # The sole pane is the left column; remember it so we can subdivide it below.
    local left_pid agent_pid
    left_pid=$(tmux -L "$sock" list-panes -t "$fsess" -F '#{pane_id}')
    # Survive an accidental detach. The scratch terminal is a nested tmux client
    # (term socket), so a stray prefix-d while it's focused passes through the
    # frame, detaches it, and its attach exits — which without remain-on-exit
    # would destroy the pane and reflow the frame to full width. remain-on-exit
    # keeps the pane; the frame's pane-died hook (frame_reattach.sh) re-attaches
    # it while the term session still exists. @amux_role tells the hook which
    # session/socket to check. Per-pane, not -g: only these nested-tmux panes
    # should survive their command exiting — the optional top scratch shell is a
    # plain shell with no detach footgun, so it's left untagged and closes normally.
    tmux -L "$sock" set -p -t "$left_pid" remain-on-exit on
    tmux -L "$sock" set -p -t "$left_pid" @amux_role term
    # Optional frame prefix override ([frame] prefix); default is in frame.conf.
    # Per-session (not -g), like @amux_project below: prefix is a session option,
    # and a per-project frame socket can still host several frame sessions — a global
    # set would let the last launch clobber the others (more so now it's dir-aware).
    fprefix=$(agentmux_frame_field prefix "$PWD")
    [ -n "$fprefix" ] && tmux -L "$sock" set -t "$fsess" prefix "$fprefix"
    # Project label for the status-left badge ([amux frame] <projectdir>/<session>).
    # Per-session (not -g): the frame socket can host several frame sessions (for this
    # project), and a global option would let the last launch clobber the others.
    tmux -L "$sock" set -t "$fsess" @amux_project "$(basename "$PWD")"
    # Full launch dir (not just the basename above) so the CWD-derived --probe/
    # --kill can distinguish this frame from another project's same-basename frame.
    tmux -L "$sock" set -t "$fsess" @amux_dir "$PWD"
    # Status bar position ([frame] status_position): frame.conf relies on tmux's
    # default (bottom); override per-session here when "top" is requested.
    tmux -L "$sock" set -t "$fsess" status-position "$status_pos"
    # `-l` sizes the new (right) pane, so the left lands at $left% (`-l N%` needs
    # tmux >= 3.1). split-window -h leaves the new right/agent pane focused.
    agent_pid=$(tmux -L "$sock" split-window -h -t "$fsess" -l "${right}%" -c "$PWD" -P -F '#{pane_id}' "$right_cmd")
    # Same accidental-detach guard for the agent pane (see the term pane above);
    # @amux_role=agent points the hook at the agent session on the default
    # socket. A real kill stays dead instead of being resurrected.
    tmux -L "$sock" set -p -t "$agent_pid" remain-on-exit on
    tmux -L "$sock" set -p -t "$agent_pid" @amux_role agent
    # Optional vertical split of the LEFT column into top/bottom (plain shells in
    # the new TOP region). `-b` inserts the new pane ABOVE left_pid, so the scratch
    # terminal (with its tab bar) stays at the BOTTOM. Done AFTER the agent split so
    # the agent keeps spanning full height; `-l` sizes the new (top) pane to $top%.
    if [ -n "$top" ]; then
      local top_pid i
      top_pid=$(tmux -L "$sock" split-window -v -b -t "$left_pid" -l "${top}%" -c "$PWD" -P -F '#{pane_id}')
      # Stack the top region into $top_panes equal-height plain shells (all full width
      # of the left column, stacked above the scratch terminal). Always split the same
      # top pane, giving each new pane 100/i % of it as i counts down from $top_panes
      # to 2 — `-l N%` is a percentage of the pane being split, so the shrinking top
      # pane leaves ~equal rows within the top region. top_panes=1 → no splits.
      for (( i = top_panes; i >= 2; i-- )); do
        tmux -L "$sock" split-window -v -t "$top_pid" -l "$((100 / i))%" -c "$PWD"
      done
    fi
    # Start focus ([frame] focus): agent (right) by default, or the left scratch
    # column. Done last so it wins over wherever the splits left the active pane.
    case "$focus" in
      terminal) tmux -L "$sock" select-pane -t "$left_pid" ;;
      *)        tmux -L "$sock" select-pane -t "$agent_pid" ;;
    esac
  fi
  # Wire the pane-died reattach hook on the frame SERVER (global) — here, not in
  # frame.conf. `-f frame.conf` is read only when the server first starts, but the
  # frame socket is long-lived (persists across launches), so a server that predates this hook (or
  # any later frame.conf change) would never pick it up. Re-setting it on every
  # `amux --frame` is idempotent and keeps every frame on the server current. Path
  # from $AGENTMUX_SCRIPTS, shquoted so a space in the install path survives the
  # run-shell; #{pane_id} resolves to the dead pane when the hook fires.
  tmux -L "$sock" set-hook -g pane-died \
    "run-shell \"$(_amux_shquote "$AGENTMUX_SCRIPTS/frame_reattach.sh") #{pane_id}\""
  # Same shared-long-lived-server reasoning: focus-events must be ON so a single
  # cross-pane click both switches the active pane AND wakes the inner (focus-aware)
  # tmux to register that click — without it you click once to focus, again to land.
  # frame.conf sets it for a fresh server; this keeps any pre-existing frame current.
  tmux -L "$sock" set-option -g focus-events on
  # Likewise allow-passthrough: the frame is the OUTERMOST tmux, so a desktop
  # notification (OSC 777) the agent emits arrives here wrapped in a passthrough
  # envelope and must be forwarded to the host terminal. With passthrough off (the
  # tmux default, and what frame.conf historically lacked) the frame silently drops
  # it and notifications never reach warden/Ghostty. frame.conf sets it for a fresh
  # server; this line keeps any pre-existing frame current.
  tmux -L "$sock" set-option -g allow-passthrough on
  # Likewise extended keys: the frame must forward CSI-u (Escape, Ctrl-C, Shift+Enter) down
  # to the agent pane, or Claude's kitty-protocol keys desync and Escape/Ctrl-C intermittently
  # die in a framed agent. tmux drops Claude's enable request, so `always` (not `on`) is what
  # forwards them; extkeys carries them from the host terminal. frame.conf sets it for a fresh
  # server; this keeps any pre-existing frame current (same long-lived-server reason).
  tmux -L "$sock" set-option -s extended-keys always
  tmux -L "$sock" set-option -as terminal-features 'xterm*:extkeys,screen*:extkeys'
  # Synchronized output (DECSET 2026): the frame must bracket its redraws to the host in
  # mode 2026, or ghostty tears frames and an unfocused surface flashes its hollow cursor
  # mid-redraw ("cursor flashes around the screen" in a background window). tmux does NOT
  # derive `sync` from the terminfo Sync cap, so it must be named. frame.conf sets it for a
  # fresh server; this keeps a pre-existing frame current (same long-lived-server
  # reason as extkeys). The feature is computed at attach, so a live frame picks it up on
  # the next reattach, not instantly.
  tmux -L "$sock" set-option -as terminal-features 'xterm*:sync,screen*:sync,tmux*:sync'
  # Reset-split binding + its per-session data, asserted here (not just frame.conf)
  # for the same long-lived-server reason as the hook above: a frame server
  # predating this feature has no @amux_left/@amux_left_pane and no `0` override.
  # Setting both on every launch makes a stale frame pick the reset up on the next
  # relaunch, without a full rebuild. @amux_left = configured percent; @amux_left_pane
  # = the left column's pane (tagged @amux_role=term at creation), so resizing its
  # width snaps the whole left column back to left% of the window. Bound to `0` (reset
  # to default, like Cmd+0): the frame is single-window (frame.conf unbinds `c`), so
  # the default `0` = select-window 0 is inert here — overriding it shadows nothing.
  # The binding computes absolute -x cols in the shell, so it doesn't need
  # resize-pane's `-x N%` support.
  local left_pct term_pane
  left_pct=$(_amux_frame_width)
  term_pane=$(tmux -L "$sock" list-panes -t "$fsess" -f '#{==:#{@amux_role},term}' -F '#{pane_id}' 2>/dev/null | head -1)
  tmux -L "$sock" set -t "$fsess" @amux_left "$left_pct"
  [ -n "$term_pane" ] && tmux -L "$sock" set -t "$fsess" @amux_left_pane "$term_pane"
  tmux -L "$sock" bind-key 0 \
    run-shell 'tmux resize-pane -t "#{@amux_left_pane}" -x "$(( #{window_width} * #{@amux_left} / 100 ))"'
  tmux -L "$sock" attach-session -t "=$fsess"
}

# Attach to a running agent session by name from anywhere (no $PWD to derive from):
# find the agent socket hosting it, attach there. Errors cleanly if not found/live.
_amux_attach_by_name() {
  local name sock
  name=$(_amux_sanitize_session "$1")
  sock=$(_amux_agent_socks | _amux_sock_hosting "$name")
  if [ -z "$sock" ]; then
    echo "amux: no live agent session '$name' (try: amux --sessions)" >&2; return 1
  fi
  env -u TMUX tmux -L "$sock" attach-session -t "=$name"
}

# List active frame wrappers (they live on their own per-project socket, so a plain
# `tmux ls` in the base terminal never shows them).
_amux_frames() {
  local s any=0
  for s in $(_amux_frame_socks); do
    if tmux -L "$s" list-sessions 2>/dev/null; then any=1; fi
  done
  [ "$any" -eq 1 ] || echo "amux: no active frames"
}

# Kill a frame from the base terminal (default: the current dir's). Tears down the
# wrapper (frame socket) AND its scratch terminal (term socket); the agent session
# on the project's own agent socket is left running (kill it separately with
# `tmux kill-session -t <session>`).
_amux_frame_kill() {
  local arg base explicit=0
  # Sanitise the same way the frame was named (. and : → _) so an explicit arg or
  # the no-arg default basename resolves to the name the frame was created under.
  if [ $# -gt 0 ]; then arg=$(_amux_sanitize_session "$1"); explicit=1; else arg=$(_amux_default_session_name); fi
  case "$arg" in *-frame) base="${arg%-frame}" ;; *) base="$arg" ;; esac
  local fsess="${base}-frame" tsess="${base}-term" fsock tsock
  if [ "$explicit" -eq 1 ]; then
    # No $PWD to derive from — find whichever sharded socket hosts this named session.
    fsock=$(_amux_frame_socks | _amux_sock_hosting "$fsess")
    tsock=$(_amux_term_socks | _amux_sock_hosting "$tsess")
  else
    fsock=$(_amux_frame_sock); tsock=$(_amux_term_sock)
  fi
  if [ -n "$fsock" ] && tmux -L "$fsock" has-session -t "=$fsess" 2>/dev/null; then
    tmux -L "$fsock" kill-session -t "=$fsess" 2>/dev/null
    [ -n "$tsock" ] && tmux -L "$tsock" kill-session -t "=$tsess" 2>/dev/null   # its scratch terminal
    echo "killed frame '$fsess' + terminal '$tsess' (agent session, if any, still runs)"
  else
    echo "amux: no frame '$fsess' (try: amux --frames)" >&2; return 1
  fi
}

# Kill EVERY frame at once: tears down the whole frame server (all wrappers on the
# frame socket) and the entire scratch-terminal server with it. Agent sessions on
# their own per-project sockets survive. Handy to refresh all frames after a
# frame.conf change, since a frame only reads config when (re)created.
_amux_frame_kill_all() {
  local socks s any=0
  socks=$(_amux_frame_socks)
  for s in $socks; do
    tmux -L "$s" list-sessions >/dev/null 2>&1 && { any=1; break; }
  done
  if [ "$any" -eq 0 ]; then
    echo "amux: no active frames (try: amux --frames)" >&2; return 1
  fi
  for s in $socks; do tmux -L "$s" kill-server 2>/dev/null; done
  for s in $(_amux_term_socks); do tmux -L "$s" kill-server 2>/dev/null; done
  echo "killed all frames + scratch terminals (agent sessions, if any, still run)"
}

# List agentmux-managed (@autoagent) sessions across ALL agent socket shards
# (agentmux-agent-<cksum $PWD> per project): name, agent mode, window count,
# attach state. The view that shows exact session names.
_amux_sessions() {
  local rows
  local _s
  rows=$(for _s in $(_amux_agent_socks); do
    tmux -L "$_s" list-sessions \
      -F '#{?@autoagent,#{session_name}	#{@agent-mode}	#{session_windows} win	#{?session_attached,attached,detached},}' \
      2>/dev/null
  done | grep .)
  if [ -n "$rows" ]; then
    # Align the tab-separated columns with awk (already a dependency); column(1)
    # is not POSIX and is used nowhere else, so don't pull it in just for this.
    printf '%s\n' "$rows" | awk -F'\t' '
      { for (i = 1; i <= NF; i++) { cell[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) }
        if (NF > nc) nc = NF; nr = NR }
      END { for (r = 1; r <= nr; r++) { out = ""
              for (i = 1; i <= nc; i++) { s = cell[r, i]; out = out s
                if (i < nc) { p = w[i] - length(s) + 2; while (p-- > 0) out = out " " } }
              print out } }'
  else
    echo "amux: no agent sessions"
  fi
}

# _amux_restore_into <cwd>   (reads: agent<TAB>resume_cmd per line on stdin)
# Restores the tabs for ONE project session. Window-0-replace: the first tab
# into a fresh session replaces window 0; the rest are new windows created
# WITH the resume_cmd as their pane start command, so launch_agent.sh's guard
# skips the auto-launch. Sets the session opts a normal launch would.
_amux_restore_into() {
  local cwd="$1" name="${2:-}" agent rcmd win created=0 exists=0
  # Restore into the RESTORED project's shard, not the invoking process's $PWD
  # shard (bash dynamic scoping makes every _amux_atmux/_amux_session_exists
  # call inside this function honor this local override). A pre-set override
  # (test isolation) is preserved verbatim rather than recomputed: `local
  # AGENTMUX_AGENT_SOCKET; AGENTMUX_AGENT_SOCKET=$(cd "$cwd" && _amux_agent_sock)`
  # as two statements would shadow the override with an unset local BEFORE the
  # command substitution runs, so _amux_agent_sock inside it would never see the
  # override — capturing the old value on the same `local NAME=value` line avoids that.
  local AGENTMUX_AGENT_SOCKET="${AGENTMUX_AGENT_SOCKET:-}"
  [ -n "$AGENTMUX_AGENT_SOCKET" ] || AGENTMUX_AGENT_SOCKET=$(cd "$cwd" 2>/dev/null && _amux_agent_sock)
  # Default to the per-cwd basename; overridable so the auto path can honour the
  # launch's already-resolved session name (else it restores into a second session).
  [ -n "$name" ] || name=$(_amux_sanitize_session "$(basename "$cwd")")
  _amux_session_exists "$name" && exists=1
  local TAB; TAB=$(printf '\t')
  while IFS="$TAB" read -r agent rcmd; do
    [ -n "$agent" ] && [ -n "$rcmd" ] || continue
    if [ "$exists" = 0 ] && [ "$created" = 0 ]; then
      _amux_atmux new-session -d -s "$name" -c "$cwd"
      _amux_atmux set-option -t "$name" "@agent-mode" "$agent"
      _amux_atmux rename-window -t "=$name:0" "$agent"
      agentmux_set_window_style "$agent" "$name:0" "$(_amux_agent_sock)"
      _amux_atmux send-keys -t "=$name:0" "$rcmd" Enter
      win="=$name:0"; created=1
    else
      win=$(_amux_atmux new-window -t "=$name" -c "$cwd" -P -F '#{window_id}' "$rcmd")
      _amux_atmux rename-window -t "$win" "$agent"
      agentmux_set_window_style "$agent" "$win" "$(_amux_agent_sock)"
    fi
    # Explicit socket (same reason as _amux_launch_window0): this CLI process
    # has no ambient $TMUX pointing at the restored project's (possibly
    # sharded) agent socket. _amux_agent_sock honours the local
    # AGENTMUX_AGENT_SOCKET override set above, so this targets the SAME
    # shard the new-session/new-window calls above just used.
    "$AGENTMUX_SCRIPTS/session_log.sh" open "$agent" "$win" "$(_amux_agent_sock)" 2>/dev/null || true
    # RECORD THE HINT WE ARE REPLAYING. sl_dropped only offers a window whose
    # ledger row carries a resume command, and the only other writer of one is the
    # agent's working hook — which needs the user to actually submit a prompt in
    # that tab. Without this, a restored tab is unrestorable until prompted in, so
    # restore is not idempotent: restore N tabs, use one, crash, and the next
    # picker offers one. $rcmd IS that tab's resume command (it is what we just
    # launched), so the hint is authoritative here, not a guess. The label is the
    # command's last token — the resume session id — matching the key sl_dropped
    # dedups on. No fork_cmd: that is the adapter's to compose, and its working
    # hook rewrites this record with one on the first prompt.
    "$AGENTMUX_SCRIPTS/session_log.sh" resume "${rcmd##* }" "$rcmd" "" \
      "$win" "$(_amux_agent_sock)" 2>/dev/null || true
  done
  if [ "$created" = 1 ]; then
    _amux_atmux set-option -t "$name" "@autoagent" "1"
    _amux_atmux set-option -t "$name" "@amux_dir" "$cwd"
  fi
}

# _amux_restore_pick <mode>   mode ∈ auto|explicit|global
# Renders the numbered picker for a scope, reads + parses the selection, groups
# the chosen rows by cwd, and restores each project via _amux_restore_into.
#   auto     — dropped --new "$PWD"; silent when empty; no attach (caller continues launch)
#   explicit — dropped "$PWD"; attaches to $PWD's session after
#   global   — dropped --global; restores all picked; attaches to $PWD's session if present
_amux_restore_pick() {
  local mode="$1" name_override="${2:-}" TAB; TAB=$(printf '\t')
  local rows
  case "$mode" in
    auto)     rows=$("$AGENTMUX_SCRIPTS/session_log.sh" dropped --new "$PWD" 2>/dev/null) ;;
    explicit) rows=$("$AGENTMUX_SCRIPTS/session_log.sh" dropped "$PWD" 2>/dev/null) ;;
    global)   rows=$("$AGENTMUX_SCRIPTS/session_log.sh" dropped --global 2>/dev/null) ;;
  esac
  if [ -z "$rows" ]; then
    [ "$mode" = auto ] || echo "amux: no dropped tabs to restore" >&2
    return 0
  fi
  # Number + render.
  local -a R_agent=() R_cwd=() R_cmd=() R_ts=()
  local agent cwd cmd ts n=0
  local scope_word="here"; [ "$mode" = global ] && scope_word="across all projects"
  while IFS="$TAB" read -r agent cwd cmd ts; do
    [ -n "$agent" ] || continue
    n=$((n+1)); R_agent[n]="$agent"; R_cwd[n]="$cwd"; R_cmd[n]="$cmd"; R_ts[n]="$ts"
  done <<EOF
$rows
EOF
  [ "$n" -gt 0 ] || return 0
  # Group the rows by project dir for display + selection: keep dropped's order —
  # the ORIGINAL TAB ORDER, which is also the order _amux_restore_into recreates
  # the windows in — but pull each project's tabs together so its windows list as
  # one block (each project ordered by its first tab, tabs left-to-right within it).
  # So the numbered list reads like the tab bar it is about to rebuild; each row's
  # "(ago)" carries the recency the order no longer does.
  # Numbering stays 1..n contiguous, so _amux_parse_selection is unaffected — we
  # reindex the R_* arrays into grouped order, then render. gseen is a
  # newline-delimited membership set (bash 3.2: no `local -A`; newlines also
  # survive spaces in paths).
  local -a G_agent=() G_cwd=() G_cmd=() G_ts=()
  local gseen="" gc gi gj
  for ((gi=1;gi<=n;gi++)); do
    gc="${R_cwd[gi]}"
    case "$gseen" in *"
$gc
"*) continue ;; esac
    gseen="$gseen
$gc
"
    for ((gj=1;gj<=n;gj++)); do
      [ "${R_cwd[gj]}" = "$gc" ] || continue
      G_agent+=("${R_agent[gj]}"); G_cwd+=("${R_cwd[gj]}")
      G_cmd+=("${R_cmd[gj]}");     G_ts+=("${R_ts[gj]}")
    done
  done
  for ((gi=0;gi<n;gi++)); do
    R_agent[gi+1]="${G_agent[gi]}"; R_cwd[gi+1]="${G_cwd[gi]}"
    R_cmd[gi+1]="${G_cmd[gi]}";     R_ts[gi+1]="${G_ts[gi]}"
  done

  local plural=s; [ "$n" = 1 ] && plural=""
  printf 'amux: %d agent tab%s %s were dropped:\n' "$n" "$plural" "$scope_word" >&2
  # global spans projects → a project-dir header per group, tabs indented under it.
  # Single-project modes (auto/explicit) are one group, so no header is shown.
  local i disp prev_cwd="" guuid ggoal gind
  for ((i=1;i<=n;i++)); do
    if [ "$mode" = global ] && [ "${R_cwd[i]}" != "$prev_cwd" ]; then
      disp="${R_cwd[i]}"; case "$disp" in "$HOME"|"$HOME"/*) disp="~${disp#"$HOME"}" ;; esac
      printf '\n  %s\n' "$disp" >&2
      prev_cwd="${R_cwd[i]}"
    fi
    if [ "$mode" = global ]; then
      printf '    %d) %-9s → %s   (%s)\n' "$i" "${R_agent[i]}" "${R_cmd[i]}" "$(_amux_ago "${R_ts[i]}")" >&2
      gind="         "
    else
      printf '  %d) %-9s → %s   (%s)\n' "$i" "${R_agent[i]}" "${R_cmd[i]}" "$(_amux_ago "${R_ts[i]}")" >&2
      gind="       "
    fi
    # Under each row, a dimmed one-line goal ("what this session was about"),
    # re-derived from the recovered Claude session's transcript (goal.sh). The
    # last token of the resume command is the resume UUID = the transcript name.
    # Non-Claude / unresolvable rows show a muted "(no summary)" so row height
    # stays uniform (keep-empty-state-in-place, not hide).
    guuid="${R_cmd[i]##* }"
    ggoal=$("$AGENTMUX_SCRIPTS/claude/goal.sh" "$guuid" 66 2>/dev/null)
    if [ -n "$ggoal" ]; then
      printf '%s\033[2m↳ %s\033[0m\n' "$gind" "$ggoal" >&2
    else
      printf '%s\033[2m↳ (no summary)\033[0m\n' "$gind" >&2
    fi
  done
  printf '\n%s\n' '──────────────────────────────────────────────' >&2
  printf 'restore? [a = all · 1,2 = some · n = none]› ' >&2
  local reply=""; IFS= read -r reply
  local picked; picked=$(_amux_parse_selection "$n" "$reply")
  [ -n "$picked" ] || { echo "amux: nothing restored" >&2; return 0; }
  # Group picked rows by cwd, feed each project's rows to _amux_restore_into.
  # seen_cwd is a newline-delimited membership set, NOT an associative array:
  # macOS ships bash 3.2 (no `local -A`), and amux is `#!/usr/bin/env bash`, so a
  # `-A` would silently degrade to an indexed array and a path subscript would
  # hard-error. Newlines also survive spaces in paths (a space-set would not).
  local seen_cwd="" idx c
  for idx in $picked; do
    c="${R_cwd[idx]}"
    case "$seen_cwd" in *"
$c
"*) continue ;; esac
    seen_cwd="$seen_cwd
$c
"
    local j lines=""
    for j in $picked; do
      [ "${R_cwd[j]}" = "$c" ] || continue
      lines+="${R_agent[j]}${TAB}${R_cmd[j]}"$'\n'
    done
    # Honour the launch's resolved session name for the $PWD group so the auto
    # path restores into the SAME session the launch attaches, not a second one.
    local grp_name=""; [ "$c" = "$PWD" ] && grp_name="$name_override"
    printf '%s' "$lines" | _amux_restore_into "$c" "$grp_name"
    [ "$mode" = auto ] && _amux_auto_restored=1
    # Retire this cwd's dead servers from future AUTO offers now that their tabs
    # are relaunched — otherwise a manual --restore/--global (which don't mark the
    # notified gate) leaves the tab offerable, and a later bare `amux` would
    # auto-restore it AGAIN into a second window fighting the same session id.
    # `dropped --new` marks (socket|pid|cwd) for every still-dead server in $c;
    # the just-created live session is excluded, so only the dead source is marked.
    "$AGENTMUX_SCRIPTS/session_log.sh" dropped --new "$c" >/dev/null 2>&1 || true
  done
  # Attach behaviour by mode.
  if [ "$mode" != auto ]; then
    local pname; pname=$(_amux_default_session_name)   # $PWD-bound — correct here
    if _amux_session_exists "$pname"; then _amux_attach "$pname"
    else echo "amux: restored tabs in other projects; cd there and run amux to attach" >&2; fi
  fi
}

# Presence query for a single project: exit 0 if its agent session (agent socket)
# OR a lingering frame (<base>-frame on the frame socket) exists, non-zero if
# neither does. Silent — meant to back a status indicator (e.g. warden's cyan
# presence dot) on its exit code alone. The frame leg is what lets the dot stay
# lit after an agent exits while its frame wrapper is still up — the state
# `amux --kill` reaps; no separate -term check, since a frame's scratch terminal
# never outlives the frame (both die together). Default target is the current
# dir's session; an explicit arg is sanitised, and a trailing -frame/-term is
# stripped to the base (so `amux --probe foo-frame` queries project `foo`).
_amux_probe() {
  local arg base by_dir=0
  if [ $# -gt 0 ]; then arg=$(_amux_sanitize_session "$1"); else arg=$(_amux_default_session_name); by_dir=1; fi
  case "$arg" in
    *-frame) base="${arg%-frame}" ;;
    *-term)  base="${arg%-term}" ;;
    *)       base="$arg" ;;
  esac
  # CWD-derived (no explicit name → warden's call): honour the dir guard so a
  # basename collision with a different project can't light this dot.
  if [ "$by_dir" -eq 1 ]; then
    _amux_agent_session_is_mine "$base" && return 0
    _amux_frame_session_is_mine "${base}-frame" && return 0
    # No live session — but a crashed one here may still be restorable. Exit 3 means
    # "a plain `amux` launch in this dir would offer you a restore picker"; warden
    # renders it as a ghost on the presence dot. Read-only (--pending, never --new):
    # warden polls this, and a marking read would burn the once-per-(server,cwd) gate
    # so the offer would be consumed by the probe instead of by you.
    # 3 is non-zero, so every existing `if amux --probe` consumer still reads "absent".
    # Explicit-name probes skip this: they target by name, with no cwd to query with.
    if [ -n "$("$AGENTMUX_SCRIPTS/session_log.sh" dropped --pending "$PWD" 2>/dev/null)" ]; then
      return 3
    fi
    return 1
  fi
  [ -n "$(_amux_agent_socks | _amux_sock_hosting "$base")" ] && return 0
  # -L names the frame socket explicitly, so this ignores any inherited $TMUX
  # (same as _amux_atmux's own explicit -L to the agent socket).
  [ -n "$(_amux_frame_socks | _amux_sock_hosting "${base}-frame")" ]
}

# Kill ONE project completely: the agent session (agent socket) plus its paired
# <base>-frame and <base>-term. Default target is the current dir's session; an
# explicit arg is sanitised, and a trailing -frame/-term is stripped to the base.
# Kills whichever of the three exist; errors only if none do.
_amux_kill() {
  local arg base
  if [ $# -gt 0 ]; then arg=$(_amux_sanitize_session "$1"); else arg=$(_amux_default_session_name); fi
  case "$arg" in
    *-frame) base="${arg%-frame}" ;;
    *-term)  base="${arg%-term}" ;;
    *)       base="$arg" ;;
  esac
  local fsock tsock parts="" by_dir=0 own_frame=0
  [ $# -eq 0 ] && by_dir=1
  if [ "$by_dir" -eq 1 ]; then
    fsock=$(_amux_frame_sock); tsock=$(_amux_term_sock)   # CWD path: derive from $PWD
  else
    fsock=$(_amux_frame_socks | _amux_sock_hosting "${base}-frame")  # named: scan shards
    tsock=$(_amux_term_socks | _amux_sock_hosting "${base}-term")
  fi
  # CWD-derived kill (no explicit name → warden's call): only reap sessions whose
  # recorded @amux_dir is THIS dir, so a same-basename sibling project is never
  # torn down. An explicit name skips the guard (unchanged behaviour). The term
  # session carries no @amux_dir — it's paired 1:1 with the frame, so its
  # ownership follows the frame's.
  local _asock=""
  if [ "$by_dir" -eq 0 ]; then _asock=$(_amux_agent_socks | _amux_sock_hosting "$base"); fi
  if { [ "$by_dir" -eq 0 ] && [ -n "$_asock" ]; } \
     || { [ "$by_dir" -eq 1 ] && _amux_agent_session_is_mine "$base"; }; then
    # Mark this agent shard's windows deliberately closed BEFORE tearing it down.
    # The agent session is the only one on its per-project server, so kill-session
    # kills the whole server — the window-unlinked snapshot hook (which is what
    # empties the live-set sidecar on a graceful close) never runs. Without this the
    # sidecar stays populated + the server goes dead, and crash recovery offers the
    # deliberately-killed tab as if it had crashed. Query socket_path + pid on the
    # resolved agent socket, then write an empty sidecar via session_log discard.
    local _kl _kinfo _ksp _kpid TAB; TAB=$(printf '\t')
    if [ "$by_dir" -eq 0 ]; then _kl="$_asock"; else _kl=$(_amux_agent_sock); fi
    _kinfo=$(env -u TMUX tmux -L "$_kl" display-message -p "#{socket_path}${TAB}#{pid}" 2>/dev/null)
    _ksp=${_kinfo%%"$TAB"*}; _kpid=${_kinfo##*"$TAB"}
    [ -n "$_ksp" ] && [ -n "$_kpid" ] \
      && "$AGENTMUX_SCRIPTS/session_log.sh" discard "$_ksp" "$_kpid" 2>/dev/null || true
    if [ "$by_dir" -eq 0 ]; then tmux -L "$_asock" kill-session -t "=$base" 2>/dev/null
    else _amux_atmux kill-session -t "=$base" 2>/dev/null; fi
    parts="agent '$base'"
  fi
  if [ -n "$fsock" ] && { { [ "$by_dir" -eq 0 ] && tmux -L "$fsock" has-session -t "=${base}-frame" 2>/dev/null; } \
     || { [ "$by_dir" -eq 1 ] && _amux_frame_session_is_mine "${base}-frame"; }; }; then
    tmux -L "$fsock" kill-session -t "=${base}-frame" 2>/dev/null
    parts="${parts:+$parts + }frame '${base}-frame'"; own_frame=1
  fi
  if [ -n "$tsock" ] && { [ "$by_dir" -eq 0 ] || [ "$own_frame" -eq 1 ]; } \
     && tmux -L "$tsock" has-session -t "=${base}-term" 2>/dev/null; then
    tmux -L "$tsock" kill-session -t "=${base}-term" 2>/dev/null
    parts="${parts:+$parts + }terminal '${base}-term'"
  fi
  if [ -n "$parts" ]; then
    echo "killed $parts"
  else
    echo "amux: no session '$base' (try: amux --sessions)" >&2; return 1
  fi
}

# Kill EVERY agentmux project at once: every @autoagent session, plus all frames
# and scratch terminals. Destroys running agents, so it confirms first. Each
# agent socket is a per-project shard (agentmux-agent-<cksum $PWD>) exclusively
# agentmux's own, like the frame/term sockets, so all three are torn down whole
# via kill-server.
_amux_kill_all() {
  local names count fsocks have_frames=0 _fs _s
  fsocks=$(_amux_frame_socks)
  names=$(_amux_agent_session_names)
  count=$(printf '%s' "$names" | grep -c . 2>/dev/null)
  # A configured socket NAME isn't proof of a live frame (an override with no
  # server behind it must still read as "no frames") — actually query each
  # resolved socket, same as _amux_frames does.
  for _fs in $fsocks; do
    tmux -L "$_fs" list-sessions >/dev/null 2>&1 && { have_frames=1; break; }
  done
  if [ "$count" -eq 0 ] && [ "$have_frames" -eq 0 ]; then
    echo "amux: no agent sessions or frames (try: amux --sessions)" >&2; return 1
  fi
  printf 'kill %s agent session(s) + all frames/terminals? (y/N) ' "$count" >&2
  local reply; read -r reply
  case "$reply" in
    [yY]|[yY][eE][sS]) ;;
    *) echo "aborted" >&2; return 1 ;;
  esac
  # Discard each agent server's live-set sidecar before kill-server, so these
  # deliberate teardowns aren't recovered as crashes (same reasoning as _amux_kill).
  local _as _kinfo _ksp _kpid TAB; TAB=$(printf '\t')
  for _as in $(_amux_agent_socks); do
    _kinfo=$(env -u TMUX tmux -L "$_as" display-message -p "#{socket_path}${TAB}#{pid}" 2>/dev/null)
    _ksp=${_kinfo%%"$TAB"*}; _kpid=${_kinfo##*"$TAB"}
    [ -n "$_ksp" ] && [ -n "$_kpid" ] \
      && "$AGENTMUX_SCRIPTS/session_log.sh" discard "$_ksp" "$_kpid" 2>/dev/null || true
    tmux -L "$_as" kill-server 2>/dev/null
  done
  for _s in $fsocks; do tmux -L "$_s" kill-server 2>/dev/null; done
  for _s in $(_amux_term_socks); do tmux -L "$_s" kill-server 2>/dev/null; done
  echo "killed $count agent session(s) + all frames/terminals"
}

# Re-source agent.conf on every LIVE agent shard, applying config changes to
# already-running servers. tmux reads a config only when the server STARTS, so
# an edit to agent.conf (or agentmux.conf, which agent.conf sources) doesn't
# reach a running per-project agent server on its own — a fresh launch gets it
# via `-f agent.conf`, but existing servers keep whatever they loaded at start.
# Every line in the file is an idempotent `set -g`/`setw -g`/`bind`/`set-hook -g`,
# so re-sourcing a live server is safe (same reasoning as the CLAUDE.md
# status-format deploy footgun). Non-destructive, so no confirm.
#
# Agent sockets ONLY. Frame/term sockets are deliberately not touched:
# re-sourcing frame.conf would reset the per-user `[frame] prefix` that bin/amux
# applies per launch (frame.conf hard-codes C-f), clobbering it until the next
# relaunch — so frame/term config changes are picked up by relaunching the frame,
# not by --reload. terminal-features in agentmux.conf are computed at client
# attach, so those (unchanged here) apply on the next reattach; the plain
# `set -g` options this file adds take effect immediately.
# Re-publish the LAUNCH-TIME config-derived session options on one live agent
# shard, then let update_colors.sh act on them.
#
# `source-file agent.conf` alone reloads only what lives IN the tmux config. A
# field like `[notes] row` is read from amux.toml by bin/amux and published as a
# tmux OPTION, so a reload that skipped this step delivered half the feature: the
# new status-format[4] line arrived, the option and the row count did not, and
# `amux --reload` appeared to do nothing at all. Every future launch-time config
# field belongs here too, for the same reason.
#
# The dir is each session's own @amux_dir (recorded at launch), NOT $PWD —
# `--reload` reconciles every project's shard, and [notes.dirs."<path>"] can
# answer differently per project. A session with no @amux_dir (created before
# that option existed) is left alone rather than resolved against the wrong
# directory: guessing would be worse than not touching it.
#
# update_colors.sh runs ONCE per shard, not once per session: it reconciles every
# @autoagent session on the server it is pointed at, whatever session name it is
# given. It is a HOOK-path script (bare `tmux`), so it is handed the shard through
# $TMUX the same way the selftests fake hook context — an argv call, which avoids
# building a shell string around a session name that may contain spaces.
_amux_reload_config_opts() {
  local _rs=$1 _sess _dir _sp _first=""
  while IFS= read -r _sess; do
    [ -n "$_sess" ] || continue
    [ -n "$_first" ] || _first=$_sess
    # BARE session name, never the `=<name>` exact-match form used by
    # _amux_attach: `=` is attach/switch-client target syntax. show-options
    # silently returns EMPTY for `-t '=name'` (with -q) and set-option fails
    # outright ("no such session: =name"), so the `=` form here published
    # nothing at all while looking correct. Verified on tmux 3.7b. Prefix
    # ambiguity is not a risk: these names come from this server's own
    # list-sessions, so an exact match always exists and tmux prefers it.
    _dir=$(tmux -L "$_rs" show-options -qv -t "$_sess" @amux_dir 2>/dev/null)
    [ -n "$_dir" ] || continue
    _amux_note_opts "$_sess" "$_dir"
    tmux -L "$_rs" "${_AMUX_NOTE_OPTS[@]}" 2>/dev/null
  done <<EOF
$(tmux -L "$_rs" list-sessions -F '#{?@autoagent,#{session_name},}' 2>/dev/null | grep .)
EOF
  [ -n "$_first" ] || return 0
  _sp=$(tmux -L "$_rs" display-message -p '#{socket_path}' 2>/dev/null)
  [ -n "$_sp" ] || return 0
  TMUX="$_sp,0,0" sh "$AGENTMUX_SCRIPTS/update_colors.sh" "$_first" 2>/dev/null
}

_amux_reload() {
  local conf="$AGENTMUX_TMUX/agent.conf" _as ok=0 dead=0 fail=0
  if [ ! -f "$conf" ]; then
    echo "amux: $conf not found (update the install: amux --update)" >&2; return 1
  fi
  for _as in $(_amux_agent_socks); do
    # A socket file isn't proof of a live server — skip stale ones (dead servers
    # leave the socket behind), like --sessions / named --kill do.
    if ! tmux -L "$_as" list-sessions >/dev/null 2>&1; then dead=$((dead+1)); continue; fi
    if tmux -L "$_as" source-file "$conf" 2>/dev/null; then ok=$((ok+1))
    else fail=$((fail+1)); echo "amux: failed to reload $_as" >&2; fi
    _amux_reload_config_opts "$_as"
  done
  if [ "$ok" -eq 0 ] && [ "$fail" -eq 0 ]; then
    echo "amux: no live agent servers to reload"; return 0
  fi
  printf 'reloaded %s live agent server(s)' "$ok"
  [ "$dead" -gt 0 ] && printf ' (%s stale socket(s) skipped)' "$dead"
  [ "$fail" -gt 0 ] && printf ', %s failed' "$fail"
  printf '\n'
  [ "$fail" -eq 0 ]
}

# One-time notice: agents on the OLD shared default socket can't be relocated to a
# per-project shard (tmux can't move a live session between servers), so tell the user
# once to relaunch them. Production never creates on the default socket again, so legacy
# sessions only ever decrease — a single persistent marker ("notify once, ever") suffices.
_amux_legacy_notice() {
  local state marker
  state="${AGENTMUX_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agentmux}"
  marker="$state/.legacy-socket-notified"
  [ -f "$marker" ] && return 0
  # @autoagent sessions on the real default socket (no -L)?
  if env -u TMUX tmux list-sessions -F '#{?@autoagent,x,}' 2>/dev/null | grep -q x; then
    local n; n=$(env -u TMUX tmux list-sessions -F '#{?@autoagent,x,}' 2>/dev/null | grep -c x)
    echo "amux: $n agent(s) still on the old shared tmux socket — kill+relaunch them to move onto per-project sockets." >&2
    mkdir -p "$state" 2>/dev/null && : > "$marker" 2>/dev/null
  fi
}

# Ensure this project's agent session exists and is fully configured, then leave it
# for the caller to attach (in-process for a plain launch, or via the frame's
# bare-attach right pane). The interactive restore-picker runs here first, so a
# framed launch prompts in the plain terminal BEFORE the frame paints. This is the
# ONE home for the create-session logic — both the plain path and _amux_frame call
# it, so the plain path's selftests guard the frame path too.
# Args: <agent> <session>. Uses $PWD for the socket shard, dir, and config.
_amux_ensure_agent_session() {
  local agent_name="$1" name="$2"

  # Recovery picker: offer this project's dropped tabs (once per dead server per
  # cwd). TTY-guarded (reads reply on fd 0, writes list/prompt on fd 2) so an
  # automated launch never blocks on read. If the user restores tabs, the session
  # now exists → the create branch below is skipped (window-0-replace falls out).
  local _amux_auto_restored=0
  if [ -t 0 ] && [ -t 2 ]; then
    _amux_restore_pick auto "$name"
  fi

  # Exact-match check (see _amux_session_exists): without it, `name` would
  # prefix-match a longer existing session and we'd attach to the wrong one.
  if ! _amux_session_exists "$name"; then
    _amux_atmux new-session -d -s "$name" -c "$PWD"
    _amux_atmux set-option -t "$name" "@agent-mode" "$agent_name"
    _amux_launch_window0 "$name" "$agent_name"
  else
    # After an auto-restore, window 0 runs a RESTORED agent and _amux_restore_into
    # already set @agent-mode to it; don't clobber it with the launch default.
    [ "$_amux_auto_restored" = 1 ] || _amux_atmux set-option -t "$name" "@agent-mode" "$agent_name"
  fi

  # Emit ALL session options in ONE chained tmux invocation (';'-separated) — each
  # separate call is an exec + socket round-trip. ORDERING IS LOAD-BEARING:
  # @autoagent and @l1reserved must be set BEFORE the caller attaches (update_colors.sh
  # only paints @autoagent sessions; the reservation must be published pre-attach).
  local _prefix _pin_slot _reserved
  _prefix=$(_amux_prefix)
  _pin_slot=$(_amux_bar_pin_slot "$PWD")
  _reserved=$(_amux_bar_reserved)
  local -a _opts=(set-option -t "$name" "@autoagent" "1"
                  ';' set-option -t "$name" "@amux_dir" "$PWD")
  [ -n "$_prefix" ]   && _opts+=(';' set-option -t "$name" prefix "$_prefix")
  [ -n "$_pin_slot" ] && _opts+=(';' set-option -t "$name" @l1idx "$_pin_slot")
  # Must be in THIS pre-attach batch: update_colors.sh reads @amux_note_row on the
  # client-attached hook, so a later write would be one attach too late.
  #
  # SYMMETRIC, and that is load-bearing. This whole function runs on EVERY `amux`
  # for the project, not only at creation, so an add-only emit meant `row = true`
  # took effect on a mere re-attach while `row = false` could never turn a running
  # session's row back off — stuck until `amux --kill`. `-u` on a session option
  # that was never set exits 0 (verified, tmux 3.7b), so the else branch is safe on
  # a session that never carried either option and cannot abort the rest of the
  # ';'-chained batch. @amux_note4 is the launch-time hint default — see
  # _amux_note_hint4 for why row 4 needs one at all, and why a failed lookup
  # (empty output) must skip this set rather than publish an explicit "".
  # Shared with `--reload` — see _amux_note_opts.
  _amux_note_opts "$name" "$PWD"
  _opts+=(';' "${_AMUX_NOTE_OPTS[@]}")
  _opts+=(';' set-option -g @l1reserved "$_reserved")
  _amux_atmux "${_opts[@]}"
}

# amux [(-<flag> | <agent_name>)] [session_name]
#
# Creates or attaches a tmux session managed by agentmux.
# Agent selection (in precedence order):
#   -<flag>        flag defined in amux.toml (e.g. -w for flag="w")
#   <agent_name>   exact agent name (e.g. "work")
#   (none)         agent whose `dirs` matches $PWD; else first agent in config
# Remaining arg (if any) is the session name; defaults to current dir basename.
amux() {
  local agent_name="" session_arg="" no_frame=""

  if [ $# -gt 0 ]; then
    case "$1" in
      --version)
        local v; v=$(cat "$HOME/.agentmux/VERSION" 2>/dev/null | tr -d '[:space:]')
        echo "agentmux ${v:-unknown}"
        return 0
        ;;
      --update)
        _amux_update "$HOME/.agentmux"
        return $?
        ;;
      --colours|--colors)
        shift
        _amux_colours "$@"
        return $?
        ;;
      --frame)
        shift
        _amux_frame "$@"
        return $?
        ;;
      --no-frame)
        # Opt out of [frame] default for this run; fall through to a plain launch.
        no_frame=1
        shift
        ;;
      --frames)
        _amux_frames
        return $?
        ;;
      --frame-kill)
        shift
        _amux_frame_kill "$@"
        return $?
        ;;
      --frame-kill-all)
        _amux_frame_kill_all
        return $?
        ;;
      --sessions)
        _amux_sessions
        return $?
        ;;
      --restore)
        shift
        if [ "${1:-}" = "--global" ]; then _amux_restore_pick global; else _amux_restore_pick explicit; fi
        return $?
        ;;
      --probe)
        shift
        _amux_probe "$@"
        return $?
        ;;
      --kill)
        shift
        _amux_kill "$@"
        return $?
        ;;
      --kill-all)
        _amux_kill_all
        return $?
        ;;
      --reload)
        _amux_reload
        return $?
        ;;
      attach)
        shift
        if [ $# -eq 0 ]; then echo "amux: usage: amux attach <name>" >&2; return 1; fi
        _amux_attach_by_name "$1"
        return $?
        ;;
      --complete)
        # Hidden: emit agent names + -flags for shell completion backends.
        agentmux_list_agent_completions
        return 0
        ;;
      --complete-sessions)
        # Hidden: emit live agentmux session names for --kill/--frame-kill completion.
        _amux_agent_session_names
        return 0
        ;;
      --help)
        cat <<'EOF'
amux [(-<flag> | <agent_name>)] [session_name]
  Creates or attaches a tmux session managed by agentmux.

  -<flag>        agent matching `flag` in amux.toml (e.g. -w for flag="w")
  <agent_name>   agent by name (e.g. "work")
  (none)         agent whose `dirs` matches the current directory;
                 falls back to the first agent in amux.toml
  session_name   defaults to basename of $PWD (chars outside A-Za-z0-9_- → _)

  --sessions     list agentmux agent sessions (name, agent, windows, attach state)
  --restore      pick dropped agent tabs (from a crash) to relaunch; --global for all projects
  --probe        exit 0 if a session [session] (agent or frame) exists (default: current dir); silent.
                 With no explicit session: exit 3 if absent but a crashed session here is
                 restorable (a plain `amux` launch would offer the restore picker); else exit 1.
  --kill         kill an agent session [session] + its frame/term (default: current dir)
  --kill-all     kill ALL agent sessions + all frames/terminals (asks first)
  --reload       re-source agent.conf on every running agent server (apply config
                 changes without relaunching; a fresh launch picks them up on its own)
  attach <name>  attach to a running agent session by name (from any directory)
  --update       update to the latest agentmux (git pull)
  --colours      preview the colour palette (grid|pick subcommands)
  --frame        open a side terminal (left) beside amux (right), nested tmux
  --no-frame     force a plain launch (opt out of [frame] default = true)
  --frames       list active frames (they live on a separate tmux socket)
  --frame-kill   kill a frame [session] (default: current dir); agent keeps running
  --frame-kill-all     kill ALL frames + scratch terminals at once; agents keep running
  --version      print version
  --help         this help
EOF
        return 0
        ;;
    esac
  fi

  # One-time notice for agents still stranded on the old shared default socket
  # (see _amux_legacy_notice). Placed after every case arm's `return` above, so
  # it's unreachable from --probe/--sessions/--complete*/etc — only a real
  # launch (plain or [frame] default=true) falls through to here.
  _amux_legacy_notice

  # [frame] default = true makes a bare amux open a frame, as if --frame were
  # passed. Skipped when --no-frame was given, or when already inside tmux and
  # [frame] allow_nested isn't set (--frame can't nest there — fall through to a
  # normal in-tmux launch instead).
  if [ -z "$no_frame" ] && { [ -z "${TMUX:-}" ] || [ -n "$(_amux_frame_allow_nested)" ]; } && [ -n "$(_amux_frame_default)" ]; then
    _amux_frame "$@"
    return $?
  fi

  # Plain (non-frame) launch: warm the caches in parent context, same reason as
  # _amux_frame — the launch below resolves the agent socket and reads config fields
  # through many $()-subshells that would otherwise each re-fork cksum/stat/cat.
  _amux_warm_launch_caches

  local _amux_target
  _amux_target=$(_amux_resolve_target "$@") || return 1
  agent_name=$(printf '%s' "$_amux_target" | sed -n 1p)
  session_arg=$(printf '%s' "$_amux_target" | sed -n 2p)

  # Opt-in daily check for a newer agentmux (self-gates on [update] check;
  # notice is instant, the network refresh is backgrounded — never blocks launch).
  [ -x "$AGENTMUX_SCRIPTS/version_check.sh" ] && "$AGENTMUX_SCRIPTS/version_check.sh" || true

  _amux_ensure_agent_session "$agent_name" "$session_arg"
  _amux_attach "$session_arg"
}

# Self-test: AMUX_SELFTEST=1 bash bin/amux
if [ "${AMUX_SELFTEST:-}" = "1" ]; then
  _selftest_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  AGENTMUX_CONFIG="$_selftest_dir/../config/amux.toml.example"
  _amux_json_cache=""
  # Isolate the disk cache so synthetic configs don't collide with real or
  # each other (same-second mtime → same cache key on fast machines).
  _selftest_cache=$(mktemp -d); export XDG_CACHE_HOME="$_selftest_cache"
  # Confine EVERY tmux server this selftest spawns to one throwaway TMUX_TMPDIR,
  # nuked wholesale on exit. tmux's kill-server stops the server PROCESS but never
  # unlinks the socket FILE (macOS leaves it on disk); since our socket names embed
  # $$, each run would otherwise strand fresh orphan files in the user's shared
  # /tmp/tmux-<uid>/ dir, accumulating unbounded across runs. A dedicated short
  # TMUX_TMPDIR (short to stay under the AF_UNIX 104-char socket-path limit)
  # isolates them here, and the EXIT trap removes the dir on ANY exit path — pass,
  # fail, or early exit. Every block still calls kill-server: that ends the server
  # process promptly; the trap only reaps the files it leaves behind. This is the
  # single isolation point — individual blocks must NOT set their own TMUX_TMPDIR.
  _st_tmpdir="/tmp/amuxtest-$$"; mkdir -p "$_st_tmpdir"
  export TMUX_TMPDIR="$_st_tmpdir"
  trap 'rm -rf "$_st_tmpdir" "$_selftest_cache"' EXIT
  pass=0; fail=0
  _assert() {
    local desc="$1" expected="$2" actual="$3"
    if [ "$actual" = "$expected" ]; then
      echo "PASS: $desc"; pass=$((pass+1))
    else
      echo "FAIL: $desc — expected '$expected' got '$actual'"; fail=$((fail+1))
    fi
  }

  # --complete emits agent names and -flags (newline-separated).
  completions=$(amux --complete)
  _assert "complete has work"  "work" "$(printf '%s\n' "$completions" | grep '^work$')"
  _assert "complete has -w"    "-w"   "$(printf '%s\n' "$completions" | grep '^-w$')"
  _assert "complete has ollama" "ollama" "$(printf '%s\n' "$completions" | grep '^ollama$')"

  # --help prints usage and does NOT contain a dangling "Related:" line or -h.
  help=$(amux --help)
  case "$help" in *"amux [(-<flag>"*) _got="usage" ;; *) _got="missing" ;; esac
  _assert "help shows usage" "usage" "$_got"
  case "$help" in *"Related:"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help no dangling Related" "absent" "$_got"
  case "$help" in *"-h, --help"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --help only" "absent" "$_got"

  # --version reads ~/.agentmux/VERSION (or 'unknown'); just assert prefix.
  ver=$(amux --version)
  case "$ver" in "agentmux "*) _got="ok" ;; *) _got="bad" ;; esac
  _assert "version prefix" "ok" "$_got"

  # --help advertises --update.
  case "$help" in *"--update"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --update" "present" "$_got"

  # --help advertises --colours.
  case "$help" in *"--colours"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --colours" "present" "$_got"

  # --help advertises --frame.
  case "$help" in *"--frame"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --frame" "present" "$_got"

  # --help advertises --no-frame.
  case "$help" in *"--no-frame"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --no-frame" "present" "$_got"

  # _amux_parse_selection tests
  _assert "parse all"        "1 2 3" "$(_amux_parse_selection 3 a | tr -s ' ' | sed 's/ $//')"
  _assert "parse all word"   "1 2 3" "$(_amux_parse_selection 3 all | tr -s ' ' | sed 's/ $//')"
  _assert "parse none empty" ""      "$(_amux_parse_selection 3 '' | tr -d ' ')"
  _assert "parse none n"     ""      "$(_amux_parse_selection 3 n | tr -d ' ')"
  _assert "parse subset"     "1 3"   "$(_amux_parse_selection 3 '1,3' | tr -s ' ' | sed 's/ $//')"
  _assert "parse spaces"     "2 3"   "$(_amux_parse_selection 3 '2 3' | tr -s ' ' | sed 's/ $//')"
  _assert "parse dedup"      "2"     "$(_amux_parse_selection 3 '2,2' | tr -s ' ' | sed 's/ $//')"
  _assert "parse out-of-range drops" "1" "$(_amux_parse_selection 3 '1,9' | tr -s ' ' | sed 's/ $//')"
  _assert "parse junk drops" ""      "$(_amux_parse_selection 3 'x,y' | tr -d ' ')"
  _assert "parse normalizes zero-pad" "8"   "$(_amux_parse_selection 10 '08' | tr -s ' ' | sed 's/ $//')"
  _assert "parse dedups 8 and 08"     "8"   "$(_amux_parse_selection 10 '8,08' | tr -s ' ' | sed 's/ $//')"

  # Guard: no bash-4-only associative arrays — macOS ships bash 3.2 and amux is
  # `#!/usr/bin/env bash`, so `local -A`/`declare -A` would break on the stock shell.
  _assert "no bash-4 assoc arrays" "0" "$(grep -cE '^[[:space:]]*(local|declare) -A' "${BASH_SOURCE[0]}")"

  # _amux_ago tests
  _now=$(date +%s)
  _assert "ago seconds" "just now" "$(_amux_ago $((_now - 5)))"
  _assert "ago minutes" "3m ago"   "$(_amux_ago $((_now - 180)))"
  _assert "ago hours"   "2h ago"   "$(_amux_ago $((_now - 7200)))"
  _assert "ago days"    "1d ago"   "$(_amux_ago $((_now - 90000)))"

  # --frame refuses to run inside tmux (guard returns 1 before any tmux call)
  # unless [frame] allow_nested is set. The example config sets none, so it's off.
  _fout=$(TMUX="/tmp/fake,1,0" _amux_frame work test 2>&1); _frc=$?
  case "$_fout" in *"must be run from a plain terminal"*) _got=ok ;; *) _got="bad:$_fout" ;; esac
  _assert "frame guard message" "ok" "$_got"
  _assert "frame guard exit"    "1"  "$_frc"
  # [frame] allow_nested = true lifts the guard: _amux_frame proceeds past it (we
  # point it at a bogus config dir so it fails on the missing frame.conf, not the
  # tmux guard — proving the guard no longer fired).
  _anw=$(mktemp /tmp/amux-nest-XXXXXX.toml) || exit 1
  printf '[frame]\nallow_nested = true\n[[agents]]\nname="a"\ncmd="x"\n' > "$_anw"
  _fout=$(TMUX="/tmp/fake,1,0" AGENTMUX_CONFIG="$_anw" _amux_json_cache="" \
          AGENTMUX_TMUX="/tmp/amux-no-such-tmux-dir" _amux_frame a test 2>&1)
  case "$_fout" in
    *"must be run from a plain terminal"*) _got="guard-still-fired" ;;
    *"frame config not found"*)            _got=ok ;;
    *)                                     _got="bad:$_fout" ;;
  esac
  _assert "frame allow_nested lifts guard" "ok" "$_got"
  rm -f "$_anw"

  # _amux_frame_right_cmd: a bare tmux attach on the agent socket (the parent already
  # created + configured the session, so no second amux launch and no -f needed).
  # No `amux`/`--no-frame` token — guards against regressing to a second full launch.
  _rc=$(_amux_frame_right_cmd agentmux-agent-123 proj)
  _assert "frame right_cmd shape" "env -u TMUX tmux -L 'agentmux-agent-123' attach-session -t '=proj'" "$_rc"
  case "$_rc" in *"--no-frame"*|*"$AGENTMUX_BIN"*) _got=regressed ;; *) _got=ok ;; esac
  _assert "frame right_cmd has no second amux launch" "ok" "$_got"

  # _amux_frame_left_cmd: plain attach to the dedicated term socket (trailing
  # `-c <PWD>` varies, so assert the stable prefix).
  _lc=$(_amux_frame_left_cmd agentmux-term /c/term.conf proj-term)
  case "$_lc" in "env -u TMUX tmux -L 'agentmux-term' -f '/c/term.conf' new-session -A -s 'proj-term' -c '"*) _got=ok ;; *) _got="bad:$_lc" ;; esac
  _assert "frame left_cmd shape" "ok" "$_got"

  # --help advertises the frame management commands.
  case "$help" in *"--frames"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --frames" "present" "$_got"
  case "$help" in *"--frame-kill"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --frame-kill" "present" "$_got"

  # --- socket resolvers ---
  _rf_save="${AGENTMUX_FRAME_SOCKET:-}"; _rt_save="${AGENTMUX_TERM_SOCKET:-}"
  unset AGENTMUX_FRAME_SOCKET AGENTMUX_TERM_SOCKET
  ( cd / && case "$(_amux_frame_sock)" in agentmux-frame-[0-9]*) exit 0 ;; *) exit 1 ;; esac ) \
    && _got=ok || _got=bad
  _assert "frame_sock shards when unset" "ok" "$_got"
  ( cd / && case "$(_amux_term_sock)" in agentmux-term-[0-9]*) exit 0 ;; *) exit 1 ;; esac ) \
    && _got=ok || _got=bad
  _assert "term_sock shards when unset" "ok" "$_got"
  _a=$(cd / && _amux_frame_sock); _b=$(cd /tmp && _amux_frame_sock)
  [ "$_a" != "$_b" ] && _got=differ || _got=same
  _assert "distinct \$PWD -> distinct socket" "differ" "$_got"
  # Hash memoization (the cold-start spawn fix): a warmed cache for THIS $PWD is
  # returned verbatim without re-forking cksum; a different $PWD misses and recomputes
  # (cd-safe, so the restore path that cd's to another project still gets its own hash).
  _amux_pwd_hash_key="$PWD"; _amux_pwd_hash_val="SENTINELHASH"
  _assert "pwd_hash returns memoized value on cache hit" "SENTINELHASH" "$(_amux_pwd_hash)"
  case "$(cd / && _amux_pwd_hash)" in
    SENTINELHASH) _got=leaked ;; [0-9]*) _got=recomputed ;; *) _got=bad ;;
  esac
  _assert "pwd_hash recomputes when \$PWD != cached key" "recomputed" "$_got"
  unset _amux_pwd_hash_key _amux_pwd_hash_val
  AGENTMUX_FRAME_SOCKET="verbatim-xyz"
  _assert "frame_sock honours override verbatim" "verbatim-xyz" "$(_amux_frame_sock)"
  _assert "frame_socks honours override verbatim" "verbatim-xyz" "$(_amux_frame_socks)"
  unset AGENTMUX_FRAME_SOCKET
  # restore whatever the surrounding selftest expects
  [ -n "$_rf_save" ] && AGENTMUX_FRAME_SOCKET="$_rf_save"
  [ -n "$_rt_save" ] && AGENTMUX_TERM_SOCKET="$_rt_save"

  # --- agent socket resolvers ---
  _ra_save="${AGENTMUX_AGENT_SOCKET:-}"; unset AGENTMUX_AGENT_SOCKET
  ( cd / && case "$(_amux_agent_sock)" in agentmux-agent-[0-9]*) exit 0 ;; *) exit 1 ;; esac ) \
    && _got=ok || _got=bad
  _assert "agent_sock shards when unset" "ok" "$_got"
  _aa=$(cd / && _amux_agent_sock); _ab=$(cd /tmp && _amux_agent_sock)
  [ "$_aa" != "$_ab" ] && _got=differ || _got=same
  _assert "agent_sock distinct \$PWD" "differ" "$_got"
  AGENTMUX_AGENT_SOCKET="agent-verbatim-xyz"
  _assert "agent_sock override verbatim"  "agent-verbatim-xyz" "$(_amux_agent_sock)"
  _assert "agent_socks override verbatim" "agent-verbatim-xyz" "$(_amux_agent_socks)"
  unset AGENTMUX_AGENT_SOCKET
  [ -n "$_ra_save" ] && AGENTMUX_AGENT_SOCKET="$_ra_save"

  # --- name-targeted scan finds a sharded frame socket. Needs a real tmux; skip
  #     cleanly if absent (same pattern as the other tmux-gated cases below).
  if command -v tmux >/dev/null 2>&1; then
    _rf_save2="${AGENTMUX_FRAME_SOCKET:-}"; unset AGENTMUX_FRAME_SOCKET
    _scan_sock="agentmux-frame-99999999"    # matches the agentmux-frame* glob
    tmux -L "$_scan_sock" new-session -d -s "scanme-frame" 2>/dev/null
    _assert "sock_hosting finds sharded session" "$_scan_sock" \
      "$(_amux_frame_socks | _amux_sock_hosting scanme-frame)"
    tmux -L "$_scan_sock" kill-server 2>/dev/null
    [ -n "$_rf_save2" ] && AGENTMUX_FRAME_SOCKET="$_rf_save2"
  else
    echo "SKIP: sharded socket scan test (tmux not found)"
  fi

  # --- name-targeted agent commands span shards: _amux_agent_session_names and
  #     _amux_sock_hosting must see sessions on EVERY agentmux-agent-<n> socket,
  #     not just the caller's own $PWD shard. Needs a real tmux; skip cleanly if
  #     absent. Servers land in the selftest-wide throwaway TMUX_TMPDIR (bin/amux
  #     is bash-3.2 clean; no associative arrays here either).
  if command -v tmux >/dev/null 2>&1; then
    _ms_save="${AGENTMUX_AGENT_SOCKET:-}"; unset AGENTMUX_AGENT_SOCKET
    tmux -L agentmux-agent-101 new-session -d -s projX; tmux -L agentmux-agent-101 set -t projX @autoagent 1
    tmux -L agentmux-agent-202 new-session -d -s projY; tmux -L agentmux-agent-202 set -t projY @autoagent 1
    _names=$(_amux_agent_session_names | sort | tr '\n' ' ')
    _assert "session_names spans shards" "projX projY " "$_names"
    _assert "sock_hosting finds projY" "agentmux-agent-202" "$(_amux_agent_socks | _amux_sock_hosting projY)"
    tmux -L agentmux-agent-101 kill-server 2>/dev/null; tmux -L agentmux-agent-202 kill-server 2>/dev/null
    [ -n "$_ms_save" ] && AGENTMUX_AGENT_SOCKET="$_ms_save"
  else
    echo "SKIP: multi-shard agent commands test (tmux not found)"
  fi

  # --- amux attach <name> resolves the hosting shard (socket lookup only — the
  #     actual attach-session needs a TTY, so that part isn't exercised here).
  #     Needs a real tmux; skip cleanly if absent. Servers land in the
  #     selftest-wide throwaway TMUX_TMPDIR.
  if command -v tmux >/dev/null 2>&1; then
    _an_save="${AGENTMUX_AGENT_SOCKET:-}"; unset AGENTMUX_AGENT_SOCKET
    tmux -L agentmux-agent-303 new-session -d -s projZ; tmux -L agentmux-agent-303 set -t projZ @autoagent 1
    _assert "attach resolves shard" "agentmux-agent-303" "$(_amux_agent_socks | _amux_sock_hosting projZ)"
    # missing name → nonzero + message
    _an_out=$(_amux_attach_by_name __nope__ 2>&1); _an_rc=$?
    _assert "attach missing exit" "1" "$_an_rc"
    tmux -L agentmux-agent-303 kill-server 2>/dev/null
    [ -n "$_an_save" ] && AGENTMUX_AGENT_SOCKET="$_an_save"
  else
    echo "SKIP: attach resolution test (tmux not found)"
  fi

  # --- _amux_atmux lands on the $PWD agent shard (production path, override unset).
  #     Needs a real tmux; skip cleanly if absent (same pattern as neighbouring cases).
  if command -v tmux >/dev/null 2>&1; then
    _at_save="${AGENTMUX_AGENT_SOCKET:-}"; unset AGENTMUX_AGENT_SOCKET
    ( cd /tmp && _amux_atmux new-session -d -s atmuxprobe 2>/dev/null )
    _at_expect="agentmux-agent-$(cd /tmp && _amux_pwd_hash)"
    if [ -S "$TMUX_TMPDIR/tmux-$(id -u)/$_at_expect" ]; then _got=onshard; else _got=missing; fi
    _assert "atmux creates on \$PWD agent shard" "onshard" "$_got"
    # The startup-regression fix: a cold agent server must be born from agent.conf
    # (-f), NOT fall through to ~/.tmux.conf + TPM. Proof it applied: agent.conf's
    # interactive defaults are set (escape-time 0), and TPM's plugin-install key is
    # NOT bound (TPM never ran on this server). Both target the socket _amux_atmux made.
    _assert "atmux server got agent.conf (escape-time 0)" "0" \
      "$(tmux -L "$_at_expect" show -sv escape-time 2>/dev/null)"
    _assert "atmux server did not run TPM" "0" \
      "$(tmux -L "$_at_expect" list-keys 2>/dev/null | grep -c install_plugins)"
    tmux -L "$_at_expect" kill-server 2>/dev/null
    [ -n "$_at_save" ] && AGENTMUX_AGENT_SOCKET="$_at_save"
  else
    echo "SKIP: atmux \$PWD shard test (tmux not found)"
  fi

  # --- User overlays: each role's socket sources ONLY its own overlay, LAST (so it
  #     overrides amux's defaults), and `amux --reload` re-applies the AGENT one live.
  #     AGENTMUX_USER_DIR redirects the overlay dir (default ~/.agentmux) at a throwaway
  #     copy, so this reads test files, never the user's real ~/.agentmux/user.*.tmux.conf.
  #     All three role files exist in the dir on purpose: the cross-leak guard proves a
  #     server picks up ONLY its own (the bug the per-role split fixed). @overlay_role's
  #     value is that proof — it's set (sourced) AND carries the role's own name (no leak).
  if command -v tmux >/dev/null 2>&1; then
    _ovl="$_selftest_cache/overlays"; mkdir -p "$_ovl"
    printf 'set -g @overlay_role agent\nset -g history-limit 13579\n' > "$_ovl/user.agent.tmux.conf"
    printf 'set -g @overlay_role frame\n' > "$_ovl/user.frame.tmux.conf"
    printf 'set -g @overlay_role term\n'  > "$_ovl/user.term.tmux.conf"
    export AGENTMUX_USER_DIR="$_ovl"

    # AGENT socket via the production launch path (_amux_atmux -f agent.conf).
    _ov_save="${AGENTMUX_AGENT_SOCKET:-}"; AGENTMUX_AGENT_SOCKET="amux-selftest-ovla-$$"
    _amux_atmux new-session -d -s ovlprobe 2>/dev/null
    _assert "agent overlay sourced" "agent" \
      "$(tmux -L "$AGENTMUX_AGENT_SOCKET" show -gv @overlay_role 2>/dev/null)"
    # Sourced LAST → overrides agent.conf's own `history-limit 50000`.
    _assert "agent overlay wins over amux default" "13579" \
      "$(tmux -L "$AGENTMUX_AGENT_SOCKET" show -gv history-limit 2>/dev/null)"
    # `amux --reload` re-sources it: bump the file, reload, see the new value. The server
    # froze AGENTMUX_USER_DIR=$_ovl at start, so reload re-reads the same dir regardless
    # of the client env (tmux expands source-file vars from the server's environment).
    printf 'set -g @overlay_role agent-reloaded\n' > "$_ovl/user.agent.tmux.conf"
    amux --reload >/dev/null 2>&1
    _assert "agent overlay re-sourced by --reload" "agent-reloaded" \
      "$(tmux -L "$AGENTMUX_AGENT_SOCKET" show -gv @overlay_role 2>/dev/null)"
    tmux -L "$AGENTMUX_AGENT_SOCKET" kill-server 2>/dev/null
    if [ -n "$_ov_save" ]; then AGENTMUX_AGENT_SOCKET="$_ov_save"; else unset AGENTMUX_AGENT_SOCKET; fi

    # FRAME socket (raw -f frame.conf) sources ONLY user.frame.tmux.conf — no agent/term leak.
    env -u TMUX tmux -L "amux-selftest-ovlf-$$" -f "$AGENTMUX_TMUX/frame.conf" new-session -d 2>/dev/null
    _assert "frame overlay sourced, no cross-leak" "frame" \
      "$(tmux -L "amux-selftest-ovlf-$$" show -gv @overlay_role 2>/dev/null)"
    tmux -L "amux-selftest-ovlf-$$" kill-server 2>/dev/null

    # TERM socket (raw -f term.conf) sources ONLY user.term.tmux.conf.
    env -u TMUX tmux -L "amux-selftest-ovlt-$$" -f "$AGENTMUX_TMUX/term.conf" new-session -d 2>/dev/null
    _assert "term overlay sourced, no cross-leak" "term" \
      "$(tmux -L "amux-selftest-ovlt-$$" show -gv @overlay_role 2>/dev/null)"
    tmux -L "amux-selftest-ovlt-$$" kill-server 2>/dev/null

    # Absent overlay = silent no-op: a dir with no role file leaves amux's defaults intact.
    _ovle="$_selftest_cache/overlays-empty"; mkdir -p "$_ovle"; AGENTMUX_USER_DIR="$_ovle"
    _ov_save2="${AGENTMUX_AGENT_SOCKET:-}"; AGENTMUX_AGENT_SOCKET="amux-selftest-ovle-$$"
    _amux_atmux new-session -d -s ovleprobe 2>/dev/null
    _assert "absent overlay is a no-op (marker unset)" "" \
      "$(tmux -L "$AGENTMUX_AGENT_SOCKET" show -gv @overlay_role 2>/dev/null)"
    _assert "absent overlay keeps amux default (history 50000)" "50000" \
      "$(tmux -L "$AGENTMUX_AGENT_SOCKET" show -gv history-limit 2>/dev/null)"
    tmux -L "$AGENTMUX_AGENT_SOCKET" kill-server 2>/dev/null
    if [ -n "$_ov_save2" ]; then AGENTMUX_AGENT_SOCKET="$_ov_save2"; else unset AGENTMUX_AGENT_SOCKET; fi
    unset AGENTMUX_USER_DIR
  else
    echo "SKIP: user overlay tests (tmux not found)"
  fi

  # --frames / --frame-kill against an isolated empty socket (no real frames touched).
  AGENTMUX_FRAME_SOCKET="amux-selftest-$$"
  _assert "frames empty" "amux: no active frames" "$(amux --frames 2>/dev/null)"
  _fk=$(amux --frame-kill __nope__ 2>&1); _fkrc=$?
  case "$_fk" in *"no frame '__nope__-frame'"*) _got=ok ;; *) _got="bad:$_fk" ;; esac
  _assert "frame-kill missing msg"  "ok" "$_got"
  _assert "frame-kill missing exit" "1"  "$_fkrc"
  # --frame-kill explicit arg sanitises . and : (matches how the frame is named).
  _fk=$(amux --frame-kill 'a.b:c' 2>&1)
  case "$_fk" in *"no frame 'a_b_c-frame'"*) _got=ok ;; *) _got="bad:$_fk" ;; esac
  _assert "frame-kill sanitises arg" "ok" "$_got"
  # --frame-kill no-arg default also sanitises the PWD basename's colon (the bug:
  # the default path used to skip : so it computed a name the frame never had).
  _ckdir="$_selftest_cache/has:colon"; mkdir -p "$_ckdir"
  _fk=$(cd "$_ckdir" && amux --frame-kill 2>&1)
  case "$_fk" in *"no frame 'has_colon-frame'"*) _got=ok ;; *) _got="bad:$_fk" ;; esac
  _assert "frame-kill default sanitises colon" "ok" "$_got"
  # --frame-kill-all with nothing live aborts cleanly (no false success from a
  # configured-but-dead socket name).
  _fka=$(amux --frame-kill-all 2>&1); _fkarc=$?
  case "$_fka" in *"no active frames (try: amux --frames)"*) _got=ok ;; *) _got="bad:$_fka" ;; esac
  _assert "frame-kill-all empty msg"  "ok" "$_got"
  _assert "frame-kill-all empty exit" "1"  "$_fkarc"

  # --help advertises the agent-session lifecycle commands + the renamed kill-all.
  case "$help" in *"--sessions"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --sessions" "present" "$_got"
  case "$help" in *"--restore"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --restore" "present" "$_got"
  case "$help" in *"--log"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help no longer advertises --log" "absent" "$_got"
  case "$help" in *"--kill "*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --kill" "present" "$_got"
  case "$help" in *"--kill-all"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --kill-all" "present" "$_got"
  case "$help" in *"--reload"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --reload" "present" "$_got"
  case "$help" in *"--frame-kill-all"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --frame-kill-all" "present" "$_got"
  # The old name is gone (renamed, no alias).
  case "$help" in *"--frame-server-kill"*) _got=present ;; *) _got=absent ;; esac
  _assert "help drops --frame-server-kill" "absent" "$_got"

  # Agent-session commands against ISOLATED empty sockets (no real sessions touched).
  AGENTMUX_AGENT_SOCKET="amux-selftest-agent-$$"
  AGENTMUX_TERM_SOCKET="amux-selftest-term-$$"
  _assert "sessions empty"          "amux: no agent sessions" "$(amux --sessions 2>/dev/null)"
  _assert "complete-sessions empty" ""                        "$(amux --complete-sessions 2>/dev/null)"
  _k=$(amux --kill __nope__ 2>&1); _krc=$?
  case "$_k" in *"no session '__nope__'"*) _got=ok ;; *) _got="bad:$_k" ;; esac
  _assert "kill missing msg"  "ok" "$_got"
  _assert "kill missing exit" "1"  "$_krc"
  # --kill sanitises . and : the same way sessions are named.
  _k=$(amux --kill 'a.b:c' 2>&1)
  case "$_k" in *"no session 'a_b_c'"*) _got=ok ;; *) _got="bad:$_k" ;; esac
  _assert "kill sanitises arg" "ok" "$_got"
  # --kill strips a -frame/-term suffix to the base session name.
  _k=$(amux --kill 'proj-frame' 2>&1)
  case "$_k" in *"no session 'proj'"*) _got=ok ;; *) _got="bad:$_k" ;; esac
  _assert "kill strips -frame suffix" "ok" "$_got"
  # --kill-all with nothing present aborts cleanly (no prompt, exit 1); </dev/null
  # guards against the confirm read ever blocking.
  _ka=$(amux --kill-all </dev/null 2>&1); _karc=$?
  case "$_ka" in *"no agent sessions"*) _got=ok ;; *) _got="bad:$_ka" ;; esac
  _assert "kill-all empty msg"  "ok" "$_got"
  _assert "kill-all empty exit" "1"  "$_karc"
  # --reload against the isolated (dead) socket: the stale socket is skipped and
  # there's nothing live to re-source, so it reports cleanly and exits 0.
  _rl=$(amux --reload 2>&1); _rlrc=$?
  case "$_rl" in *"no live agent servers"*) _got=ok ;; *) _got="bad:$_rl" ;; esac
  _assert "reload no-live msg"  "ok" "$_got"
  _assert "reload no-live exit" "0"  "$_rlrc"

  # --colours render lists curated names; the line helper emits a paste field.
  cols=$(amux --colours 2>/dev/null)
  case "$cols" in *teal*) _got=ok ;; *) _got=bad ;; esac
  _assert "colours render has teal" "ok" "$_got"
  line=$(_amux_colour_line work teal)
  case "$line" in *'colour = "teal"'*) _got=ok ;; *) _got=bad ;; esac
  _assert "colour line paste field" "ok" "$_got"

  # --colours preview also lists the session bar palette (so pins are discoverable).
  # 'amber' is bar-only (not a tab name), so this genuinely needs the bar render.
  case "$cols" in *"Session bar colours"*amber*) _got=present ;; *) _got=absent ;; esac
  _assert "colours preview lists bar names" "present" "$_got"

  # _amux_shquote wraps and escapes embedded single quotes.
  _assert "shquote plain"  "'work'"      "$(_amux_shquote work)"
  _assert "shquote squote" "'a'\\''b'"   "$(_amux_shquote "a'b")"

  # _amux_frame_width: example config sets [frame] left = 30.
  _assert "frame_width default" "30" "$(_amux_frame_width)"

  # _amux_frame_width clamps from synthetic configs. Clear the (isolated) disk
  # cache between rewrites — same-second mtime would otherwise alias the cache.
  _fw=$(mktemp /tmp/amux-frame-XXXXXX.toml)
  printf '[frame]\nleft = 5\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_width clamp low"  "10" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_width)"
  printf '[frame]\nleft = 200\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_width clamp high" "90" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_width)"
  printf '[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_width no-frame"   "30" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_width)"

  # _amux_frame_top_height: opt-in. Example config leaves it unset → empty (no split).
  _assert "frame_top unset"        ""   "$(_amux_frame_top_height)"
  printf '[frame]\nleft_vertical_split = 40\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top value"        "40" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_height)"
  printf '[frame]\nleft_vertical_split = 3\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top clamp low"    "10" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_height)"
  printf '[frame]\nleft_vertical_split = 99\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top clamp high"   "90" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_height)"

  # _amux_frame_top_panes: default 1 (example config sets none), clamped to 1..6.
  _assert "frame_top_panes default" "1" "$(_amux_frame_top_panes)"
  printf '[frame]\nleft_top_panes = 3\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top_panes value"    "3" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_panes)"
  printf '[frame]\nleft_top_panes = 0\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top_panes clamp low"  "1" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_panes)"
  printf '[frame]\nleft_top_panes = 12\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top_panes clamp high" "6" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_panes)"

  # _amux_frame_focus / _amux_frame_status_position / _amux_frame_default: the
  # example config sets none of these, so each falls back to its default.
  _assert "frame_focus default"  "agent"  "$(_amux_frame_focus)"
  _assert "frame_status default" "bottom" "$(_amux_frame_status_position)"
  _assert "frame_default unset"  ""       "$(_amux_frame_default)"
  printf '[frame]\nfocus = "terminal"\nstatus_position = "top"\ndefault = true\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_focus terminal" "terminal" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_focus)"
  _assert "frame_status top"     "top"      "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_status_position)"
  _assert "frame_default on"     "1"        "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_default)"
  # Unrecognised values fall back to defaults (agent / bottom).
  printf '[frame]\nfocus = "sideways"\nstatus_position = "middle"\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_focus bad val"  "agent"  "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_focus)"
  _assert "frame_status bad val" "bottom" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_status_position)"

  # [notes] row -> @amux_note_row (update_colors.sh reads it to pick status 5).
  _nw=$(mktemp "${TMPDIR:-/tmp}/amux-notesw-XXXXXX.toml") || exit 1
  printf '[[agents]]\nname="a"\ncmd="x"\n' > "$_nw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "note_row absent"  ""  "$(AGENTMUX_CONFIG="$_nw" _amux_json_cache="" _amux_note_row)"
  printf '[notes]\nrow = true\n[[agents]]\nname="a"\ncmd="x"\n' > "$_nw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "note_row true"    "1" "$(AGENTMUX_CONFIG="$_nw" _amux_json_cache="" _amux_note_row)"
  printf '[notes]\nrow = false\n[[agents]]\nname="a"\ncmd="x"\n' > "$_nw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "note_row false"   ""  "$(AGENTMUX_CONFIG="$_nw" _amux_json_cache="" _amux_note_row)"
  # The dir argument is what lets `--reload` answer for a session other than the
  # one the CLI stands in — a [notes.dirs] block must beat the base for that dir.
  printf '[notes]\nrow = false\n[notes.dirs."/tmp/amux-nr/on"]\nrow = true\n[[agents]]\nname="a"\ncmd="x"\n' > "$_nw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "note_row dir override" "1" \
    "$(AGENTMUX_CONFIG="$_nw" _amux_json_cache="" _amux_note_row /tmp/amux-nr/on/deep)"
  _assert "note_row dir unmatched" "" \
    "$(AGENTMUX_CONFIG="$_nw" _amux_json_cache="" _amux_note_row /tmp/elsewhere)"

  # _amux_note_opts: the ONE emitter both the launch path and --reload use. The
  # shape is asserted as a single string so a silently-empty array (which would
  # publish nothing while every other assertion still passed — the exact defect
  # the `=<name>` target bug produced) cannot slip through.
  printf '[notes]\nrow = true\n[[agents]]\nname="a"\ncmd="x"\n' > "$_nw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  ( AGENTMUX_CONFIG="$_nw"; _amux_json_cache=""; _amux_note_opts proj /tmp/x
    printf '%s\n' "${_AMUX_NOTE_OPTS[*]}" ) > "$_nw.on"
  _assert "note_opts on" \
    "set-option -t proj @amux_note_row 1 ; set-option -t proj @amux_note4 $(sh "$_selftest_dir/../scripts/notes.sh" hint 4)" \
    "$(cat "$_nw.on")"
  printf '[notes]\nrow = false\n[[agents]]\nname="a"\ncmd="x"\n' > "$_nw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  ( AGENTMUX_CONFIG="$_nw"; _amux_json_cache=""; _amux_note_opts proj /tmp/x
    printf '%s\n' "${_AMUX_NOTE_OPTS[*]}" ) > "$_nw.off"
  _assert "note_opts off (symmetric unset)" \
    "set-option -u -t proj @amux_note_row ; set-option -u -t proj @amux_note4" \
    "$(cat "$_nw.off")"
  # Never the `=<name>` form: show-options returns empty for it and set-option
  # errors "no such session: =name", so a `=` here publishes nothing at all.
  # BOTH directions are grepped on purpose — checking only the off-branch output
  # passes while the on-branch carries the bug (measured, by reintroducing it).
  _assert "note_opts uses a bare target" "0" \
    "$(cat "$_nw.on" "$_nw.off" | grep -c -- '-t =proj')"
  rm -f "$_nw" "$_nw.on" "$_nw.off"

  # _amux_frame_prefix: effective frame prefix = [frame] prefix or the C-f default.
  printf '[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_prefix default" "C-f" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_prefix)"
  printf '[frame]\nprefix = "C-x"\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_prefix set"     "C-x" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_prefix)"

  # _amux_prefix: example config sets no [amux] → empty (default prefix untouched).
  _assert "amux_prefix unset" "" "$(_amux_prefix)"
  # [amux] prefix with no collision → emitted verbatim (frame default is C-f).
  printf '[amux]\nprefix = "C-a"\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "amux_prefix set" "C-a" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_prefix 2>/dev/null)"
  # Collision with an explicit [frame] prefix → empty stdout + a warning on stderr.
  printf '[amux]\nprefix = "C-x"\n[frame]\nprefix = "C-x"\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "amux_prefix collide stdout" "" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_prefix 2>/dev/null)"
  _pw=$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_prefix 2>&1 >/dev/null)
  case "$_pw" in *"collides with the [frame] prefix"*) _got=warns ;; *) _got="silent:$_pw" ;; esac
  _assert "amux_prefix collide warns" "warns" "$_got"
  # Collision against the C-f default (no [frame] block) is caught too.
  printf '[amux]\nprefix = "C-f"\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "amux_prefix collide default" "" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_prefix 2>/dev/null)"

  rm -f "$_fw"

  # --- pinned bar colours ---
  _fp=$(mktemp)
  cat > "$_fp" <<'EOF'
[amux.dirs."/tmp/amux-pin-blue"]
session_colour = "blue"
[amux.dirs."/tmp/amux-pin-magenta"]
session_colour = "magenta"
[[agents]]
name = "x"
cmd = "true"
EOF
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null  # disk cache is mtime-keyed; clear it
  # A pinned dir resolves to its palette slot; an unpinned dir resolves to empty.
  _assert "pin slot blue=0" "0" \
    "$(AGENTMUX_CONFIG="$_fp" _amux_json_cache="" _amux_bar_pin_slot /tmp/amux-pin-blue)"
  _assert "pin slot magenta=8" "8" \
    "$(AGENTMUX_CONFIG="$_fp" _amux_json_cache="" _amux_bar_pin_slot /tmp/amux-pin-magenta)"
  _assert "pin slot unpinned empty" "" \
    "$(AGENTMUX_CONFIG="$_fp" _amux_json_cache="" _amux_bar_pin_slot /tmp/amux-unpinned)"
  # The reserved set lists every pinned slot, unique, space-separated.
  _assert "reserved set" "0 8" \
    "$(AGENTMUX_CONFIG="$_fp" _amux_json_cache="" _amux_bar_reserved 2>/dev/null)"
  rm -f "$_fp"

  # Unknown colour name warns and is skipped (not added to the reserved set).
  _fpu=$(mktemp)
  cat > "$_fpu" <<'EOF'
[amux.dirs."/tmp/amux-pin-bad"]
session_colour = "chartreuse"
[[agents]]
name = "x"
cmd = "true"
EOF
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _uw=$(AGENTMUX_CONFIG="$_fpu" _amux_json_cache="" _amux_bar_reserved 2>&1 >/dev/null)
  case "$_uw" in *"unknown bar colour 'chartreuse'"*) _got=warns ;; *) _got="silent:$_uw" ;; esac
  _assert "reserved warns on unknown colour" "warns" "$_got"
  _assert "reserved skips unknown colour" "" \
    "$(AGENTMUX_CONFIG="$_fpu" _amux_json_cache="" _amux_bar_reserved 2>/dev/null)"
  rm -f "$_fpu"

  # Two dirs pinning the same colour warn, and the slot appears once (olive = 4).
  _fpd=$(mktemp)
  cat > "$_fpd" <<'EOF'
[amux.dirs."/tmp/amux-pin-a"]
session_colour = "olive"
[amux.dirs."/tmp/amux-pin-b"]
session_colour = "olive"
[[agents]]
name = "x"
cmd = "true"
EOF
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _dw=$(AGENTMUX_CONFIG="$_fpd" _amux_json_cache="" _amux_bar_reserved 2>&1 >/dev/null)
  case "$_dw" in *"pinned by more than one dir"*) _got=warns ;; *) _got="silent:$_dw" ;; esac
  _assert "reserved warns on duplicate pin" "warns" "$_got"
  _assert "reserved dedups duplicate pin" "4" \
    "$(AGENTMUX_CONFIG="$_fpd" _amux_json_cache="" _amux_bar_reserved 2>/dev/null)"
  rm -f "$_fpd"

  AGENTMUX_CONFIG="$_selftest_dir/../config/amux.toml.example"; _amux_json_cache=""

  # _amux_resolve_target: flag/name/session precedence (explicit session = deterministic).
  _rt=$(_amux_resolve_target -w proj)
  _assert "resolve -w agent"   "work" "$(printf '%s' "$_rt" | sed -n 1p)"
  _assert "resolve -w session" "proj" "$(printf '%s' "$_rt" | sed -n 2p)"
  _rt=$(_amux_resolve_target work proj)
  _assert "resolve name agent" "work" "$(printf '%s' "$_rt" | sed -n 1p)"
  _rt=$(_amux_resolve_target -w 'a.b:c')
  _assert "resolve sanitises session" "a_b_c" "$(printf '%s' "$_rt" | sed -n 2p)"
  _err=$(_amux_resolve_target -Z 2>&1 >/dev/null); _rc=$?
  case "$_err" in *"unknown flag -Z"*) _got=ok ;; *) _got="bad:$_err" ;; esac
  _assert "resolve unknown flag msg"  "ok" "$_got"
  _assert "resolve unknown flag exit" "1"  "$_rc"

  # _amux_update on a non-clone dir explains the dev case and fails non-zero.
  _td=$(mktemp -d)
  _out=$(_amux_update "$_td" 2>&1); _rc=$?
  case "$_out" in *"is not a git clone"*) _got="ok" ;; *) _got="bad:$_out" ;; esac
  _assert "update non-clone message" "ok" "$_got"
  _assert "update non-clone exit"    "1"  "$_rc"
  rmdir "$_td"

  # Exact-match session resolution (the reductable-www bug): tmux resolves a bare
  # `-t name` by prefix/fnmatch, so without the `=` guard `_amux_session_exists
  # proj` is TRUE when only `proj-www` exists and amux attaches to the wrong
  # session. Drive _amux_session_exists on an isolated socket. Needs a real tmux;
  # skip cleanly if absent.
  if command -v tmux >/dev/null 2>&1; then
    AGENTMUX_AGENT_SOCKET="amux-selftest-$$"
    _amux_atmux kill-server 2>/dev/null
    _amux_atmux new-session -d -s proj-www -c /tmp 2>/dev/null
    if _amux_session_exists proj;     then _got=present; else _got=absent; fi
    _assert "exact-match: 'proj' absent when only 'proj-www' exists" "absent" "$_got"
    if _amux_session_exists proj-www; then _got=present; else _got=absent; fi
    _assert "exact-match: 'proj-www' present exactly" "present" "$_got"
    _amux_atmux kill-server 2>/dev/null
    AGENTMUX_AGENT_SOCKET=""
  else
    echo "SKIP: exact-match session test (tmux not found)"
  fi

  # $TMUX isolation (the --kill-only-killed-the-frame bug): a bare `tmux` inherits
  # the surrounding server's socket from $TMUX, so an agent-socket op that didn't pass
  # -L explicitly could hit the frame server. _amux_atmux always resolves its target via
  # _amux_agent_sock and passes it to -L (never a bare `tmux`), so this holds whether
  # AGENTMUX_AGENT_SOCKET is set or empty (shard) — isolate onto a throwaway socket here
  # rather than the empty/production path, which now resolves to a real per-project
  # shard. We put a uniquely-named probe session on an isolated "frame" server, point
  # $TMUX at it, then assert _amux_session_exists on OUR isolated socket does NOT find
  # it — i.e. it ignored $TMUX.
  if command -v tmux >/dev/null 2>&1; then
    _fsock="amux-selftest-frame-$$"; _probe="amux-nested-probe-$$"
    tmux -L "$_fsock" new-session -d -s "$_probe" -c /tmp 2>/dev/null
    _spath=$(tmux -L "$_fsock" display-message -p '#{socket_path}' 2>/dev/null)
    AGENTMUX_AGENT_SOCKET="amux-selftest-$$"
    if TMUX="$_spath,1,0" _amux_session_exists "$_probe"; then _got=leaked; else _got=isolated; fi
    _assert "agent ops ignore inherited \$TMUX (reach the resolved agent socket)" "isolated" "$_got"
    tmux -L "$_fsock" kill-server 2>/dev/null
    AGENTMUX_AGENT_SOCKET=""
  else
    echo "SKIP: \$TMUX isolation test (tmux not found)"
  fi

  # --probe presence: exit 0 when the agent OR the frame session exists for the
  # resolved base, non-zero when neither does. This is the query warden's cyan
  # presence dot calls; it must light for a lingering frame (agent exited, frame
  # wrapper still up), not just a live agent. Isolate both sockets onto throwaway
  # servers so the user's real tmux is never touched.
  if command -v tmux >/dev/null 2>&1; then
    AGENTMUX_AGENT_SOCKET="amux-selftest-$$"
    _psock="amux-selftest-pframe-$$"; _psave="$AGENTMUX_FRAME_SOCKET"; AGENTMUX_FRAME_SOCKET="$_psock"
    _amux_atmux kill-server 2>/dev/null; tmux -L "$_psock" kill-server 2>/dev/null

    if _amux_probe probe-x; then _got=present; else _got=absent; fi
    _assert "probe: absent when no agent or frame session" "absent" "$_got"

    _amux_atmux new-session -d -s probe-x -c /tmp 2>/dev/null
    if _amux_probe probe-x; then _got=present; else _got=absent; fi
    _assert "probe: present via agent session" "present" "$_got"
    _amux_atmux kill-session -t "=probe-x" 2>/dev/null

    tmux -L "$_psock" new-session -d -s probe-x-frame -c /tmp 2>/dev/null
    if _amux_probe probe-x; then _got=present; else _got=absent; fi
    _assert "probe: present via lingering frame (agent gone)" "present" "$_got"
    # an explicit -frame/-term arg resolves to the same base
    if _amux_probe probe-x-frame; then _got=present; else _got=absent; fi
    _assert "probe: -frame arg resolves to base" "present" "$_got"

    _amux_atmux kill-server 2>/dev/null; tmux -L "$_psock" kill-server 2>/dev/null
    AGENTMUX_AGENT_SOCKET=""; AGENTMUX_FRAME_SOCKET="$_psave"
  else
    echo "SKIP: --probe test (tmux not found)"
  fi

  # --probe exit 3: absent session + a pending drop for this cwd → "recoverable".
  # warden renders this as a ghost. Exit 3 (not 0) so every existing `if amux --probe`
  # consumer still reads it as absent.
  (
    _sldir=$(mktemp -d) || exit 0
    cd /tmp || exit 0

    # No session, no drop → plain absent (1), NOT 3.
    _amux_probe >/dev/null 2>&1; _got=$?
    _assert "probe: absent with no drop exits 1" "1" "$_got"

    # Stub the ledger query: a pending drop for this cwd. (The real interface is
    # `session_log.sh dropped --pending <cwd>`, so $2 carries --pending, not $1.)
    _sl_stub="$_sldir/session_log.sh"
    cat > "$_sl_stub" <<'STUB'
#!/bin/sh
case "$2" in
  --pending) printf 'work\t/tmp\tclaude --resume x\t1\n' ;;
esac
STUB
    chmod +x "$_sl_stub"
    AGENTMUX_SCRIPTS="$_sldir"
    _amux_probe >/dev/null 2>&1; _got=$?
    _assert "probe: absent with pending drop exits 3" "3" "$_got"
  )

  # --probe/--kill dir-guard (basename-collision safety): amux names a session
  # after $PWD's basename, so two dirs sharing a basename collide. The CWD-derived
  # probe/kill must refuse a session whose recorded @amux_dir is a DIFFERENT dir
  # (so warden's dot/kill can't cross-fire to a sibling project); a session with
  # no @amux_dir (legacy) still counts as ours. Isolate both sockets.
  if command -v tmux >/dev/null 2>&1; then
    AGENTMUX_AGENT_SOCKET="amux-selftest-$$"
    _dgfsave="$AGENTMUX_FRAME_SOCKET"; AGENTMUX_FRAME_SOCKET="amux-selftest-dgframe-$$"
    _amux_atmux kill-server 2>/dev/null; tmux -L "$AGENTMUX_FRAME_SOCKET" kill-server 2>/dev/null
    _dgsave="$PWD"; _dgroot=$(mktemp -d); mkdir -p "$_dgroot/dgapi"; cd "$_dgroot/dgapi" || true
    # session named after this dir's basename, but recorded under a DIFFERENT dir
    _amux_atmux new-session -d -s dgapi -c /tmp 2>/dev/null
    _amux_atmux set-option -t dgapi @amux_dir "/somewhere/else/dgapi" 2>/dev/null

    if _amux_probe; then _got=present; else _got=absent; fi
    _assert "dir-guard: probe absent for a same-basename session in another dir" "absent" "$_got"
    _amux_kill >/dev/null 2>&1; _rc=$?
    if _amux_session_exists dgapi; then _got=alive; else _got=killed; fi
    _assert "dir-guard: kill spares a same-basename session in another dir" "alive" "$_got"
    _assert "dir-guard: kill reports nothing to reap (exit 1)" "1" "$_rc"

    _amux_atmux set-option -t dgapi @amux_dir "$PWD" 2>/dev/null
    if _amux_probe; then _got=present; else _got=absent; fi
    _assert "dir-guard: probe present once @amux_dir matches \$PWD" "present" "$_got"

    _amux_atmux set-option -u -t dgapi @amux_dir 2>/dev/null   # legacy: no @amux_dir
    if _amux_probe; then _got=present; else _got=absent; fi
    _assert "dir-guard: probe present for a legacy session (no @amux_dir)" "present" "$_got"

    _amux_atmux kill-server 2>/dev/null; tmux -L "$AGENTMUX_FRAME_SOCKET" kill-server 2>/dev/null
    cd "$_dgsave" || true; rm -rf "$_dgroot"
    AGENTMUX_AGENT_SOCKET=""; AGENTMUX_FRAME_SOCKET="$_dgfsave"
  else
    echo "SKIP: dir-guard test (tmux not found)"
  fi

  # --- restore integration (real tmux socket): prove _amux_restore_into actually
  #     creates windows and RUNS each dropped tab's resume command. Window 0 goes
  #     through send-keys into the interactive shell; extra windows through a
  #     new-window START-COMMAND (a non-empty pane_start_command, which is also what
  #     makes launch_agent.sh's after-new-window guard skip them). Markers prove the
  #     commands ran; @agent-mode proves window-0-replace set the restored agent. ---
  if command -v tmux >/dev/null 2>&1; then
    _rsave="$AGENTMUX_AGENT_SOCKET"; AGENTMUX_AGENT_SOCKET="amux-restore-selftest-$$"
    _rsdsave="${AGENTMUX_STATE_DIR:-}"; _rstate=$(mktemp -d); export AGENTMUX_STATE_DIR="$_rstate"
    _rdir=$(mktemp -d); _rm1="$_rdir/m1"; _rm2="$_rdir/m2"
    # Window 0 goes through send-keys into a persistent shell; the extra window's
    # resume command IS its pane process, so it must stay alive (real agents like
    # `claude --resume` do) for the @window-agent style assertion below to observe
    # it — a one-shot `echo` would exit and close the window first. `sleep 30` is
    # reaped by kill-server at the end of the block.
    printf "work\tsh -c 'echo one > %s'\npersonal\tsh -c 'echo two > %s; sleep 30'\n" "$_rm1" "$_rm2" \
      | _amux_restore_into "$_rdir"
    _rn=0; while [ "$_rn" -lt 50 ]; do [ -s "$_rm1" ] && [ -s "$_rm2" ] && break; sleep 0.1; _rn=$((_rn + 1)); done
    _assert "restore: window-0 (send-keys) ran its cmd"      "one"  "$(cat "$_rm1" 2>/dev/null)"
    _assert "restore: extra window (start-cmd) ran its cmd"  "two"  "$(cat "$_rm2" 2>/dev/null)"
    _rname=$(_amux_sanitize_session "$(basename "$_rdir")")
    if _amux_atmux has-session -t "=$_rname" 2>/dev/null; then _got=yes; else _got=no; fi
    _assert "restore: session created on the agent socket"   "yes"  "$_got"
    _assert "restore: @agent-mode = window-0 restored agent" "work" "$(_amux_atmux show-options -qv -t "$_rname" @agent-mode 2>/dev/null)"
    # Window styling must land ON THE SHARD, not the default socket: agentmux_set_window_style
    # is run from this CLI process (no ambient $TMUX), so it needs the agent socket passed
    # explicitly. @window-agent is the cleanest signal — a custom option set only by that
    # function, empty on the shard if the call mis-targeted the default socket. Covers both
    # restore call sites: window 0 (send-keys replace) and window 1 (new-window start-cmd).
    _assert "restore: window 0 styled on the shard (@window-agent)" "work" \
      "$(_amux_atmux show-options -wqv -t "=$_rname:0" @window-agent 2>/dev/null)"
    _assert "restore: window 1 styled on the shard (@window-agent)" "personal" \
      "$(_amux_atmux show-options -wqv -t "=$_rname:1" @window-agent 2>/dev/null)"
    # RESTORE MUST BE IDEMPOTENT. A restored tab's resume command is known HERE —
    # it is the very thing being replayed — but sl_dropped only ever offers a
    # window whose ledger row carries a resume hint, and the only other writer of
    # that hint is the agent's working hook (which needs the user to submit a
    # prompt). So without this the restored tab is unrestorable until prompted in:
    # restore N tabs, use one, crash → the next picker offers one. Assert BOTH the
    # window stamp the sidecar reads and the ledger row the fold reads.
    _assert "restore: window 0 marked resumable on the shard" "1" \
      "$(_amux_atmux show-options -wqv -t "=$_rname:0" @amux_resumable 2>/dev/null)"
    _assert "restore: window 1 marked resumable on the shard" "1" \
      "$(_amux_atmux show-options -wqv -t "=$_rname:1" @amux_resumable 2>/dev/null)"
    _assert "restore: ledger holds a resume row per restored window" "2" \
      "$(jq -r 'select(.event=="resume")|.window_id' "$_rstate/sessions.jsonl" 2>/dev/null \
         | sort -u | grep -c . | tr -d ' ')"
    _amux_atmux kill-server 2>/dev/null
    rm -rf "$_rdir" "$_rstate"; AGENTMUX_AGENT_SOCKET="$_rsave"
    if [ -n "$_rsdsave" ]; then export AGENTMUX_STATE_DIR="$_rsdsave"; else unset AGENTMUX_STATE_DIR; fi
  else
    echo "SKIP: restore integration test (tmux not found)"
  fi

  # --- window-0 styling on the agent shard (real tmux). The reported bug: the
  #     FIRST agent pane (window 0, styled by THIS CLI process in
  #     _amux_launch_window0 — not by the after-new-window hook that handles
  #     later windows) never got @window-agent or its colour, because
  #     agentmux_set_window_style ran a bare `tmux` that lands on the DEFAULT
  #     socket instead of this project's sharded agent socket. Prove window 0 is
  #     styled ON THE SHARD. A benign-cmd config keeps the send-keys inert. ---
  if command -v tmux >/dev/null 2>&1; then
    _w0save="$AGENTMUX_AGENT_SOCKET"; AGENTMUX_AGENT_SOCKET="amux-win0style-selftest-$$"
    _w0cfgsave="$AGENTMUX_CONFIG"; _w0cache="$_amux_json_cache"
    # Scope the STATE DIR too, not just the socket: new-session/_amux_launch_window0
    # reach sl_open, which appends to the ledger and writes a live/ sidecar. Without
    # this the selftest mutates the USER's real state dir on every run.
    _w0sdsave="${AGENTMUX_STATE_DIR:-}"; _w0state=$(mktemp -d); export AGENTMUX_STATE_DIR="$_w0state"
    _w0cfg=$(mktemp); printf '[[agents]]\nname = "solo"\nlabel = "s"\ncolour = "green"\ncmd = ":"\n' > "$_w0cfg"
    AGENTMUX_CONFIG="$_w0cfg"; _amux_json_cache=""
    _amux_atmux new-session -d -s w0proj -c /tmp
    _amux_launch_window0 w0proj solo
    _assert "window0: @window-agent set on the agent shard" "solo" \
      "$(_amux_atmux show-options -wqv -t "=w0proj:0" @window-agent 2>/dev/null)"
    _amux_atmux kill-server 2>/dev/null; rm -f "$_w0cfg"; rm -rf "$_w0state"
    AGENTMUX_AGENT_SOCKET="$_w0save"; AGENTMUX_CONFIG="$_w0cfgsave"; _amux_json_cache="$_w0cache"
    if [ -n "$_w0sdsave" ]; then export AGENTMUX_STATE_DIR="$_w0sdsave"; else unset AGENTMUX_STATE_DIR; fi
  else
    echo "SKIP: window-0 style test (tmux not found)"
  fi

  # --- _amux_ensure_agent_session creates + configures a session, leaves it
  #     detached (the caller attaches). This is the shared create path for BOTH the
  #     plain launch and _amux_frame, so proving it here guards the frame path too.
  #     Needs a real tmux; skip cleanly if absent. Rides the selftest-wide
  #     TMUX_TMPDIR (the single isolation point — never a per-block one). Stdin from
  #     /dev/null so the restore-picker's TTY guard skips it deterministically. A
  #     benign `cmd = ":"` config (agent literally named "work") keeps window-0's
  #     send-keys inert, same as the window-0 style test above. ---
  if command -v tmux >/dev/null 2>&1; then
    _es_save="$AGENTMUX_AGENT_SOCKET"; _es_cfgsave="$AGENTMUX_CONFIG"; _es_cache="$_amux_json_cache"
    AGENTMUX_AGENT_SOCKET="amux-ensure-selftest-$$"
    # Same reason as the window-0 block above: _amux_ensure_agent_session opens a
    # real session, so sl_open would write to the user's real ledger + live/ sidecars.
    _es_sdsave="${AGENTMUX_STATE_DIR:-}"; _es_state=$(mktemp -d); export AGENTMUX_STATE_DIR="$_es_state"
    _es_cfg=$(mktemp); printf '[[agents]]\nname = "work"\nlabel = "w"\ncolour = "teal"\ncmd = ":"\n' > "$_es_cfg"
    AGENTMUX_CONFIG="$_es_cfg"; _amux_json_cache=""
    ( cd /tmp && _amux_ensure_agent_session work ensureproj </dev/null ) 2>/dev/null
    _assert "ensure creates session" "1" \
      "$(_amux_atmux has-session -t '=ensureproj' 2>/dev/null && echo 1 || echo 0)"
    _assert "ensure sets @autoagent" "1" \
      "$(_amux_atmux show-options -qv -t ensureproj @autoagent 2>/dev/null)"
    _assert "ensure sets @agent-mode" "work" \
      "$(_amux_atmux show-options -qv -t ensureproj @agent-mode 2>/dev/null)"
    _assert "ensure sets @amux_dir" "/tmp" \
      "$(_amux_atmux show-options -qv -t ensureproj @amux_dir 2>/dev/null)"
    _assert "ensure names window 0" "work" \
      "$(_amux_atmux display-message -t '=ensureproj:0' -p '#{window_name}' 2>/dev/null)"
    # The config above carries no [notes] block, so the fourth row is OFF and
    # neither option may be published.
    _assert "ensure: note_row absent when [notes] row is unset" "" \
      "$(_amux_atmux show-options -qv -t ensureproj @amux_note_row 2>/dev/null)"

    # ROW 4 AT LAUNCH. Re-run ensure on the SAME (now existing) session with the
    # row enabled: this is the re-attach path, which must publish both options —
    # and the hint must be readable on window 0's pane, which NOTHING has
    # rendered (notes.sh's _nt_render is reachable only from a click or
    # `prefix N`, neither of which has happened here). Read through the FORMAT
    # chain, exactly as status-format[4] does — `show-options -p` would report
    # the pane scope alone and miss the session-level default entirely.
    printf '[notes]\nrow = true\n[[agents]]\nname = "work"\nlabel = "w"\ncolour = "teal"\ncmd = ":"\n' > "$_es_cfg"
    _amux_json_cache=""; rm -rf "$_selftest_cache/agentmux" 2>/dev/null
    ( cd /tmp && _amux_ensure_agent_session work ensureproj </dev/null ) 2>/dev/null
    _assert "ensure: note_row published on re-attach" "1" \
      "$(_amux_atmux show-options -qv -t ensureproj @amux_note_row 2>/dev/null)"
    _es_pane=$(_amux_atmux display-message -t '=ensureproj:0' -p '#{pane_id}' 2>/dev/null)
    # Non-vacuity: the pane itself holds no @amux_note4 …
    _assert "ensure: row 4 unrendered at pane scope" "" \
      "$(_amux_atmux show-options -pqv -t "$_es_pane" @amux_note4 2>/dev/null)"
    # … so a hint here can only have come from the session-level default.
    _assert "ensure: row 4 shows its hint with no render" "$(sh "$AGENTMUX_SCRIPTS/notes.sh" hint 4)" \
      "$(_amux_atmux display-message -t "$_es_pane" -p '#{@amux_note4}' 2>/dev/null)"

    # …and the emit is SYMMETRIC: flipping the config back off must clear both,
    # or a running session's row could never be turned off again.
    printf '[notes]\nrow = false\n[[agents]]\nname = "work"\nlabel = "w"\ncolour = "teal"\ncmd = ":"\n' > "$_es_cfg"
    _amux_json_cache=""; rm -rf "$_selftest_cache/agentmux" 2>/dev/null
    ( cd /tmp && _amux_ensure_agent_session work ensureproj </dev/null ) 2>/dev/null
    _assert "ensure: note_row cleared when row goes false" "" \
      "$(_amux_atmux show-options -qv -t ensureproj @amux_note_row 2>/dev/null)"
    _assert "ensure: row 4 hint cleared when row goes false" "" \
      "$(_amux_atmux display-message -t "$_es_pane" -p '#{@amux_note4}' 2>/dev/null)"
    _amux_atmux kill-server 2>/dev/null; rm -f "$_es_cfg"; rm -rf "$_es_state"
    AGENTMUX_AGENT_SOCKET="$_es_save"; AGENTMUX_CONFIG="$_es_cfgsave"; _amux_json_cache="$_es_cache"
    if [ -n "$_es_sdsave" ]; then export AGENTMUX_STATE_DIR="$_es_sdsave"; else unset AGENTMUX_STATE_DIR; fi
  else
    echo "SKIP: ensure_agent_session test (tmux not found)"
  fi

  # --- legacy notice: fires once for an @autoagent session on the REAL default
  #     socket (no -L), then is suppressed by its persistent marker. Needs a real
  #     tmux; skip cleanly if absent (same pattern as neighbouring cases). The
  #     selftest-wide TMUX_TMPDIR keeps this "default" socket (no -L) off the
  #     user's actual default socket.
  if command -v tmux >/dev/null 2>&1; then
    _ln_state="/tmp/amuxtest-legstate-$$"; rm -rf "$_ln_state"
    _ln_save_state="${AGENTMUX_STATE_DIR:-}"; export AGENTMUX_STATE_DIR="$_ln_state"
    env -u TMUX tmux new-session -d -s legacyagent; env -u TMUX tmux set -t legacyagent @autoagent 1
    _ln1=$(_amux_legacy_notice 2>&1); _ln_marker="$_ln_state/.legacy-socket-notified"
    [ -f "$_ln_marker" ] && _got=marked || _got=nomarker
    _assert "legacy notice creates marker" "marked" "$_got"
    case "$_ln1" in *"agent(s) still on the old shared tmux socket"*) _got=ok ;; *) _got="bad:$_ln1" ;; esac
    _assert "legacy notice message" "ok" "$_got"
    _ln2=$(_amux_legacy_notice 2>&1)
    _assert "legacy notice suppressed after marker" "" "$_ln2"
    env -u TMUX tmux kill-server 2>/dev/null; rm -rf "$_ln_state"
    if [ -n "$_ln_save_state" ]; then export AGENTMUX_STATE_DIR="$_ln_save_state"; else unset AGENTMUX_STATE_DIR; fi
  else
    echo "SKIP: legacy notice test (tmux not found)"
  fi

  # Regression (the socket-leak fix): every tmux server we spawned went to the
  # per-run throwaway TMUX_TMPDIR, so the user's REAL shared tmux dir must carry
  # NONE of this run's sockets. A non-empty match means a block created a server
  # on the default dir (isolation missing or foiled) — the leak that filled
  # /tmp/tmux-<uid>/ unbounded across runs (see CLAUDE.md). Scoped to THIS run's
  # $$, plus the fixed 99999999 sentinel, so pre-existing files never false-fail.
  _real_sockdir="/tmp/tmux-$(id -u)"
  _leaked=$(ls -d "$_real_sockdir/"*"-$$" "$_real_sockdir/agentmux-frame-99999999" 2>/dev/null | tr '\n' ' ')
  _assert "no tmux sockets stranded in the shared dir" "" "$_leaked"

  # $_selftest_cache + $_st_tmpdir are reaped by the EXIT trap set at the top.
  echo "---"; echo "Passed: $pass  Failed: $fail"
  [ "$fail" -eq 0 ]
  exit $?
fi

amux "$@"
