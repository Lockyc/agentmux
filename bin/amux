#!/usr/bin/env bash
# amux — agentmux session launcher (standalone executable).
# The single source of truth for amux logic; shell integration files
# (shell/agentmux.sh, shell/agentmux.fish) are thin wrappers around this.
#
# Required env: AGENTMUX_CONFIG  (default: ~/.agentmux/amux.toml)
#               AGENTMUX_SCRIPTS (default: <dir of this script>/../scripts)

AGENTMUX_CONFIG="${AGENTMUX_CONFIG:-$HOME/.agentmux/amux.toml}"
AGENTMUX_SCRIPTS="${AGENTMUX_SCRIPTS:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../scripts" 2>/dev/null && pwd)}"

# BASH_SOURCE is not symlink-resolved: the default above assumes bin/ and
# scripts/ are siblings (the install + dev layout). Fail fast with a readable
# message rather than a confusing "source: No such file" if it can't be found.
if [ ! -d "$AGENTMUX_SCRIPTS" ]; then
  echo "amux: cannot locate scripts dir (set AGENTMUX_SCRIPTS)" >&2
  exit 1
fi

source "$AGENTMUX_SCRIPTS/agentmux-config.sh"
source "$AGENTMUX_SCRIPTS/agent_window_style.sh"

# tmux config dir (sibling of scripts/) and the dedicated sockets for --frame.
# AGENTMUX_TERM_SOCKET is exported so the frame server inherits it: frame.conf's
# C-f Q binding reads it back (via the shell, `${AGENTMUX_TERM_SOCKET:-…}`) to kill
# the paired terminal on the right socket even when it's been overridden here.
AGENTMUX_TMUX="${AGENTMUX_TMUX:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../tmux" 2>/dev/null && pwd)}"
AGENTMUX_FRAME_SOCKET="${AGENTMUX_FRAME_SOCKET:-agentmux-frame}"
export AGENTMUX_TERM_SOCKET="${AGENTMUX_TERM_SOCKET:-agentmux-term}"
# Agent sessions live on tmux's DEFAULT socket (no -L). This override exists only
# so selftests can isolate the session-management commands onto a throwaway socket
# instead of the user's real tmux; empty = default socket, as in production.
AGENTMUX_AGENT_SOCKET="${AGENTMUX_AGENT_SOCKET:-}"
# Absolute path to this launcher (for --frame's right-pane re-invocation), resolved
# once here from the same BASH_SOURCE the dirs above use.
AGENTMUX_BIN="${AGENTMUX_BIN:-$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/$(basename "${BASH_SOURCE[0]}")}"

# Single-quote a string for safe interpolation into an `sh -c` command line.
_amux_shquote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Sanitise a tmux session name to a safe-character whitelist. Two reasons,
# both load-bearing:
#  1. tmux uses . and : as target separators (session.win.pane, session:win),
#     so those break `tmux has-session -t` and friends.
#  2. SECURITY: the name is later re-expanded as #{session_name} inside
#     `run-shell` hook bodies (tmux/agentmux.conf, tmux/frame.conf), which tmux
#     passes to `sh -c`. A name containing $(...) / backticks / ; etc. would
#     then execute — and the default name is basename "$PWD", so a hostile
#     directory name would be RCE on `amux`. Whitelisting to [A-Za-z0-9_-]
#     closes both sinks; session names are cosmetic so nothing is lost.
# Dash is last in the set so tr reads it as a literal, not a range endpoint.
_amux_sanitize_session() { printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9_-' '_'; }

# tmux on the agent (default) socket, honouring AGENTMUX_AGENT_SOCKET for test
# isolation. In production AGENTMUX_AGENT_SOCKET is empty → default socket, but we
# must clear $TMUX first: a bare `tmux` inherits the surrounding server's socket
# from $TMUX, so when amux runs INSIDE the frame (its own server) every agent-socket
# op would silently hit the frame server instead of the default one. That made
# `amux --kill` skip the agent (has-session against the frame socket is false) while
# still killing the frame. `env -u TMUX` forces the real default socket regardless.
_amux_atmux() {
  if [ -n "$AGENTMUX_AGENT_SOCKET" ]; then tmux -L "$AGENTMUX_AGENT_SOCKET" "$@"; else env -u TMUX tmux "$@"; fi
}

# tmux resolves a `-t` session target by exact → prefix → fnmatch, so a bare
# `has-session -t reductable` is TRUE when only `reductable-www` exists and the
# subsequent attach joins the WRONG session (and the create-vs-attach decision is
# wrong both ways). Prefixing the target with `=` forces EXACT matching. It is
# honoured by has-session/attach-session/switch-client/kill-session and window
# targets (`=sess:0`), but NOT by set-option (target left bare there — tmux still
# tries exact-match first, and those calls only run once the exact session is
# known to exist) nor by split-window/list-panes. Don't drop the `=`.
_amux_session_exists() { _amux_atmux has-session -t "=$1" 2>/dev/null; }

# Newline-separated names of agentmux-managed sessions (@autoagent=1) on the agent
# socket; empty if none. Backs --sessions, --kill-all, and --complete-sessions.
_amux_agent_session_names() {
  _amux_atmux list-sessions -F '#{?@autoagent,#{session_name},}' 2>/dev/null | grep .
}

# Clamp a percent to 10..90. Non-numeric/empty falls back to $2 (the default),
# which may itself be empty — in which case the result is empty (no output).
_amux_clamp_pct() {
  local v="$1"
  case "$v" in ''|*[!0-9]*) v="$2" ;; esac
  [ -z "$v" ] && return 0
  [ "$v" -lt 10 ] && v=10
  [ "$v" -gt 90 ] && v=90
  printf '%s' "$v"
}

# Resolve the left-pane width for --frame: [frame] left (percent), default 30,
# clamped to 10..90. Non-numeric or absent → default.
_amux_frame_width() { _amux_clamp_pct "$(agentmux_frame_field left "$PWD")" 30; }

# Resolve the OPTIONAL left-column vertical split for --frame: [frame]
# left_vertical_split (percent height of the TOP sub-pane), clamped to 10..90.
# Opt-in: unset or non-numeric → empty output (the left column stays one pane).
_amux_frame_top_height() { _amux_clamp_pct "$(agentmux_frame_field left_vertical_split "$PWD")" ""; }

# Resolve how many side-by-side plain-shell panes fill the top sub-region for
# --frame: [frame] left_top_panes, clamped to 1..6, default 1 (absent/non-numeric).
# Only meaningful when left_vertical_split is set (no top region otherwise).
_amux_frame_top_panes() {
  local v; v=$(agentmux_frame_field left_top_panes "$PWD")
  case "$v" in ''|*[!0-9]*) v=1 ;; esac
  [ "$v" -lt 1 ] && v=1
  [ "$v" -gt 6 ] && v=6
  printf '%s' "$v"
}

# Resolve which pane the frame focuses on start: [frame] focus. "terminal" focuses
# the left scratch column; anything else (incl. unset) focuses the agent (right).
_amux_frame_focus() {
  case "$(agentmux_frame_field focus "$PWD")" in terminal) echo terminal ;; *) echo agent ;; esac
}

# Resolve the frame status bar position: [frame] status_position. "top" puts the
# [amux frame] bar at the top; anything else (incl. unset) keeps it at the bottom.
_amux_frame_status_position() {
  case "$(agentmux_frame_field status_position "$PWD")" in top) echo top ;; *) echo bottom ;; esac
}

# Whether a bare `amux` (no --frame/--no-frame) should open a frame: [frame]
# default = true. Echoes "1" when on, "" otherwise.
_amux_frame_default() {
  [ "$(agentmux_frame_field default "$PWD")" = "true" ] && echo 1 || echo ""
}

# The effective frame prefix for $PWD: [frame] prefix, or frame.conf's built-in
# default when unset. Kept in sync with `set -g prefix` in tmux/frame.conf.
_AMUX_FRAME_PREFIX_DEFAULT="C-f"
_amux_frame_prefix() {
  local p; p=$(agentmux_frame_field prefix "$PWD")
  printf '%s' "${p:-$_AMUX_FRAME_PREFIX_DEFAULT}"
}

# Resolve the per-session prefix for the amux (agent) session: [amux] prefix,
# dir-scoped. Empty output = leave the user's own ~/.tmux.conf prefix untouched.
#
# Collision guard: the --frame wrapper runs amux in its right pane and intercepts
# its OWN prefix before the inner amux ever sees it, so an [amux] prefix equal to
# the (effective) [frame] prefix would be unreachable inside a frame. On collision
# we warn and emit nothing — falling back to the user's default prefix (which the
# frame passes straight through) beats setting a key the frame would shadow.
_amux_prefix() {
  local p f
  p=$(agentmux_amux_field prefix "$PWD")
  [ -z "$p" ] && return 0
  f=$(_amux_frame_prefix)
  if [ "$p" = "$f" ]; then
    echo "amux: [amux] prefix '$p' collides with the [frame] prefix; ignoring (the frame would shadow it inside --frame)" >&2
    return 0
  fi
  printf '%s' "$p"
}

# Pinned bar-colour slot for a directory, via [amux.dirs."<dir>"].session_colour.
# Empty when unpinned or the name is unknown. update_colors.sh is sourced in a
# subshell so its palette/count globals don't leak into amux's namespace and its
# dispatch guard (basename check) stays a no-op.
_amux_bar_pin_slot() {
  local nm; nm=$(agentmux_amux_field session_colour "$1")
  [ -z "$nm" ] && return 0
  # shellcheck source=/dev/null
  ( . "$AGENTMUX_SCRIPTS/update_colors.sh"; _bar_name_to_slot "$nm" )
}

# Space-separated unique reserved slots for every pinned
# [amux.dirs.*].session_colour (insertion order; the reconcile is order-agnostic).
# Warns (stderr) on an unknown colour name or two dirs pinning the same slot.
# Published as the global @l1reserved so update_colors.sh excludes these slots
# from the newcomer pool even when the pinned project is not running.
_amux_bar_reserved() {
  local names; names=$(_amux_json | jq -r '(.amux.dirs // {}) | to_entries[] | .value.session_colour // empty')
  [ -z "$names" ] && return 0
  # shellcheck source=/dev/null
  (
    . "$AGENTMUX_SCRIPTS/update_colors.sh"
    seen=' '
    # Iterate line-wise via a here-string: a session_colour value with a glob
    # char (* ? [) or whitespace would otherwise word-split / glob against CWD
    # and silently lose the slot reservation it is meant to publish. The
    # here-string (not a pipe) keeps the loop in this shell so $seen survives
    # for the `set -- $seen` below.
    while IFS= read -r nm; do
      [ -n "$nm" ] || continue
      s=$(_bar_name_to_slot "$nm")
      if [ -z "$s" ]; then
        echo "amux: unknown bar colour '$nm' in [amux.dirs] — run 'amux --colours' for names" >&2
        continue
      fi
      case "$seen" in
        *" $s "*) echo "amux: bar colour '$nm' (slot $s) is pinned by more than one dir — last wins" >&2 ;;
        *) seen="$seen$s " ;;
      esac
    done <<< "$names"
    set -- $seen
    echo "$*"
  )
}

# Whether --frame may run inside an existing tmux: [frame] allow_nested = true.
# Off by default — the frame is itself a tmux server, so nesting it inside your
# tmux stacks prefixes and is normally refused. Advanced users already living in
# tmux can opt in. Echoes "1" when on, "" otherwise.
_amux_frame_allow_nested() {
  [ "$(agentmux_frame_field allow_nested "$PWD")" = "true" ] && echo 1 || echo ""
}

# Resolve (agent, session) from amux positional args: [(-flag | name)] [session].
# Echoes agent on line 1, session on line 2 (neither can contain a newline:
# agent names are TOML keys, sessions are sanitised). Mirrors amux()'s own
# precedence: flag → name → dir-routing → first agent; session defaults to $PWD.
_amux_resolve_target() {
  local agent_name=""
  if [ $# -gt 0 ]; then
    case "$1" in
      -*)
        local flag="${1#-}" fidx
        fidx=$(agentmux_find_by_flag "$flag")
        if [ "$fidx" = "-1" ]; then
          echo "amux: unknown flag -$flag" >&2; return 1
        fi
        agent_name=$(agentmux_agent_field "$fidx" name); shift ;;
    esac
  fi
  if [ $# -gt 0 ] && [ -z "$agent_name" ]; then
    local nidx; nidx=$(agentmux_find_by_name "$1")
    if [ "$nidx" != "-1" ]; then agent_name="$1"; shift; fi
  fi
  local session_arg; session_arg=$(_amux_sanitize_session "${1:-$(_amux_default_session_name)}")
  [ -z "$agent_name" ] && agent_name=$(agentmux_agent_for_dir "$PWD")
  [ -z "$agent_name" ] && agent_name=$(agentmux_first_agent)
  printf '%s\n%s\n' "$agent_name" "$session_arg"
}

_amux_default_session_name() {
  _amux_sanitize_session "$(basename "$PWD")"
}

_amux_attach() {
  local name="$1"
  # Use switch-client if our TTY is already a tmux pane (check via list-panes,
  # not $TMUX which is inherited into subprocesses and gives false positives).
  if tmux list-panes -a -F '#{pane_tty}' 2>/dev/null | grep -qxF "$(tty 2>/dev/null)"; then
    _amux_atmux switch-client -t "=$name"
  else
    _amux_atmux attach-session -t "=$name"
  fi
}

# Update an installed clone in place. Dev/symlink installs are not clones and
# are updated via the source checkout instead.
_amux_update() {
  local dir="$1"
  if [ -d "$dir/.git" ]; then
    if ! git -C "$dir" pull --ff-only; then
      echo "amux: update failed — resolve manually in $dir (run: git -C $dir status)" >&2
      return 1
    fi
    local v; v=$(tr -d '[:space:]' < "$dir/VERSION" 2>/dev/null)
    echo "agentmux updated to ${v:-unknown}"
  else
    echo "amux: $dir is not a git clone (dev/symlink install) — 'git pull' your source checkout instead" >&2
    return 1
  fi
}

_amux_launch_window0() {
  local session="$1" agent="$2"
  local idx cmd

  idx=$(agentmux_find_by_name "$agent")
  [ "$idx" = "-1" ] && return 1

  cmd=$(agentmux_build_cmd "$idx")

  _amux_atmux rename-window -t "=$session:0" "$agent"
  agentmux_set_window_style "$agent" "$session:0"
  _amux_atmux send-keys -t "=$session:0" "$cmd" Enter
  "$AGENTMUX_SCRIPTS/session_log.sh" open "$agent" "=$session:0" 2>/dev/null || true
}

# Print a paste-ready `colour =` field for an agent (testable; no I/O loop).
_amux_colour_line() { # <agent> <name-or-code>
  printf 'Add this under the [[agents]] block for "%s" in %s:\n\n    colour = "%s"\n' \
    "$1" "$AGENTMUX_CONFIG" "$2"
}

# Interactive picker: choose an agent (arg or prompt) and a colour, print the line.
_amux_colour_pick() {
  local agent="$1"
  if [ -z "$agent" ]; then
    local -a anames=(); local a i=1
    while IFS= read -r a; do anames+=("$a"); done < <(agentmux_list_agent_completions | grep -v '^-')
    echo "Pick an agent:" >&2
    for a in "${anames[@]}"; do echo "  $i) $a" >&2; i=$((i + 1)); done
    printf 'agent #> ' >&2; local choice; read -r choice
    case "$choice" in ''|*[!0-9]*) choice=0 ;; esac
    [ "$choice" -ge 1 ] && agent="${anames[$((choice - 1))]:-}"
  fi
  [ -z "$agent" ] && { echo "amux: no agent selected" >&2; return 1; }

  "$AGENTMUX_SCRIPTS/colours.sh" render >&2
  local -a cnames=(); local cn
  while IFS= read -r cn; do cnames+=("$cn"); done < <("$AGENTMUX_SCRIPTS/colours.sh" names)
  printf 'colour #> ' >&2; local cc; read -r cc
  case "$cc" in ''|*[!0-9]*) cc=0 ;; esac
  local picked=""
  [ "$cc" -ge 1 ] && picked="${cnames[$((cc - 1))]:-}"
  [ -z "$picked" ] && { echo "amux: no colour selected" >&2; return 1; }
  _amux_colour_line "$agent" "$picked"
}

# Dispatch `amux --colours [grid|names|pick [agent]]` (default: render preview).
_amux_colours() {
  case "${1:-}" in
    grid)  "$AGENTMUX_SCRIPTS/colours.sh" grid ;;
    names) "$AGENTMUX_SCRIPTS/colours.sh" names ;;
    pick)  shift; _amux_colour_pick "$@" ;;
    ''|render)
      printf '  Agent window-tab colours (per agent via [[agents]].colour):\n'
      "$AGENTMUX_SCRIPTS/colours.sh" render
      printf '\n  Session bar colours (per dir via [amux.dirs."<dir>"].session_colour):\n'
      # shellcheck source=/dev/null
      ( . "$AGENTMUX_SCRIPTS/update_colors.sh"; colour_bar_render )
      ;;
    *) echo "usage: amux --colours [grid|names|pick [agent]]" >&2; return 1 ;;
  esac
}

# amux --frame [(-<flag> | <agent>)] [session]
# Build the right-pane command: a single amux attach on the DEFAULT socket (TMUX
# cleared so it attach-sessions there rather than switch-client'ing the frame
# socket). Deliberately a plain one-shot, NOT a re-exec loop: a loop would
# recreate (resurrect) the agent session moments after you kill it, and tmux runs
# this through the user's login shell — maybe fish — which couldn't parse an sh
# loop anyway. The agent pane instead runs with remain-on-exit (set below), and
# the frame's pane-died hook (frame_reattach.sh) re-attaches it ONLY while the
# agent session is still alive: an accidental prefix-d detach heals in place,
# while a real kill leaves the pane dead so the live-pane staleness check above
# rebuilds the frame on the next launch (no auto-resurrection).
# `--no-frame` is explicit: with [frame] default = true a bare amux opens a frame,
# and this pane runs with TMUX unset, so without it the agent pane would itself
# spawn another frame in an endless loop.
_amux_frame_right_cmd() { # <self> <agent> <session>
  printf 'env -u TMUX %s --no-frame %s %s' \
    "$(_amux_shquote "$1")" "$(_amux_shquote "$2")" "$(_amux_shquote "$3")"
}

# Build the left-pane command: a dedicated, persistent scratch-terminal tmux on
# its own socket (TMUX cleared so it doesn't nest into the frame socket). Plain
# invocation — no shell loop — so any login shell incl. fish can run it;
# persistence is handled inside term.conf (respawn hook), not here.
_amux_frame_left_cmd() { # <term-socket> <term-conf> <term-session>
  printf 'env -u TMUX tmux -L %s -f %s new-session -A -s %s -c %s' \
    "$(_amux_shquote "$1")" "$(_amux_shquote "$2")" "$(_amux_shquote "$3")" "$(_amux_shquote "$PWD")"
}

# Outer "frame": a bare $SHELL in the left pane, amux in the right pane, as a
# nested tmux on a dedicated socket. Must be run from a plain terminal.
_amux_frame() {
  if [ -n "${TMUX:-}" ] && [ -z "$(_amux_frame_allow_nested)" ]; then
    echo "amux: --frame must be run from a plain terminal, not inside tmux (set [frame] allow_nested = true to override)" >&2
    return 1
  fi
  local frame_conf="$AGENTMUX_TMUX/frame.conf" term_conf="$AGENTMUX_TMUX/term.conf"
  if [ ! -f "$frame_conf" ]; then
    echo "amux: frame config not found at $frame_conf" >&2; return 1
  fi
  if [ ! -f "$term_conf" ]; then
    echo "amux: term config not found at $term_conf" >&2; return 1
  fi

  local target agent session
  target=$(_amux_resolve_target "$@") || return 1
  agent=$(printf '%s' "$target" | sed -n 1p)
  session=$(printf '%s' "$target" | sed -n 2p)

  # The frame session lives on its own socket and is named distinctly from the
  # amux session it wraps (which runs on the default socket): a same-named frame
  # blurs the two, and a stale frame is harder to tell apart from the real one.
  local sock="$AGENTMUX_FRAME_SOCKET" fsess="${session}-frame"

  # Optional left-column vertical split (empty = off) and its top-region pane count.
  # Resolved up front so the staleness check below knows the expected pane count.
  local top top_panes; top=$(_amux_frame_top_height); top_panes=$(_amux_frame_top_panes)

  # A frame that has lost its right (agent) pane is useless — reattaching it just
  # shows a full-width terminal. The agent pane runs with remain-on-exit, so a
  # detached/killed agent leaves a DEAD pane rather than vanishing; count only
  # LIVE panes (#{pane_dead}=0) so such a frame still reads as stale and gets
  # rebuilt. Expected: 2 live panes (agent + bottom scratch), plus $top_panes more
  # when the left split is on (so a single top pane still wants 3).
  if tmux -L "$sock" has-session -t "=$fsess" 2>/dev/null; then
    local npanes want; want=2; [ -n "$top" ] && want=$((2 + top_panes))
    npanes=$(tmux -L "$sock" list-panes -t "$fsess" -F '#{pane_dead}' 2>/dev/null | grep -c '^0$')
    [ "${npanes:-0}" -lt "$want" ] && tmux -L "$sock" kill-session -t "=$fsess" 2>/dev/null
  fi

  if ! tmux -L "$sock" has-session -t "=$fsess" 2>/dev/null; then
    local left right right_cmd left_cmd fprefix cols lines _sz focus status_pos
    # Start focus (agent|terminal) and status bar position (bottom|top), [frame] config.
    focus=$(_amux_frame_focus)
    status_pos=$(_amux_frame_status_position)
    left=$(_amux_frame_width)
    right=$((100 - left))
    left_cmd=$(_amux_frame_left_cmd "$AGENTMUX_TERM_SOCKET" "$term_conf" "${session}-term")
    # $AGENTMUX_BIN: absolute path to this launcher, for the right-pane invocation.
    right_cmd=$(_amux_frame_right_cmd "$AGENTMUX_BIN" "$agent" "$session")
    # Create the frame at the real terminal size (--frame runs in a plain
    # terminal). tmux distributes a *resize* equally across panes, so a frame born
    # at tmux's detached 80-col default would skew the ratio when it later attaches
    # to a wider terminal; sizing it correctly up front keeps the left at $left%.
    # Read the size from the controlling terminal (`stty size` → "rows cols");
    # `tput cols` reports the terminfo default under command substitution.
    _sz=$(stty size </dev/tty 2>/dev/null); lines=${_sz%% *}; cols=${_sz##* }
    case "$cols" in ''|*[!0-9]*) cols=0 ;; esac
    case "$lines" in ''|*[!0-9]*) lines=0 ;; esac
    # Left pane = persistent scratch terminal (own socket); right pane = amux.
    # Pass -x/-y only when the real size was readable; otherwise let tmux default.
    local nsargs=(new-session -d -s "$fsess" -c "$PWD")
    [ "$cols" -gt 0 ] && [ "$lines" -gt 0 ] && nsargs+=(-x "$cols" -y "$lines")
    tmux -L "$sock" -f "$frame_conf" "${nsargs[@]}" "$left_cmd"
    # The sole pane is the left column; remember it so we can subdivide it below.
    local left_pid agent_pid
    left_pid=$(tmux -L "$sock" list-panes -t "$fsess" -F '#{pane_id}')
    # Survive an accidental detach. The scratch terminal is a nested tmux client
    # (term socket), so a stray prefix-d while it's focused passes through the
    # frame, detaches it, and its attach exits — which without remain-on-exit
    # would destroy the pane and reflow the frame to full width. remain-on-exit
    # keeps the pane; the frame's pane-died hook (frame_reattach.sh) re-attaches
    # it while the term session still exists. @amux_role tells the hook which
    # session/socket to check. Per-pane, not -g: only these nested-tmux panes
    # should survive their command exiting — the optional top scratch shell is a
    # plain shell with no detach footgun, so it's left untagged and closes normally.
    tmux -L "$sock" set -p -t "$left_pid" remain-on-exit on
    tmux -L "$sock" set -p -t "$left_pid" @amux_role term
    # Optional frame prefix override ([frame] prefix); default is in frame.conf.
    # Per-session (not -g), like @amux_project below: prefix is a session option,
    # and the shared frame socket hosts several project frames — a global set
    # would let the last launch clobber the others (more so now it's dir-aware).
    fprefix=$(agentmux_frame_field prefix "$PWD")
    [ -n "$fprefix" ] && tmux -L "$sock" set -t "$fsess" prefix "$fprefix"
    # Project label for the status-left badge ([amux frame] <projectdir>/<session>).
    # Per-session (not -g): the frame socket can host several frames, each in its own
    # project, and a global option would let the last launch clobber the others.
    tmux -L "$sock" set -t "$fsess" @amux_project "$(basename "$PWD")"
    # Status bar position ([frame] status_position): frame.conf relies on tmux's
    # default (bottom); override per-session here when "top" is requested.
    tmux -L "$sock" set -t "$fsess" status-position "$status_pos"
    # `-l` sizes the new (right) pane, so the left lands at $left% (`-l N%` needs
    # tmux >= 3.1). split-window -h leaves the new right/agent pane focused.
    agent_pid=$(tmux -L "$sock" split-window -h -t "$fsess" -l "${right}%" -c "$PWD" -P -F '#{pane_id}' "$right_cmd")
    # Same accidental-detach guard for the agent pane (see the term pane above);
    # @amux_role=agent points the hook at the agent session on the default
    # socket. A real kill stays dead instead of being resurrected.
    tmux -L "$sock" set -p -t "$agent_pid" remain-on-exit on
    tmux -L "$sock" set -p -t "$agent_pid" @amux_role agent
    # Optional vertical split of the LEFT column into top/bottom (plain shells in
    # the new TOP region). `-b` inserts the new pane ABOVE left_pid, so the scratch
    # terminal (with its tab bar) stays at the BOTTOM. Done AFTER the agent split so
    # the agent keeps spanning full height; `-l` sizes the new (top) pane to $top%.
    if [ -n "$top" ]; then
      local top_pid i
      top_pid=$(tmux -L "$sock" split-window -v -b -t "$left_pid" -l "${top}%" -c "$PWD" -P -F '#{pane_id}')
      # Stack the top region into $top_panes equal-height plain shells (all full width
      # of the left column, stacked above the scratch terminal). Always split the same
      # top pane, giving each new pane 100/i % of it as i counts down from $top_panes
      # to 2 — `-l N%` is a percentage of the pane being split, so the shrinking top
      # pane leaves ~equal rows within the top region. top_panes=1 → no splits.
      for (( i = top_panes; i >= 2; i-- )); do
        tmux -L "$sock" split-window -v -t "$top_pid" -l "$((100 / i))%" -c "$PWD"
      done
    fi
    # Start focus ([frame] focus): agent (right) by default, or the left scratch
    # column. Done last so it wins over wherever the splits left the active pane.
    case "$focus" in
      terminal) tmux -L "$sock" select-pane -t "$left_pid" ;;
      *)        tmux -L "$sock" select-pane -t "$agent_pid" ;;
    esac
  fi
  # Wire the pane-died reattach hook on the frame SERVER (global) — here, not in
  # frame.conf. `-f frame.conf` is read only when the server first starts, but the
  # frame socket is shared and long-lived, so a server that predates this hook (or
  # any later frame.conf change) would never pick it up. Re-setting it on every
  # `amux --frame` is idempotent and keeps every frame on the server current. Path
  # from $AGENTMUX_SCRIPTS, shquoted so a space in the install path survives the
  # run-shell; #{pane_id} resolves to the dead pane when the hook fires.
  tmux -L "$sock" set-hook -g pane-died \
    "run-shell \"$(_amux_shquote "$AGENTMUX_SCRIPTS/frame_reattach.sh") #{pane_id}\""
  # Same shared-long-lived-server reasoning: focus-events must be ON so a single
  # cross-pane click both switches the active pane AND wakes the inner (focus-aware)
  # tmux to register that click — without it you click once to focus, again to land.
  # frame.conf sets it for a fresh server; this keeps any pre-existing frame current.
  tmux -L "$sock" set-option -g focus-events on
  # Likewise allow-passthrough: the frame is the OUTERMOST tmux, so a desktop
  # notification (OSC 777) the agent emits arrives here wrapped in a passthrough
  # envelope and must be forwarded to the host terminal. With passthrough off (the
  # tmux default, and what frame.conf historically lacked) the frame silently drops
  # it and notifications never reach warden/Ghostty. frame.conf sets it for a fresh
  # server; this line keeps any pre-existing frame current.
  tmux -L "$sock" set-option -g allow-passthrough on
  # Likewise extended keys: the frame must forward CSI-u (Escape, Ctrl-C, Shift+Enter) down
  # to the agent pane, or Claude's kitty-protocol keys desync and Escape/Ctrl-C intermittently
  # die in a framed agent. tmux drops Claude's enable request, so `always` (not `on`) is what
  # forwards them; extkeys carries them from the host terminal. frame.conf sets it for a fresh
  # server; this keeps any pre-existing frame current (same shared-long-lived-server reason).
  tmux -L "$sock" set-option -s extended-keys always
  tmux -L "$sock" set-option -as terminal-features 'xterm*:extkeys,screen*:extkeys'
  # Reset-split binding + its per-session data, asserted here (not just frame.conf)
  # for the same shared-long-lived-server reason as the hook above: a frame server
  # predating this feature has no @amux_left/@amux_left_pane and no `0` override.
  # Setting both on every launch makes a stale frame pick the reset up on the next
  # relaunch, without a full rebuild. @amux_left = configured percent; @amux_left_pane
  # = the left column's pane (tagged @amux_role=term at creation), so resizing its
  # width snaps the whole left column back to left% of the window. Bound to `0` (reset
  # to default, like Cmd+0): the frame is single-window (frame.conf unbinds `c`), so
  # the default `0` = select-window 0 is inert here — overriding it shadows nothing.
  # The binding computes absolute -x cols in the shell, so it doesn't need
  # resize-pane's `-x N%` support.
  local left_pct term_pane
  left_pct=$(_amux_frame_width)
  term_pane=$(tmux -L "$sock" list-panes -t "$fsess" -f '#{==:#{@amux_role},term}' -F '#{pane_id}' 2>/dev/null | head -1)
  tmux -L "$sock" set -t "$fsess" @amux_left "$left_pct"
  [ -n "$term_pane" ] && tmux -L "$sock" set -t "$fsess" @amux_left_pane "$term_pane"
  tmux -L "$sock" bind-key 0 \
    run-shell 'tmux resize-pane -t "#{@amux_left_pane}" -x "$(( #{window_width} * #{@amux_left} / 100 ))"'
  tmux -L "$sock" attach-session -t "=$fsess"
}

# List active frame wrappers (they live on their own socket, so a plain `tmux ls`
# in the base terminal — the default socket — never shows them).
_amux_frames() {
  tmux -L "$AGENTMUX_FRAME_SOCKET" list-sessions 2>/dev/null || echo "amux: no active frames"
}

# Kill a frame from the base terminal (default: the current dir's). Tears down the
# wrapper (frame socket) AND its scratch terminal (term socket); the agent session
# on the default socket is left running (kill it separately with
# `tmux kill-session -t <session>`).
_amux_frame_kill() {
  local arg base
  # Sanitise the same way the frame was named (. and : → _) so an explicit arg or
  # the no-arg default basename resolves to the name the frame was created under.
  if [ $# -gt 0 ]; then arg=$(_amux_sanitize_session "$1"); else arg=$(_amux_default_session_name); fi
  case "$arg" in *-frame) base="${arg%-frame}" ;; *) base="$arg" ;; esac
  local fsock="$AGENTMUX_FRAME_SOCKET" tsock="$AGENTMUX_TERM_SOCKET"
  local fsess="${base}-frame" tsess="${base}-term"
  if tmux -L "$fsock" has-session -t "=$fsess" 2>/dev/null; then
    tmux -L "$fsock" kill-session -t "=$fsess" 2>/dev/null
    tmux -L "$tsock" kill-session -t "=$tsess" 2>/dev/null   # its scratch terminal
    echo "killed frame '$fsess' + terminal '$tsess' (agent session, if any, still runs)"
  else
    echo "amux: no frame '$fsess' (try: amux --frames)" >&2; return 1
  fi
}

# Kill EVERY frame at once: tears down the whole frame server (all wrappers on the
# frame socket) and the entire scratch-terminal server with it. Agent sessions on
# the default socket survive. Handy to refresh all frames after a frame.conf change,
# since a frame only reads config when (re)created.
_amux_frame_kill_all() {
  local fsock="$AGENTMUX_FRAME_SOCKET" tsock="$AGENTMUX_TERM_SOCKET"
  if tmux -L "$fsock" list-sessions >/dev/null 2>&1; then
    tmux -L "$fsock" kill-server 2>/dev/null
    tmux -L "$tsock" kill-server 2>/dev/null   # the paired scratch terminals
    echo "killed all frames + scratch terminals (agent sessions, if any, still run)"
  else
    echo "amux: no active frames (try: amux --frames)" >&2; return 1
  fi
}

# List agentmux-managed (@autoagent) sessions on the agent socket: name, agent
# mode, window count, attach state. The view that shows exact session names.
_amux_sessions() {
  local rows
  rows=$(_amux_atmux list-sessions \
    -F '#{?@autoagent,#{session_name}	#{@agent-mode}	#{session_windows} win	#{?session_attached,attached,detached},}' \
    2>/dev/null | grep .)
  if [ -n "$rows" ]; then
    # Align the tab-separated columns with awk (already a dependency); column(1)
    # is not POSIX and is used nowhere else, so don't pull it in just for this.
    printf '%s\n' "$rows" | awk -F'\t' '
      { for (i = 1; i <= NF; i++) { cell[NR, i] = $i; if (length($i) > w[i]) w[i] = length($i) }
        if (NF > nc) nc = NF; nr = NR }
      END { for (r = 1; r <= nr; r++) { out = ""
              for (i = 1; i <= nc; i++) { s = cell[r, i]; out = out s
                if (i < nc) { p = w[i] - length(s) + 2; while (p-- > 0) out = out " " } }
              print out } }'
  else
    echo "amux: no agent sessions"
  fi
}

# amux --log — durable roster of agent windows amux has opened, for recovery
# after a tmux server died (kill-server / reboot). Distinct from --sessions,
# which lists only sessions on the *live* server.
_amux_log() {
  "$AGENTMUX_SCRIPTS/session_log.sh" list
}

# Presence query for a single project: exit 0 if its agent session (agent socket)
# OR a lingering frame (<base>-frame on the frame socket) exists, non-zero if
# neither does. Silent — meant to back a status indicator (e.g. warden's cyan
# presence dot) on its exit code alone. The frame leg is what lets the dot stay
# lit after an agent exits while its frame wrapper is still up — the state
# `amux --kill` reaps; no separate -term check, since a frame's scratch terminal
# never outlives the frame (both die together). Default target is the current
# dir's session; an explicit arg is sanitised, and a trailing -frame/-term is
# stripped to the base (so `amux --probe foo-frame` queries project `foo`).
_amux_probe() {
  local arg base
  if [ $# -gt 0 ]; then arg=$(_amux_sanitize_session "$1"); else arg=$(_amux_default_session_name); fi
  case "$arg" in
    *-frame) base="${arg%-frame}" ;;
    *-term)  base="${arg%-term}" ;;
    *)       base="$arg" ;;
  esac
  _amux_session_exists "$base" && return 0
  # -L names the frame socket explicitly, so this ignores any inherited $TMUX
  # (unlike the agent socket, which _amux_atmux must clear $TMUX to reach).
  tmux -L "$AGENTMUX_FRAME_SOCKET" has-session -t "=${base}-frame" 2>/dev/null
}

# Kill ONE project completely: the agent session (agent socket) plus its paired
# <base>-frame and <base>-term. Default target is the current dir's session; an
# explicit arg is sanitised, and a trailing -frame/-term is stripped to the base.
# Kills whichever of the three exist; errors only if none do.
_amux_kill() {
  local arg base
  if [ $# -gt 0 ]; then arg=$(_amux_sanitize_session "$1"); else arg=$(_amux_default_session_name); fi
  case "$arg" in
    *-frame) base="${arg%-frame}" ;;
    *-term)  base="${arg%-term}" ;;
    *)       base="$arg" ;;
  esac
  local fsock="$AGENTMUX_FRAME_SOCKET" tsock="$AGENTMUX_TERM_SOCKET" parts=""
  if _amux_session_exists "$base"; then
    _amux_atmux kill-session -t "=$base" 2>/dev/null; parts="agent '$base'"
  fi
  if tmux -L "$fsock" has-session -t "=${base}-frame" 2>/dev/null; then
    tmux -L "$fsock" kill-session -t "=${base}-frame" 2>/dev/null
    parts="${parts:+$parts + }frame '${base}-frame'"
  fi
  if tmux -L "$tsock" has-session -t "=${base}-term" 2>/dev/null; then
    tmux -L "$tsock" kill-session -t "=${base}-term" 2>/dev/null
    parts="${parts:+$parts + }terminal '${base}-term'"
  fi
  if [ -n "$parts" ]; then
    echo "killed $parts"
  else
    echo "amux: no session '$base' (try: amux --sessions)" >&2; return 1
  fi
}

# Kill EVERY agentmux project at once: every @autoagent session, plus all frames
# and scratch terminals. Destroys running agents, so it confirms first. The agent
# socket is the user's DEFAULT tmux server (it may also host non-agentmux
# sessions), so this kills @autoagent sessions one by one — never kill-server —
# while the frame/term sockets, which are exclusively ours, are torn down whole.
_amux_kill_all() {
  local names count fsock="$AGENTMUX_FRAME_SOCKET" tsock="$AGENTMUX_TERM_SOCKET" have_frames=0
  names=$(_amux_agent_session_names)
  count=$(printf '%s' "$names" | grep -c . 2>/dev/null)
  tmux -L "$fsock" list-sessions >/dev/null 2>&1 && have_frames=1
  if [ "$count" -eq 0 ] && [ "$have_frames" -eq 0 ]; then
    echo "amux: no agent sessions or frames (try: amux --sessions)" >&2; return 1
  fi
  printf 'kill %s agent session(s) + all frames/terminals? (y/N) ' "$count" >&2
  local reply; read -r reply
  case "$reply" in
    [yY]|[yY][eE][sS]) ;;
    *) echo "aborted" >&2; return 1 ;;
  esac
  printf '%s\n' "$names" | while IFS= read -r s; do
    [ -n "$s" ] && _amux_atmux kill-session -t "=$s" 2>/dev/null
  done
  tmux -L "$fsock" kill-server 2>/dev/null
  tmux -L "$tsock" kill-server 2>/dev/null
  echo "killed $count agent session(s) + all frames/terminals"
}

# amux [(-<flag> | <agent_name>)] [session_name]
#
# Creates or attaches a tmux session managed by agentmux.
# Agent selection (in precedence order):
#   -<flag>        flag defined in amux.toml (e.g. -w for flag="w")
#   <agent_name>   exact agent name (e.g. "work")
#   (none)         agent whose `dirs` matches $PWD; else first agent in config
# Remaining arg (if any) is the session name; defaults to current dir basename.
amux() {
  local agent_name="" session_arg="" no_frame=""

  if [ $# -gt 0 ]; then
    case "$1" in
      --version)
        local v; v=$(cat "$HOME/.agentmux/VERSION" 2>/dev/null | tr -d '[:space:]')
        echo "agentmux ${v:-unknown}"
        return 0
        ;;
      --update)
        _amux_update "$HOME/.agentmux"
        return $?
        ;;
      --colours|--colors)
        shift
        _amux_colours "$@"
        return $?
        ;;
      --frame)
        shift
        _amux_frame "$@"
        return $?
        ;;
      --no-frame)
        # Opt out of [frame] default for this run; fall through to a plain launch.
        no_frame=1
        shift
        ;;
      --frames)
        _amux_frames
        return $?
        ;;
      --frame-kill)
        shift
        _amux_frame_kill "$@"
        return $?
        ;;
      --frame-kill-all)
        _amux_frame_kill_all
        return $?
        ;;
      --sessions)
        _amux_sessions
        return $?
        ;;
      --log)
        _amux_log
        return $?
        ;;
      --probe)
        shift
        _amux_probe "$@"
        return $?
        ;;
      --kill)
        shift
        _amux_kill "$@"
        return $?
        ;;
      --kill-all)
        _amux_kill_all
        return $?
        ;;
      --complete)
        # Hidden: emit agent names + -flags for shell completion backends.
        agentmux_list_agent_completions
        return 0
        ;;
      --complete-sessions)
        # Hidden: emit live agentmux session names for --kill/--frame-kill completion.
        _amux_agent_session_names
        return 0
        ;;
      --help)
        cat <<'EOF'
amux [(-<flag> | <agent_name>)] [session_name]
  Creates or attaches a tmux session managed by agentmux.

  -<flag>        agent matching `flag` in amux.toml (e.g. -w for flag="w")
  <agent_name>   agent by name (e.g. "work")
  (none)         agent whose `dirs` matches the current directory;
                 falls back to the first agent in amux.toml
  session_name   defaults to basename of $PWD (chars outside A-Za-z0-9_- → _)

  --sessions     list agentmux agent sessions (name, agent, windows, attach state)
  --log          durable roster of past/open agent sessions, incl. ones lost to a server crash
  --probe        exit 0 if a session [session] (agent or frame) exists (default: current dir); silent
  --kill         kill an agent session [session] + its frame/term (default: current dir)
  --kill-all     kill ALL agent sessions + all frames/terminals (asks first)
  --update       update to the latest agentmux (git pull)
  --colours      preview the colour palette (grid|pick subcommands)
  --frame        open a side terminal (left) beside amux (right), nested tmux
  --no-frame     force a plain launch (opt out of [frame] default = true)
  --frames       list active frames (they live on a separate tmux socket)
  --frame-kill   kill a frame [session] (default: current dir); agent keeps running
  --frame-kill-all     kill ALL frames + scratch terminals at once; agents keep running
  --version      print version
  --help         this help
EOF
        return 0
        ;;
    esac
  fi

  # [frame] default = true makes a bare amux open a frame, as if --frame were
  # passed. Skipped when --no-frame was given, or when already inside tmux and
  # [frame] allow_nested isn't set (--frame can't nest there — fall through to a
  # normal in-tmux launch instead).
  if [ -z "$no_frame" ] && { [ -z "${TMUX:-}" ] || [ -n "$(_amux_frame_allow_nested)" ]; } && [ -n "$(_amux_frame_default)" ]; then
    _amux_frame "$@"
    return $?
  fi

  local _amux_target
  _amux_target=$(_amux_resolve_target "$@") || return 1
  agent_name=$(printf '%s' "$_amux_target" | sed -n 1p)
  session_arg=$(printf '%s' "$_amux_target" | sed -n 2p)

  # Opt-in daily check for a newer agentmux (self-gates on [update] check;
  # notice is instant, the network refresh is backgrounded — never blocks launch).
  [ -x "$AGENTMUX_SCRIPTS/version_check.sh" ] && "$AGENTMUX_SCRIPTS/version_check.sh" || true

  local name="$session_arg"

  # Exact-match check (see _amux_session_exists): without it, `name` would
  # prefix-match a longer existing session and we'd attach to the wrong one
  # instead of creating the session you asked for. set-option below targets the
  # bare name — safe because by this point the exact session exists (just created,
  # or confirmed by the exact check) and tmux matches exact before prefix.
  if ! _amux_session_exists "$name"; then
    _amux_atmux new-session -d -s "$name" -c "$PWD"
    _amux_atmux set-option -t "$name" "@agent-mode" "$agent_name"
    _amux_launch_window0 "$name" "$agent_name"
  else
    _amux_atmux set-option -t "$name" "@agent-mode" "$agent_name"
  fi

  _amux_atmux set-option -t "$name" "@autoagent" "1"
  # Optional per-session prefix ([amux] prefix). Set unconditionally (new and
  # reattached sessions) so a config change applies on the next launch, and as a
  # session option so it never touches other sessions' ~/.tmux.conf prefix. Empty
  # = unset/collided → leave the default prefix untouched.
  local _prefix; _prefix=$(_amux_prefix)
  [ -n "$_prefix" ] && _amux_atmux set-option -t "$name" prefix "$_prefix"

  # Pin this project's bar colour (if [amux.dirs."$PWD"].session_colour set) by
  # pre-freezing @l1idx to the named slot, and publish every pinned slot globally
  # so the hook keeps them out of the auto-assign pool.
  #
  # ORDERING IS LOAD-BEARING: @autoagent (above) and @l1reserved (here) must both
  # be set BEFORE _amux_attach. update_colors.sh only paints @autoagent sessions,
  # so the session-created hook is a no-op while this session is still un-flagged;
  # the first real paint happens on attach, by which point the reservation is
  # published. Move either set after the attach and a colliding newcomer can steal
  # a reserved colour before the reservation exists. Don't reorder.
  local _pin_slot _reserved
  _pin_slot=$(_amux_bar_pin_slot "$PWD")
  [ -n "$_pin_slot" ] && _amux_atmux set-option -t "$name" @l1idx "$_pin_slot"
  _reserved=$(_amux_bar_reserved)
  _amux_atmux set-option -g @l1reserved "$_reserved"

  # One-time recovery nudge: if a previous tmux server died with agent windows
  # still open (crash/reboot), flash it on the status line ~1s after the client
  # attaches. A plain echo here would be wiped when tmux paints on attach; the
  # message goes through a server option so its text needs no shell-escaping.
  local _crash_notice
  _crash_notice=$("$AGENTMUX_SCRIPTS/session_log.sh" notice 2>/dev/null)
  if [ -n "$_crash_notice" ]; then
    _amux_atmux set-option -g "@amux_session_notice" "$_crash_notice"
    _amux_atmux run-shell -d 1 'tmux display-message -d 5000 "#{@amux_session_notice}"' 2>/dev/null || true
  fi

  _amux_attach "$name"
}

# Self-test: AMUX_SELFTEST=1 bash bin/amux
if [ "${AMUX_SELFTEST:-}" = "1" ]; then
  _selftest_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  AGENTMUX_CONFIG="$_selftest_dir/../config/amux.toml.example"
  _amux_json_cache=""
  # Isolate the disk cache so synthetic configs don't collide with real or
  # each other (same-second mtime → same cache key on fast machines).
  _selftest_cache=$(mktemp -d); export XDG_CACHE_HOME="$_selftest_cache"
  pass=0; fail=0
  _assert() {
    local desc="$1" expected="$2" actual="$3"
    if [ "$actual" = "$expected" ]; then
      echo "PASS: $desc"; pass=$((pass+1))
    else
      echo "FAIL: $desc — expected '$expected' got '$actual'"; fail=$((fail+1))
    fi
  }

  # --complete emits agent names and -flags (newline-separated).
  completions=$(amux --complete)
  _assert "complete has work"  "work" "$(printf '%s\n' "$completions" | grep '^work$')"
  _assert "complete has -w"    "-w"   "$(printf '%s\n' "$completions" | grep '^-w$')"
  _assert "complete has ollama" "ollama" "$(printf '%s\n' "$completions" | grep '^ollama$')"

  # --help prints usage and does NOT contain a dangling "Related:" line or -h.
  help=$(amux --help)
  case "$help" in *"amux [(-<flag>"*) _got="usage" ;; *) _got="missing" ;; esac
  _assert "help shows usage" "usage" "$_got"
  case "$help" in *"Related:"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help no dangling Related" "absent" "$_got"
  case "$help" in *"-h, --help"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --help only" "absent" "$_got"

  # --version reads ~/.agentmux/VERSION (or 'unknown'); just assert prefix.
  ver=$(amux --version)
  case "$ver" in "agentmux "*) _got="ok" ;; *) _got="bad" ;; esac
  _assert "version prefix" "ok" "$_got"

  # --help advertises --update.
  case "$help" in *"--update"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --update" "present" "$_got"

  # --help advertises --colours.
  case "$help" in *"--colours"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --colours" "present" "$_got"

  # --help advertises --frame.
  case "$help" in *"--frame"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --frame" "present" "$_got"

  # --help advertises --no-frame.
  case "$help" in *"--no-frame"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help advertises --no-frame" "present" "$_got"

  # --frame refuses to run inside tmux (guard returns 1 before any tmux call)
  # unless [frame] allow_nested is set. The example config sets none, so it's off.
  _fout=$(TMUX="/tmp/fake,1,0" _amux_frame work test 2>&1); _frc=$?
  case "$_fout" in *"must be run from a plain terminal"*) _got=ok ;; *) _got="bad:$_fout" ;; esac
  _assert "frame guard message" "ok" "$_got"
  _assert "frame guard exit"    "1"  "$_frc"
  # [frame] allow_nested = true lifts the guard: _amux_frame proceeds past it (we
  # point it at a bogus config dir so it fails on the missing frame.conf, not the
  # tmux guard — proving the guard no longer fired).
  _anw=$(mktemp /tmp/amux-nest-XXXXXX.toml) || exit 1
  printf '[frame]\nallow_nested = true\n[[agents]]\nname="a"\ncmd="x"\n' > "$_anw"
  _fout=$(TMUX="/tmp/fake,1,0" AGENTMUX_CONFIG="$_anw" _amux_json_cache="" \
          AGENTMUX_TMUX="/tmp/amux-no-such-tmux-dir" _amux_frame a test 2>&1)
  case "$_fout" in
    *"must be run from a plain terminal"*) _got="guard-still-fired" ;;
    *"frame config not found"*)            _got=ok ;;
    *)                                     _got="bad:$_fout" ;;
  esac
  _assert "frame allow_nested lifts guard" "ok" "$_got"
  rm -f "$_anw"

  # _amux_frame_right_cmd: a single plain amux attach (no loop → no resurrection,
  # and parseable by any login shell incl. fish).
  _rc=$(_amux_frame_right_cmd /opt/amux work proj)
  _assert "frame right_cmd shape" "env -u TMUX '/opt/amux' --no-frame 'work' 'proj'" "$_rc"

  # _amux_frame_left_cmd: plain attach to the dedicated term socket (trailing
  # `-c <PWD>` varies, so assert the stable prefix).
  _lc=$(_amux_frame_left_cmd agentmux-term /c/term.conf proj-term)
  case "$_lc" in "env -u TMUX tmux -L 'agentmux-term' -f '/c/term.conf' new-session -A -s 'proj-term' -c '"*) _got=ok ;; *) _got="bad:$_lc" ;; esac
  _assert "frame left_cmd shape" "ok" "$_got"

  # --help advertises the frame management commands.
  case "$help" in *"--frames"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --frames" "present" "$_got"
  case "$help" in *"--frame-kill"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --frame-kill" "present" "$_got"

  # --frames / --frame-kill against an isolated empty socket (no real frames touched).
  AGENTMUX_FRAME_SOCKET="amux-selftest-$$"
  _assert "frames empty" "amux: no active frames" "$(amux --frames 2>/dev/null)"
  _fk=$(amux --frame-kill __nope__ 2>&1); _fkrc=$?
  case "$_fk" in *"no frame '__nope__-frame'"*) _got=ok ;; *) _got="bad:$_fk" ;; esac
  _assert "frame-kill missing msg"  "ok" "$_got"
  _assert "frame-kill missing exit" "1"  "$_fkrc"
  # --frame-kill explicit arg sanitises . and : (matches how the frame is named).
  _fk=$(amux --frame-kill 'a.b:c' 2>&1)
  case "$_fk" in *"no frame 'a_b_c-frame'"*) _got=ok ;; *) _got="bad:$_fk" ;; esac
  _assert "frame-kill sanitises arg" "ok" "$_got"
  # --frame-kill no-arg default also sanitises the PWD basename's colon (the bug:
  # the default path used to skip : so it computed a name the frame never had).
  _ckdir="$_selftest_cache/has:colon"; mkdir -p "$_ckdir"
  _fk=$(cd "$_ckdir" && amux --frame-kill 2>&1)
  case "$_fk" in *"no frame 'has_colon-frame'"*) _got=ok ;; *) _got="bad:$_fk" ;; esac
  _assert "frame-kill default sanitises colon" "ok" "$_got"

  # --help advertises the agent-session lifecycle commands + the renamed kill-all.
  case "$help" in *"--sessions"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --sessions" "present" "$_got"
  case "$help" in *"--log"*) _got="present" ;; *) _got="absent" ;; esac
  _assert "help shows --log" "present" "$_got"
  case "$help" in *"--kill "*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --kill" "present" "$_got"
  case "$help" in *"--kill-all"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --kill-all" "present" "$_got"
  case "$help" in *"--frame-kill-all"*) _got=present ;; *) _got=absent ;; esac
  _assert "help advertises --frame-kill-all" "present" "$_got"
  # The old name is gone (renamed, no alias).
  case "$help" in *"--frame-server-kill"*) _got=present ;; *) _got=absent ;; esac
  _assert "help drops --frame-server-kill" "absent" "$_got"

  # Agent-session commands against ISOLATED empty sockets (no real sessions touched).
  AGENTMUX_AGENT_SOCKET="amux-selftest-agent-$$"
  AGENTMUX_TERM_SOCKET="amux-selftest-term-$$"
  _assert "sessions empty"          "amux: no agent sessions" "$(amux --sessions 2>/dev/null)"
  _assert "complete-sessions empty" ""                        "$(amux --complete-sessions 2>/dev/null)"
  _k=$(amux --kill __nope__ 2>&1); _krc=$?
  case "$_k" in *"no session '__nope__'"*) _got=ok ;; *) _got="bad:$_k" ;; esac
  _assert "kill missing msg"  "ok" "$_got"
  _assert "kill missing exit" "1"  "$_krc"
  # --kill sanitises . and : the same way sessions are named.
  _k=$(amux --kill 'a.b:c' 2>&1)
  case "$_k" in *"no session 'a_b_c'"*) _got=ok ;; *) _got="bad:$_k" ;; esac
  _assert "kill sanitises arg" "ok" "$_got"
  # --kill strips a -frame/-term suffix to the base session name.
  _k=$(amux --kill 'proj-frame' 2>&1)
  case "$_k" in *"no session 'proj'"*) _got=ok ;; *) _got="bad:$_k" ;; esac
  _assert "kill strips -frame suffix" "ok" "$_got"
  # --kill-all with nothing present aborts cleanly (no prompt, exit 1); </dev/null
  # guards against the confirm read ever blocking.
  _ka=$(amux --kill-all </dev/null 2>&1); _karc=$?
  case "$_ka" in *"no agent sessions"*) _got=ok ;; *) _got="bad:$_ka" ;; esac
  _assert "kill-all empty msg"  "ok" "$_got"
  _assert "kill-all empty exit" "1"  "$_karc"

  # --colours render lists curated names; the line helper emits a paste field.
  cols=$(amux --colours 2>/dev/null)
  case "$cols" in *teal*) _got=ok ;; *) _got=bad ;; esac
  _assert "colours render has teal" "ok" "$_got"
  line=$(_amux_colour_line work teal)
  case "$line" in *'colour = "teal"'*) _got=ok ;; *) _got=bad ;; esac
  _assert "colour line paste field" "ok" "$_got"

  # --colours preview also lists the session bar palette (so pins are discoverable).
  # 'amber' is bar-only (not a tab name), so this genuinely needs the bar render.
  case "$cols" in *"Session bar colours"*amber*) _got=present ;; *) _got=absent ;; esac
  _assert "colours preview lists bar names" "present" "$_got"

  # _amux_shquote wraps and escapes embedded single quotes.
  _assert "shquote plain"  "'work'"      "$(_amux_shquote work)"
  _assert "shquote squote" "'a'\\''b'"   "$(_amux_shquote "a'b")"

  # _amux_frame_width: example config sets [frame] left = 30.
  _assert "frame_width default" "30" "$(_amux_frame_width)"

  # _amux_frame_width clamps from synthetic configs. Clear the (isolated) disk
  # cache between rewrites — same-second mtime would otherwise alias the cache.
  _fw=$(mktemp /tmp/amux-frame-XXXXXX.toml)
  printf '[frame]\nleft = 5\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_width clamp low"  "10" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_width)"
  printf '[frame]\nleft = 200\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_width clamp high" "90" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_width)"
  printf '[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_width no-frame"   "30" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_width)"

  # _amux_frame_top_height: opt-in. Example config leaves it unset → empty (no split).
  _assert "frame_top unset"        ""   "$(_amux_frame_top_height)"
  printf '[frame]\nleft_vertical_split = 40\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top value"        "40" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_height)"
  printf '[frame]\nleft_vertical_split = 3\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top clamp low"    "10" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_height)"
  printf '[frame]\nleft_vertical_split = 99\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top clamp high"   "90" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_height)"

  # _amux_frame_top_panes: default 1 (example config sets none), clamped to 1..6.
  _assert "frame_top_panes default" "1" "$(_amux_frame_top_panes)"
  printf '[frame]\nleft_top_panes = 3\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top_panes value"    "3" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_panes)"
  printf '[frame]\nleft_top_panes = 0\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top_panes clamp low"  "1" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_panes)"
  printf '[frame]\nleft_top_panes = 12\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_top_panes clamp high" "6" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_top_panes)"

  # _amux_frame_focus / _amux_frame_status_position / _amux_frame_default: the
  # example config sets none of these, so each falls back to its default.
  _assert "frame_focus default"  "agent"  "$(_amux_frame_focus)"
  _assert "frame_status default" "bottom" "$(_amux_frame_status_position)"
  _assert "frame_default unset"  ""       "$(_amux_frame_default)"
  printf '[frame]\nfocus = "terminal"\nstatus_position = "top"\ndefault = true\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_focus terminal" "terminal" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_focus)"
  _assert "frame_status top"     "top"      "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_status_position)"
  _assert "frame_default on"     "1"        "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_default)"
  # Unrecognised values fall back to defaults (agent / bottom).
  printf '[frame]\nfocus = "sideways"\nstatus_position = "middle"\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_focus bad val"  "agent"  "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_focus)"
  _assert "frame_status bad val" "bottom" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_status_position)"

  # _amux_frame_prefix: effective frame prefix = [frame] prefix or the C-f default.
  printf '[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_prefix default" "C-f" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_prefix)"
  printf '[frame]\nprefix = "C-x"\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "frame_prefix set"     "C-x" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_frame_prefix)"

  # _amux_prefix: example config sets no [amux] → empty (default prefix untouched).
  _assert "amux_prefix unset" "" "$(_amux_prefix)"
  # [amux] prefix with no collision → emitted verbatim (frame default is C-f).
  printf '[amux]\nprefix = "C-a"\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "amux_prefix set" "C-a" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_prefix 2>/dev/null)"
  # Collision with an explicit [frame] prefix → empty stdout + a warning on stderr.
  printf '[amux]\nprefix = "C-x"\n[frame]\nprefix = "C-x"\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "amux_prefix collide stdout" "" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_prefix 2>/dev/null)"
  _pw=$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_prefix 2>&1 >/dev/null)
  case "$_pw" in *"collides with the [frame] prefix"*) _got=warns ;; *) _got="silent:$_pw" ;; esac
  _assert "amux_prefix collide warns" "warns" "$_got"
  # Collision against the C-f default (no [frame] block) is caught too.
  printf '[amux]\nprefix = "C-f"\n[[agents]]\nname="a"\ncmd="x"\n' > "$_fw"
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _assert "amux_prefix collide default" "" "$(AGENTMUX_CONFIG="$_fw" _amux_json_cache="" _amux_prefix 2>/dev/null)"

  rm -f "$_fw"

  # --- pinned bar colours ---
  _fp=$(mktemp)
  cat > "$_fp" <<'EOF'
[amux.dirs."/tmp/amux-pin-blue"]
session_colour = "blue"
[amux.dirs."/tmp/amux-pin-magenta"]
session_colour = "magenta"
[[agents]]
name = "x"
cmd = "true"
EOF
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null  # disk cache is mtime-keyed; clear it
  # A pinned dir resolves to its palette slot; an unpinned dir resolves to empty.
  _assert "pin slot blue=0" "0" \
    "$(AGENTMUX_CONFIG="$_fp" _amux_json_cache="" _amux_bar_pin_slot /tmp/amux-pin-blue)"
  _assert "pin slot magenta=8" "8" \
    "$(AGENTMUX_CONFIG="$_fp" _amux_json_cache="" _amux_bar_pin_slot /tmp/amux-pin-magenta)"
  _assert "pin slot unpinned empty" "" \
    "$(AGENTMUX_CONFIG="$_fp" _amux_json_cache="" _amux_bar_pin_slot /tmp/amux-unpinned)"
  # The reserved set lists every pinned slot, unique, space-separated.
  _assert "reserved set" "0 8" \
    "$(AGENTMUX_CONFIG="$_fp" _amux_json_cache="" _amux_bar_reserved 2>/dev/null)"
  rm -f "$_fp"

  # Unknown colour name warns and is skipped (not added to the reserved set).
  _fpu=$(mktemp)
  cat > "$_fpu" <<'EOF'
[amux.dirs."/tmp/amux-pin-bad"]
session_colour = "chartreuse"
[[agents]]
name = "x"
cmd = "true"
EOF
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _uw=$(AGENTMUX_CONFIG="$_fpu" _amux_json_cache="" _amux_bar_reserved 2>&1 >/dev/null)
  case "$_uw" in *"unknown bar colour 'chartreuse'"*) _got=warns ;; *) _got="silent:$_uw" ;; esac
  _assert "reserved warns on unknown colour" "warns" "$_got"
  _assert "reserved skips unknown colour" "" \
    "$(AGENTMUX_CONFIG="$_fpu" _amux_json_cache="" _amux_bar_reserved 2>/dev/null)"
  rm -f "$_fpu"

  # Two dirs pinning the same colour warn, and the slot appears once (olive = 4).
  _fpd=$(mktemp)
  cat > "$_fpd" <<'EOF'
[amux.dirs."/tmp/amux-pin-a"]
session_colour = "olive"
[amux.dirs."/tmp/amux-pin-b"]
session_colour = "olive"
[[agents]]
name = "x"
cmd = "true"
EOF
  rm -rf "$_selftest_cache/agentmux" 2>/dev/null
  _dw=$(AGENTMUX_CONFIG="$_fpd" _amux_json_cache="" _amux_bar_reserved 2>&1 >/dev/null)
  case "$_dw" in *"pinned by more than one dir"*) _got=warns ;; *) _got="silent:$_dw" ;; esac
  _assert "reserved warns on duplicate pin" "warns" "$_got"
  _assert "reserved dedups duplicate pin" "4" \
    "$(AGENTMUX_CONFIG="$_fpd" _amux_json_cache="" _amux_bar_reserved 2>/dev/null)"
  rm -f "$_fpd"

  AGENTMUX_CONFIG="$_selftest_dir/../config/amux.toml.example"; _amux_json_cache=""

  # _amux_resolve_target: flag/name/session precedence (explicit session = deterministic).
  _rt=$(_amux_resolve_target -w proj)
  _assert "resolve -w agent"   "work" "$(printf '%s' "$_rt" | sed -n 1p)"
  _assert "resolve -w session" "proj" "$(printf '%s' "$_rt" | sed -n 2p)"
  _rt=$(_amux_resolve_target work proj)
  _assert "resolve name agent" "work" "$(printf '%s' "$_rt" | sed -n 1p)"
  _rt=$(_amux_resolve_target -w 'a.b:c')
  _assert "resolve sanitises session" "a_b_c" "$(printf '%s' "$_rt" | sed -n 2p)"
  _err=$(_amux_resolve_target -Z 2>&1 >/dev/null); _rc=$?
  case "$_err" in *"unknown flag -Z"*) _got=ok ;; *) _got="bad:$_err" ;; esac
  _assert "resolve unknown flag msg"  "ok" "$_got"
  _assert "resolve unknown flag exit" "1"  "$_rc"

  # _amux_update on a non-clone dir explains the dev case and fails non-zero.
  _td=$(mktemp -d)
  _out=$(_amux_update "$_td" 2>&1); _rc=$?
  case "$_out" in *"is not a git clone"*) _got="ok" ;; *) _got="bad:$_out" ;; esac
  _assert "update non-clone message" "ok" "$_got"
  _assert "update non-clone exit"    "1"  "$_rc"
  rmdir "$_td"

  # Exact-match session resolution (the reductable-www bug): tmux resolves a bare
  # `-t name` by prefix/fnmatch, so without the `=` guard `_amux_session_exists
  # proj` is TRUE when only `proj-www` exists and amux attaches to the wrong
  # session. Drive _amux_session_exists on an isolated socket. Needs a real tmux;
  # skip cleanly if absent.
  if command -v tmux >/dev/null 2>&1; then
    AGENTMUX_AGENT_SOCKET="amux-selftest-$$"
    _amux_atmux kill-server 2>/dev/null
    _amux_atmux new-session -d -s proj-www -c /tmp 2>/dev/null
    if _amux_session_exists proj;     then _got=present; else _got=absent; fi
    _assert "exact-match: 'proj' absent when only 'proj-www' exists" "absent" "$_got"
    if _amux_session_exists proj-www; then _got=present; else _got=absent; fi
    _assert "exact-match: 'proj-www' present exactly" "present" "$_got"
    _amux_atmux kill-server 2>/dev/null
    AGENTMUX_AGENT_SOCKET=""
  else
    echo "SKIP: exact-match session test (tmux not found)"
  fi

  # $TMUX isolation (the --kill-only-killed-the-frame bug): a bare `tmux` inherits
  # the surrounding server's socket from $TMUX, so when amux runs inside the frame
  # an agent-socket op would hit the frame server. The production path
  # (AGENTMUX_AGENT_SOCKET empty) must clear $TMUX and reach the DEFAULT socket. We
  # put a uniquely-named probe session on an isolated "frame" server, point $TMUX at
  # it, then assert _amux_session_exists (production path) does NOT find it — i.e. it
  # ignored $TMUX. The only op against the real default socket is this read-only
  # has-session for a name that cannot exist there.
  if command -v tmux >/dev/null 2>&1; then
    _fsock="amux-selftest-frame-$$"; _probe="amux-nested-probe-$$"
    tmux -L "$_fsock" new-session -d -s "$_probe" -c /tmp 2>/dev/null
    _spath=$(tmux -L "$_fsock" display-message -p '#{socket_path}' 2>/dev/null)
    AGENTMUX_AGENT_SOCKET=""
    if TMUX="$_spath,1,0" _amux_session_exists "$_probe"; then _got=leaked; else _got=isolated; fi
    _assert "agent ops ignore inherited \$TMUX (reach default socket)" "isolated" "$_got"
    tmux -L "$_fsock" kill-server 2>/dev/null
  else
    echo "SKIP: \$TMUX isolation test (tmux not found)"
  fi

  # --probe presence: exit 0 when the agent OR the frame session exists for the
  # resolved base, non-zero when neither does. This is the query warden's cyan
  # presence dot calls; it must light for a lingering frame (agent exited, frame
  # wrapper still up), not just a live agent. Isolate both sockets onto throwaway
  # servers so the user's real tmux is never touched.
  if command -v tmux >/dev/null 2>&1; then
    AGENTMUX_AGENT_SOCKET="amux-selftest-$$"
    _psock="amux-selftest-pframe-$$"; _psave="$AGENTMUX_FRAME_SOCKET"; AGENTMUX_FRAME_SOCKET="$_psock"
    _amux_atmux kill-server 2>/dev/null; tmux -L "$_psock" kill-server 2>/dev/null

    if _amux_probe probe-x; then _got=present; else _got=absent; fi
    _assert "probe: absent when no agent or frame session" "absent" "$_got"

    _amux_atmux new-session -d -s probe-x -c /tmp 2>/dev/null
    if _amux_probe probe-x; then _got=present; else _got=absent; fi
    _assert "probe: present via agent session" "present" "$_got"
    _amux_atmux kill-session -t "=probe-x" 2>/dev/null

    tmux -L "$_psock" new-session -d -s probe-x-frame -c /tmp 2>/dev/null
    if _amux_probe probe-x; then _got=present; else _got=absent; fi
    _assert "probe: present via lingering frame (agent gone)" "present" "$_got"
    # an explicit -frame/-term arg resolves to the same base
    if _amux_probe probe-x-frame; then _got=present; else _got=absent; fi
    _assert "probe: -frame arg resolves to base" "present" "$_got"

    _amux_atmux kill-server 2>/dev/null; tmux -L "$_psock" kill-server 2>/dev/null
    AGENTMUX_AGENT_SOCKET=""; AGENTMUX_FRAME_SOCKET="$_psave"
  else
    echo "SKIP: --probe test (tmux not found)"
  fi

  rm -rf "$_selftest_cache"
  echo "---"; echo "Passed: $pass  Failed: $fail"
  [ "$fail" -eq 0 ]
  exit $?
fi

amux "$@"
